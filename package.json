{
  "name": "Lumo AI",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "shared",
    "agent-server",
    "cli"
  ],
  "scripts": {
    "predev": "npm run build:shared && tsx scripts/fix-nodemodules-selflink.ts",
    "dev": "next dev",
    "build:shared": "tsc -b shared",
    "prebuild": "npm run build:shared && tsx scripts/fix-nodemodules-selflink.ts",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint && npm run lint:tokens",
    "lint:fix": "next lint --fix",
    "lint:tokens": "tsx scripts/lint-tokens.ts",
    "lint:tokens:audit": "tsx scripts/lint-tokens.ts --full",
    "lint:tokens:update": "tsx scripts/lint-tokens.ts --update",
    "i18n:sync": "tsx scripts/i18n-sync-locales.ts",
    "i18n:check": "tsx scripts/i18n-sync-locales.ts --check",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next out dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:seed": "tsx prisma/seed.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "preanalyze": "tsx scripts/fix-nodemodules-selflink.ts",
    "analyze": "next build --experimental-analyze",
    "prepare": "husky",
    "mcp": "tsx mcp/server.ts"
  },
