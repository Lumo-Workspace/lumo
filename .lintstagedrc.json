{
  "*.{js,jsx,ts,tsx}": [
    "eslint --fix",
    "prettier --write",
    "bash -c 'npm run lint:tokens'"
  ],
  "*.css": ["prettier --write", "bash -c 'npm run lint:tokens'"],
  "*.{json,md,yml,yaml}": ["prettier --write"],
  "prisma/migrations/**/migration.sql": ["bash -c 'npm run migrations:check'"]
}
