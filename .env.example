# =============================================================
# Lumo — environment variables
#
#   Local dev:       cp .env.example .env.local
#   docker compose:  cp .env.example .env   (docs/self-hosting/README.md)
#
# Never commit either copy. The file has two parts:
#   1. REQUIRED — Lumo does not start (or sign-in breaks) without these.
#   2. OPTIONAL — grouped by feature. Everything there is commented out;
#      a feature stays off, and degrades as described, until its
#      variables are set. Variables whose default is fine are not listed.
#
# Generate every secret below with:  openssl rand -hex 32
# =============================================================


# #############################################################
# 1. REQUIRED
# #############################################################

# -------------------------------------------------------------
# Database — Postgres 16 with the pgvector extension.
# docker compose points these at its own postgres service; whatever is
# written here is ignored there.
# Neon / hosted Postgres: DATABASE_URL is the pooled URL used at runtime,
# DATABASE_URL_UNPOOLED the direct one Prisma Migrate needs (defaults to
# DATABASE_URL). A database without TLS needs `?sslmode=disable`.
# -------------------------------------------------------------
DATABASE_URL="postgresql://user:password@db-host-pooler.example.com/lumo?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@db-host.example.com/lumo?sslmode=require"

# -------------------------------------------------------------
# Authentication — pick ONE provider (LUM-1027). AUTH_PROVIDER is read at
# build time too (static pages): rebuild after changing it.
#
# a) Better Auth — the self-hosted default; no Clerk account needed.
#    Email + password sign-in on /signin, accounts and sessions in your own
#    Postgres. docker compose always runs this mode (it sets AUTH_PROVIDER
#    and refuses to start without BETTER_AUTH_SECRET). OAuth buttons and
#    sign-up control are under "Sign-in options" in part 2; invites need
#    Email (part 2), because only a verified address can accept one.
#    MCP clients connect to <BETTER_AUTH_URL>/api/mcp with OAuth served by
#    this instance (LUM-1044); that needs BETTER_AUTH_URL (or
#    NEXT_PUBLIC_APP_URL) set to the public URL — without it /api/mcp
#    answers 501. The CLI uses API keys.
#    BETTER_AUTH_SECRET: >= 32 chars, signs session cookies and encrypts the
#    MCP token signing keys — rotating it invalidates both
#    (openssl rand -hex 32). BETTER_AUTH_URL defaults to NEXT_PUBLIC_APP_URL.
# -------------------------------------------------------------
AUTH_PROVIDER=better-auth
BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=

# b) Clerk — the hosted SaaS provider. Set AUTH_PROVIDER=clerk (the Docker
# image defaults to better-auth) and uncomment below.
# https://dashboard.clerk.com → your application →
# API Keys; the free plan is enough. The publishable key is baked into the
# browser bundle at build time. Not supported by docker-compose.yml; build
# the image yourself with --build-arg AUTH_PROVIDER=clerk (see Dockerfile).
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
# CLERK_SECRET_KEY="sk_test_..."
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/signin
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/workspace
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# -------------------------------------------------------------
# Public URL of this deployment (invite links, emails, OAuth callbacks).
# Build-time for the browser bundle as well: rebuild after changing it.
# -------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -------------------------------------------------------------
# Scheduled jobs. Every /api/cron/* route answers 401 without it, and the
# scheduler (Vercel crons or deploy/self-host/crontab) sends the same value.
# Also signs CLI read receipts unless LUMO_RECEIPT_SECRET is set.
# docs/self-hosting/cron.md
# -------------------------------------------------------------
CRON_SECRET=

# -------------------------------------------------------------
# docker compose only (docker-compose.yml reads these from .env).
# Use hex secrets (openssl rand -hex 32): WORKFLOW_SECRET is embedded in a
# URL. Not needed for local dev or on Vercel.
# -------------------------------------------------------------
# WORKFLOW_SECRET=          # authenticates the in-process workflow worker
# POSTGRES_PASSWORD=        # the bundled Postgres
# MINIO_ROOT_PASSWORD=      # the bundled MinIO (file storage)
# SOKETI_APP_SECRET=        # the bundled Soketi (realtime)
# Optional compose settings: LUMO_PORT (3000), SOKETI_PUBLIC_HOST
# (localhost — the host browsers reach Soketi on), SOKETI_PUBLIC_PORT (6001),
# SOKETI_PUBLIC_TLS (false), SOKETI_APP_KEY (lumo), S3_BUCKET (lumo),
# LUMO_CRON_DISABLED, LUMO_IMAGE / LUMO_CRON_IMAGE (image tags to build or
# pull, default lumo-app:local / lumo-cron:local).


# #############################################################
# 2. OPTIONAL — by feature
# #############################################################

# -------------------------------------------------------------
# AI features (task breakdown, summaries, AI review, memory search) —
# LUM-1019. Pick ONE route. With none set, AI features report "AI is not
# configured" and the rest of Lumo keeps working.
#
# a) Vercel AI Gateway (the hosted SaaS default; on Vercel the OIDC token
#    is used automatically). Every request is forced to zero data
#    retention (lib/ai/zdr-fetch.ts). Crossing triage (an evaluation
#    model) only exists here.
# -------------------------------------------------------------
# AI_GATEWAY_API_KEY=

# b) Direct provider keys — used only when the gateway is not configured
#    (or with AI_PROVIDER=direct). Lumo's model ids are gateway-style
#    (lib/ai/models.ts) and are mapped:
#    `anthropic/claude-sonnet-4.6` → Anthropic `claude-sonnet-4-6`;
#    any other id → the OpenAI-compatible endpoint, as
#    OPENAI_COMPATIBLE_MODEL if set, else without the provider prefix
#    (`openai/gpt-5.5` → `gpt-5.5`).
#    ZERO DATA RETENTION IS YOUR RESPONSIBILITY on this route: check the
#    data-retention terms of the provider / endpoint you point Lumo at.
#    Memory search needs an OpenAI-compatible embedding model with
#    1024-dimension output; without one it falls back to lexical matching.
# AI_PROVIDER=direct            # gateway | direct | none (default: automatic)
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=           # default https://api.anthropic.com/v1
# ANTHROPIC_MODEL=              # Claude model for non-Claude ids when no OpenAI-compatible endpoint is set
# OPENAI_COMPATIBLE_BASE_URL=   # e.g. https://api.openai.com/v1, http://localhost:11434/v1 (Ollama), a vLLM server
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=      # one model for every non-Claude id, e.g. llama3.1
# OPENAI_COMPATIBLE_EMBEDDING_MODEL=
# OPENAI_COMPATIBLE_STRUCTURED_OUTPUTS=false  # only if the endpoint rejects response_format json_schema

# -------------------------------------------------------------
# File storage (logos, test evidence, editor images, workspace exports,
# SARIF uploads) — LUM-1021. docker compose configures MinIO for you.
# Backend: BLOB_STORAGE (vercel|s3|disk) if set; otherwise a Vercel Blob
# token → vercel; else S3_BUCKET → s3; else LOCAL_BLOB_DIR → disk. Set
# BLOB_STORAGE when more than one is configured (the server warns).
# Switching an existing deployment between backends does NOT move files:
# stored Vercel Blob URLs are unreadable through S3 / disk until migrated —
# see docs/privacy/uploaded-files.md. Direct SARIF uploads
# (POST /api/integrations/security/sarif/upload) need Vercel Blob and
# answer 501 on S3 / disk.
# -------------------------------------------------------------
# BLOB_STORAGE=s3

# Vercel Blob: a public store (logos) plus a second store created with
# Access = Private, linked with the env prefix BLOB_PRIVATE. On Vercel the
# tokens are injected when the stores are linked to the project.
# BLOB_READ_WRITE_TOKEN=
# BLOB_PRIVATE_READ_WRITE_TOKEN=

# S3-compatible (AWS S3, MinIO, R2, …). Keep the bucket PRIVATE (no public
# policy); objects live under public/ and private/ key prefixes. Uploads
# never overwrite (HeadObject before each put), so credentials need
# s3:ListBucket for a missing key to be 404.
# S3_BUCKET=lumo
# S3_REGION=us-east-1
# S3_ENDPOINT=http://minio:9000        # omit for AWS S3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=                 # omit both to use the AWS credential chain
# S3_FORCE_PATH_STYLE=true              # default: true when S3_ENDPOINT is set

# Local disk (single node). Must NOT be inside the app's public/ folder.
# LOCAL_BLOB_DIR=/var/lib/lumo/blobs

# -------------------------------------------------------------
# Durable workflows (workspace exports, PR scans, SARIF ingest) on a
# self-hosted deployment — LUM-1030/1031. docker compose configures this.
# Leave unset on Vercel (the Vercel World is picked automatically).
# WORKFLOW_POSTGRES_URL must be a DIRECT connection, not a pooler:
# LISTEN/NOTIFY does not survive a transaction-mode pooler. The World's
# tables live in their own schemas, created by `npm run workflow:bootstrap`.
# Deploy order: prisma migrate deploy → npm run workflow:bootstrap → next start.
# The worker delivers to WORKFLOW_LOCAL_BASE_URL carrying WORKFLOW_SECRET as
# URL userinfo (url-encode it there); the port must equal PORT.
# See docs/self-hosting/workflow.md.
# -------------------------------------------------------------
# WORKFLOW_TARGET_WORLD=@workflow/world-postgres
# WORKFLOW_POSTGRES_URL=postgres://user:password@db-host:5432/lumo
# WORKFLOW_SECRET=
# WORKFLOW_LOCAL_BASE_URL=http://workflow:<url-encoded secret>@localhost:3000
# PORT=3000                     # the port `next start` listens on
# WORKFLOW_POSTGRES_WORKER_CONCURRENCY=10   # set it: the 5.x default is 50, above the pool
# WORKFLOW_POSTGRES_MAX_POOL_SIZE=10

# -------------------------------------------------------------
# Realtime updates — LUM-1018. Without it the UI refetches on window focus
# and every minute instead. docker compose configures Soketi.
# Pusher Channels: https://pusher.com → your app → App Keys.
# Any Pusher-protocol server (Soketi): set a host, which overrides the
# cluster. NEXT_PUBLIC_* are baked in at build time.
# -------------------------------------------------------------
# PUSHER_APP_ID=
# PUSHER_KEY=
# PUSHER_SECRET=
# PUSHER_CLUSTER=us2
# NEXT_PUBLIC_PUSHER_KEY=
# NEXT_PUBLIC_PUSHER_CLUSTER=us2
# PUSHER_HOST=soketi                     # host the server reaches Soketi on
# PUSHER_PORT=6001                       # default 443/80 by TLS
# PUSHER_USE_TLS=false                   # default true
# NEXT_PUBLIC_PUSHER_HOST=rt.example.com # host the browser reaches Soketi on
# NEXT_PUBLIC_PUSHER_PORT=6001
# NEXT_PUBLIC_PUSHER_USE_TLS=false

# -------------------------------------------------------------
# Rate limiting (MCP tool calls, SARIF ingest, waitlist signup) — LUM-1020.
# First match wins: Vercel KV / Upstash (KV_REST_API_*), then standard
# Redis (REDIS_URL — docker compose sets it), then an in-memory window.
# In-memory is SINGLE-INSTANCE ONLY: with N instances the effective limit
# is N x the configured one, and every restart resets it.
# -------------------------------------------------------------
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# REDIS_URL=redis://localhost:6379      # rediss://user:pass@host:6380 for TLS

# -------------------------------------------------------------
# Sign-in options — Better Auth only (AUTH_PROVIDER=better-auth). An OAuth
# button appears when BOTH its id and secret are set. Callback URL:
# <BETTER_AUTH_URL>/api/auth/callback/github (…/google). Email
# verification links go out through the Email settings below; only a
# VERIFIED address can accept a workspace invite.
# -------------------------------------------------------------
# AUTH_GITHUB_CLIENT_ID=
# AUTH_GITHUB_CLIENT_SECRET=
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_DISABLE_SIGNUP=true   # only existing accounts may sign in

# -------------------------------------------------------------
# Email (invites, owner notices, sign-up verification). All email goes over SMTP. SMTP_URL /
# SMTP_HOST win if set; otherwise RESEND_API_KEY alone uses Resend's SMTP
# relay (smtp.resend.com:465, user "resend", the key as password). With
# neither, emails are logged and skipped.
# Resend: https://resend.com/api-keys — a "Sending" key for your domain.
# -------------------------------------------------------------
# RESEND_API_KEY=
# SMTP_URL=smtps://user:password@smtp.example.com:465
# (docker compose dev: SMTP_URL=smtp://mailpit:1025 with `--profile mail`)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587              # 465 implies TLS-on-connect
# SMTP_SECURE=true           # forces TLS-on-connect
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="Lumo <noreply@example.com>"  # a sender your SMTP may send as

# -------------------------------------------------------------
# Integrations — LUM-1025. GitHub, Slack, Sentry, Figma and Google Drive are
# each hidden on the integrations page until every variable they need (plus
# ENCRYPTION_KEY) is set; their routes answer 404 `integration_not_configured`.
# -------------------------------------------------------------
# ENCRYPTION_KEY=            # 32-byte hex (openssl rand -hex 32); encrypts stored OAuth tokens

# GitHub account link (OAuth App): https://github.com/settings/developers
# Callback URL: https://your-domain.com/api/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# GitHub App (repositories, PR sync, PR security scans) — see README.
# Callback URL: https://your-domain.com/api/github/app/callback
# GITHUB_APP_SLUG=
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_WEBHOOK_SECRET=

# Slack: https://api.slack.com/apps → Create New App.
# Callback URL: https://your-domain.com/api/slack/callback
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=

# Figma OAuth app
# FIGMA_OAUTH_CLIENT_ID=
# FIGMA_OAUTH_CLIENT_SECRET=
# FIGMA_OAUTH_REDIRECT_URI=https://your-domain.com/api/figma/callback

# Google Drive import (LUM-127). The redirect URI must match the OAuth
# client's Authorized redirect URI exactly (…/api/google-drive/callback).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_DRIVE_OAUTH_REDIRECT_URI=

# -------------------------------------------------------------
# PR security scan — LUM-735/1025. The managed scan, default-branch
# baseline, L3 hunt and review verifier run in a Vercel Sandbox: automatic
# on Vercel, VERCEL_OIDC_TOKEN (`vercel env pull`, 12 h) elsewhere. Without
# it they are off and the settings page marks them unavailable; the panel
# still shows SARIF pushed by your own CI.
# -------------------------------------------------------------
# VERCEL_OIDC_TOKEN=
# LUMO_MANAGED_SCAN=off           # disable the managed scan
# LUMO_MANAGED_SCAN_HOURLY_CAP=20 # managed scans per workspace per rolling hour
# LUMO_SECURITY_HUNT=off          # disable the L3 vulnerability hunt (LUM-739)
# LUMO_SECURITY_SUGGEST=off       # disable false-positive suggestions (LUM-740)
# LUMO_OIDC_AUDIENCE=lumo         # audience accepted from GitHub Actions OIDC on the SARIF push API

# -------------------------------------------------------------
# Link previews (OG metadata) — LUM-1025. Sites that block a plain fetch are
# retried in headless Chromium when one is available: on Vercel, with
# CHROME_PATH, or in local dev on macOS/Windows. Elsewhere (the docker
# image) previews use the plain fetch only. LUMO_OG_CHROMIUM=on|off forces it.
# -------------------------------------------------------------
# CHROME_PATH=
# LUMO_OG_CHROMIUM=off
