# =============================================================
# Lumo — Environment Variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.
# =============================================================

# -------------------------------------------------------------
# Database (Neon Postgres)
# Get these from: https://console.neon.tech → your project → Connection string
# Use the "Prisma" connection string format.
# DATABASE_URL       → pooled connection (used at runtime via PgBouncer)
# DATABASE_URL_UNPOOLED → direct connection (used by Prisma Migrate)
# -------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"

# -------------------------------------------------------------
# Clerk Authentication
# Get these from: https://dashboard.clerk.com → your app → API Keys
# Configure Google + GitHub OAuth in Clerk Dashboard → Social connections
# -------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Clerk redirect URLs — change after-sign-in/up targets to suit your flow
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/signin
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# -------------------------------------------------------------
# AI models (LUM-1019) — optional; pick ONE route. With none of
# these set, AI features report "AI is not configured" and the
# rest of Lumo keeps working.
#
# 1. Vercel AI Gateway (the hosted SaaS default). Locally set the
#    key; on Vercel the OIDC token is used automatically. Every
#    request is forced to zero data retention (lib/ai/zdr-fetch.ts).
# -------------------------------------------------------------
AI_GATEWAY_API_KEY=""

# 2. Direct provider keys — used only when the gateway is not
#    configured (or with AI_PROVIDER=direct). Lumo's model ids are
#    gateway-style (lib/ai/models.ts) and are mapped:
#    `anthropic/claude-sonnet-4.6` → Anthropic `claude-sonnet-4-6`;
#    any other id → the OpenAI-compatible endpoint, as
#    OPENAI_COMPATIBLE_MODEL if set, else without the provider
#    prefix (`openai/gpt-5.5` → `gpt-5.5`).
#
#    ZERO DATA RETENTION IS YOUR RESPONSIBILITY on this route: Lumo
#    cannot enforce it outside the gateway. Check the data-retention
#    terms of the provider / endpoint you point Lumo at.
#
#    Embeddings (memory search) need an OpenAI-compatible
#    embedding model with 1024-dimension output; without one,
#    memory search falls back to lexical matching. Crossing triage
#    (an evaluation model) needs the gateway and is skipped here.
# -------------------------------------------------------------
# AI_PROVIDER=direct            # gateway | direct | none (default: automatic)
# ANTHROPIC_API_KEY=""
# ANTHROPIC_BASE_URL=""         # default https://api.anthropic.com/v1
# ANTHROPIC_MODEL=""            # Claude model for non-Claude ids when no OpenAI-compatible endpoint is set
# OPENAI_COMPATIBLE_BASE_URL="" # e.g. https://api.openai.com/v1, http://localhost:11434/v1 (Ollama), a vLLM server
# OPENAI_COMPATIBLE_API_KEY=""
# OPENAI_COMPATIBLE_MODEL=""    # one model for every non-Claude id, e.g. llama3.1
# OPENAI_COMPATIBLE_EMBEDDING_MODEL=""
# OPENAI_COMPATIBLE_STRUCTURED_OUTPUTS=false  # only if the endpoint rejects response_format json_schema

# -------------------------------------------------------------
# Vercel Blob Storage (for workspace logo uploads)
# Get from: https://vercel.com/dashboard → Storage → Blob → your store → Settings
# On Vercel the token is injected automatically when the store is linked to the project.
# -------------------------------------------------------------
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Private Vercel Blob store (LUM-916) — test evidence, editor images, workspace
# exports, SARIF uploads. Access is per STORE in Vercel Blob, so this is a
# second store created with Access = Private and linked to the project with the
# env prefix BLOB_PRIVATE. Required: private uploads fail without it.
BLOB_PRIVATE_READ_WRITE_TOKEN=""

# -------------------------------------------------------------
# Self-hosted blob storage (optional, LUM-1021) — instead of Vercel Blob.
# Backend selection: BLOB_STORAGE (vercel|s3|disk) if set; otherwise a Vercel
# Blob token above → vercel; else S3_BUCKET → s3; else LOCAL_BLOB_DIR → disk.
# If more than one of these is set and BLOB_STORAGE is not, the precedence
# still applies but the server logs a warning naming the chosen backend — a
# leftover Vercel token silently beats S3_BUCKET / LOCAL_BLOB_DIR otherwise.
# Set BLOB_STORAGE explicitly (or remove the unused settings) to pick one.
# Switching an existing deployment from Vercel Blob to S3 / disk does NOT move
# files: Vercel Blob URLs already stored in the DB (evidence, editor images,
# exports, logos) are not readable through the new backend until the data is
# migrated — see docs/privacy/uploaded-files.md.
# Private files (evidence, editor images, exports) stay private on every
# backend: they are only served by Lumo's authenticated routes. Workspace
# logos are served publicly by /api/blob/public/... on S3 / disk.
# Direct SARIF uploads (POST /api/integrations/security/sarif/upload) need
# Vercel Blob and answer 501 on S3 / disk.
# -------------------------------------------------------------
# BLOB_STORAGE=s3

# S3-compatible (AWS S3, MinIO, R2, …). Keep the bucket PRIVATE (no public
# policy); objects live under public/ and private/ key prefixes.
# Uploads never overwrite: Lumo checks HeadObject before each put (so servers
# that ignore If-None-Match still refuse), and falls back when the server
# rejects If-None-Match. Credentials need s3:ListBucket so a missing key is 404.
# S3_BUCKET=lumo
# S3_REGION=us-east-1
# S3_ENDPOINT=http://minio:9000        # omit for AWS S3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=                 # omit both to use the AWS credential chain
# S3_FORCE_PATH_STYLE=true              # default: true when S3_ENDPOINT is set

# Local disk (single node). Must NOT be inside the app's public/ folder.
# LOCAL_BLOB_DIR=/var/lib/lumo/blobs

# -------------------------------------------------------------
# PR security scan (LUM-735)
# Lumo scans every pull request head itself in a Vercel Sandbox (semgrep +
# gitleaks). Sandbox auth is automatic on Vercel; locally run `vercel env pull`
# to get VERCEL_OIDC_TOKEN (12h). Set LUMO_MANAGED_SCAN=off to disable the
# managed scan (the panel then only reflects SARIF pushed by your own CI).
# LUM-1025: optional. Without Sandbox credentials (not on Vercel and no
# VERCEL_OIDC_TOKEN) the managed scan, default-branch baseline, L3 hunt and
# review verifier are all off and the settings page marks them unavailable.
# LUMO_OIDC_AUDIENCE overrides the audience accepted from GitHub Actions OIDC
# tokens on the SARIF push API (default: lumo).
# -------------------------------------------------------------
# LUMO_MANAGED_SCAN=off
# LUMO_OIDC_AUDIENCE=lumo
# LUM-745: managed scans one workspace may start per rolling hour (default 20).
# Beyond it the scan is recorded FAILED with a rate-limited reason and no
# sandbox starts. A sweep every 15 min fails any scan still PENDING after 45 min.
# LUMO_MANAGED_SCAN_HOURLY_CAP=20
# L3 vulnerability hunt (LUM-739): when a PR touches an API route / server
# action, a dangerous call or an auth/validation check, a Vercel Workflow
# builds a call subgraph of the touched files, runs an LLM hunt + a falsifier
# over it and records advisory findings. Set LUMO_SECURITY_HUNT=off to disable.
# LUMO_SECURITY_HUNT=off
# LUM-740: every external-tool (semgrep / gitleaks) finding goes through a
# falsifier once; a REJECT only *suggests* a false-positive disposition that a
# human confirms in the panel — LOW and suggested rows get no inline PR
# comment. Set LUMO_SECURITY_SUGGEST=off to disable the suggestion pass.
# LUMO_SECURITY_SUGGEST=off

# -------------------------------------------------------------
# Link previews (OG metadata) — LUM-1025
# Sites that block a plain fetch are retried in headless Chromium when one is
# available: on Vercel, with CHROME_PATH, or in local dev on macOS/Windows.
# Elsewhere (self-hosted Linux) previews use the plain fetch only.
# LUMO_OG_CHROMIUM=on|off forces it either way.
# -------------------------------------------------------------
# CHROME_PATH=
# LUMO_OG_CHROMIUM=off

# -------------------------------------------------------------
# Email (optional — invites, owner notices)
# RESEND_API_KEY wins if set; otherwise SMTP is used when SMTP_URL or
# SMTP_HOST is set. With neither, emails are logged and skipped.
# Resend: https://resend.com/api-keys — a "Sending" key with access to your
# verified domain.
# -------------------------------------------------------------
RESEND_API_KEY="re_..."
# SMTP (self-hosting): blank RESEND_API_KEY, then set one URL or host + port + credentials
# SMTP_URL="smtps://user:password@smtp.example.com:465"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"            # default 587; 465 implies TLS-on-connect
# SMTP_SECURE="false"        # "true" forces TLS-on-connect
# SMTP_USER=""
# SMTP_PASS=""
# EMAIL_FROM="Lumo <noreply@example.com>"  # sender; set to a domain your SMTP may send as

# -------------------------------------------------------------
# App URL (used to build invite links in emails)
# Set to your production URL on Vercel; use http://localhost:3000 locally.
# -------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -------------------------------------------------------------
# Optional integrations (LUM-1025): GitHub, Slack, Sentry, Figma and Google
# Drive are each hidden on the integrations page until every variable they
# need below (plus ENCRYPTION_KEY) is set; their routes answer 404
# `integration_not_configured` instead of failing.
# -------------------------------------------------------------

# -------------------------------------------------------------
# GitHub OAuth App (for GitHub integration)
# Create at: https://github.com/settings/developers → OAuth Apps → New OAuth App
# Callback URL: https://your-domain.com/api/github/callback
# -------------------------------------------------------------
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# GitHub App (installation flow + installation tokens) — see README
GITHUB_APP_SLUG=""
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
# The App's own client credentials (App settings → General), used to verify
# the installer can access the installation. Callback URL:
# https://your-domain.com/api/github/app/callback
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""
GITHUB_APP_WEBHOOK_SECRET=""
# 32-byte hex string for AES-256-GCM token encryption
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# -------------------------------------------------------------
# Slack OAuth App (for Slack integration)
# Create at: https://api.slack.com/apps → Create New App
# Callback URL: https://your-domain.com/api/slack/callback
# Use "Signing Secret" from "Basic Information" tab
# Use Client ID and Client Secret from "OAuth & Permissions" tab
# -------------------------------------------------------------
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_SIGNING_SECRET=""

# -------------------------------------------------------------
# Rate limiting backend (MCP tool calls, SARIF ingest, waitlist signup)
# Optional. Picked per request, first match wins (lib/rate-limit, LUM-1020):
#   1. Vercel KV / Upstash — KV_REST_API_URL + KV_REST_API_TOKEN
#      (Vercel dashboard after linking a KV store; the hosted SaaS uses this)
#   2. Standard Redis      — REDIS_URL, e.g. redis://localhost:6379
#                            or rediss://user:pass@host:6380 for TLS
#   3. In-memory fallback  — when none of the above is set.
#      SINGLE-INSTANCE ONLY: counters live in each server process, so with
#      N instances (or serverless) the effective limit is N x the configured
#      limit, and every restart/deploy resets them. Set REDIS_URL for any
#      multi-instance self-hosted deployment.
# -------------------------------------------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=
REDIS_URL=

# Google Drive integration (LUM-127) — per-user OAuth for importing Google Docs.
# Reuses the shared Google OAuth client's credentials (GOOGLE_CLIENT_ID/SECRET);
# only the redirect URI is Drive-specific and must match the OAuth client's
# Authorized redirect URI exactly (…/api/google-drive/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=

# -------------------------------------------------------------
# Self-hosted workflow delivery auth (LUM-1031). Ignored on Vercel.
# When the Workflow runtime is not the Vercel World (e.g. Postgres World),
# /.well-known/workflow/* rejects every request without this secret
# (fail-closed: unset = all deliveries refused). The worker carries it as
# URL userinfo, sent as `Authorization: Basic` — url-encode the secret there:
#   WORKFLOW_LOCAL_BASE_URL=http://workflow:<url-encoded secret>@localhost:3000
# Generate with: openssl rand -hex 32
# -------------------------------------------------------------
WORKFLOW_SECRET=
WORKFLOW_LOCAL_BASE_URL=
