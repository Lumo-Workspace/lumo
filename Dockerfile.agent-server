# ── Build stage ────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

# Copy root workspace config
COPY package.json package-lock.json ./

# Copy workspace packages
COPY shared/ shared/
COPY agent-server/ agent-server/

# Copy Prisma schema
COPY prisma/ prisma/
COPY prisma.config.ts ./

# Install deps (skip postinstall/prepare to avoid husky in Docker)
RUN npm ci --workspace=shared --workspace=agent-server --ignore-scripts

# Manually run prisma generate
RUN npx prisma generate

# Build shared first (agent-server depends on it)
WORKDIR /app/shared
RUN npx tsc

# Build agent-server
WORKDIR /app/agent-server
RUN npx tsc

# ── Production stage ──────────────────────────────────────────────────────
FROM node:22-alpine AS runner

WORKDIR /app

# Copy root workspace config
COPY package.json package-lock.json ./
COPY shared/ shared/
COPY agent-server/package.json agent-server/package.json

# Copy Prisma schema
COPY prisma/ prisma/
COPY prisma.config.ts ./

# Install production deps only (skip scripts)
RUN npm ci --workspace=shared --workspace=agent-server --omit=dev --ignore-scripts
RUN npx prisma generate

# Copy built code
COPY --from=builder /app/shared/dist shared/dist
COPY --from=builder /app/agent-server/dist agent-server/dist

ENV NODE_ENV=production
ENV PORT=4001

EXPOSE 4001

CMD ["node", "agent-server/dist/server.js"]
