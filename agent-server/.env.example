# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://...
DATABASE_URL_UNPOOLED=postgresql://...

# ── Service auth ──────────────────────────────────────────────────────────
AGENT_SERVICE_SECRET=your-shared-secret-here

# ── GitHub App ────────────────────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# ── Pusher ────────────────────────────────────────────────────────────────
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# ── AI ────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Callback URL (where sandbox reports completion) ──────────────────────
# If this server is the callback target, set to this server's public URL
# Otherwise set to the Next.js app URL
AGENT_CALLBACK_URL=https://agent.yourdomain.com

# ── Server ────────────────────────────────────────────────────────────────
PORT=4001
HOST=0.0.0.0
