# Database
SUPA_POSTGRES_PRISMA_URL="postgresql://username:password@localhost:5432/lumo_dev"
SUPA_POSTGRES_URL_NON_POOLING="postgresql://username:password@localhost:5432/lumo_dev"

# NextAuth.js Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="" # Generate with: openssl rand -base64 32 (min 32 characters)

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="" # Format: 123456789-abc123xyz.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET="" # Format: GOCSPX-abc123DEF456xyz789

# Token Encryption Keys
TOKEN_ENCRYPTION_KEY="" # Generate with: openssl rand -base64 32 (32-byte key for AES-256-GCM)
TOKEN_ENCRYPTION_KEY_PREVIOUS="" # Optional: For key rotation

# Optional Configuration
SESSION_MAX_AGE_HOURS=24 # Session expiration (default: 24)
MAX_CONCURRENT_SESSIONS=3 # Concurrent session limit (default: 3)
TOKEN_INACTIVITY_DAYS=30 # Token cleanup threshold (default: 30)
OAUTH_STATE_TTL_MS=600000 # State param TTL (default: 10 min)
OAUTH_TOKEN_TIMEOUT_MS=5000 # Token exchange timeout (default: 5s)

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN="your-vercel-blob-token"
