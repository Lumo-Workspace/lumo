# =============================================================
# Lumo — Environment Variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.
# =============================================================

# -------------------------------------------------------------
# Database (Neon Postgres)
# Get these from: https://console.neon.tech → your project → Connection string
# Use the "Prisma" connection string format (with ?pgbouncer=true for pooled)
# -------------------------------------------------------------
DATABASE_URL="postgresql://username:password@ep-xxx.neon.tech/lumodev?sslmode=require&pgbouncer=true"
DATABASE_URL_UNPOOLED="postgresql://username:password@ep-xxx.neon.tech/lumodev?sslmode=require"

# -------------------------------------------------------------
# Clerk Authentication
# Get these from: https://dashboard.clerk.com → your app → API Keys
# Configure Google + GitHub OAuth in Clerk Dashboard → Social connections
# -------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/workspace
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# -------------------------------------------------------------
# OpenAI (for AI plan generation — Sprint 2)
# Get from: https://platform.openai.com/api-keys
# -------------------------------------------------------------
OPENAI_API_KEY=""

# -------------------------------------------------------------
# Vercel Blob Storage (for avatar uploads — optional)
# Get from: https://vercel.com/dashboard → Storage → Blob
# -------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=""
