# =============================================================
# Lumo — Environment Variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.
# =============================================================

# -------------------------------------------------------------
# Database (Neon Postgres)
# Get these from: https://console.neon.tech → your project → Connection string
# Use the "Prisma" connection string format (with ?pgbouncer=true for pooled)
# -------------------------------------------------------------
DATABASE_URL="postgresql://username:password@ep-xxx.neon.tech/lumodev?sslmode=require&pgbouncer=true"
DATABASE_URL_UNPOOLED="postgresql://username:password@ep-xxx.neon.tech/lumodev?sslmode=require"

# -------------------------------------------------------------
# Clerk Authentication
# Get these from: https://dashboard.clerk.com → your app → API Keys
# Configure Google + GitHub OAuth in Clerk Dashboard → Social connections
# -------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/workspace
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# -------------------------------------------------------------
# Vercel AI Gateway (for task decomposition, AI features)
# Get from: https://vercel.com/account/tokens
# Not needed when deployed on Vercel (auto-authenticated)
# -------------------------------------------------------------
VERCEL_API_KEY=""

# -------------------------------------------------------------
# Anthropic (for Claude Agent SDK — Sprint 2+)
# Get from: https://console.anthropic.com/settings/keys
# -------------------------------------------------------------
ANTHROPIC_API_KEY="sk-ant-..."

# -------------------------------------------------------------
# Pusher (real-time updates — optional)
# Get from: https://pusher.com → Create app → App Keys
# Leave the keys empty to run without realtime: the UI then refetches on
# window focus and every minute instead.
# -------------------------------------------------------------
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="us2"

NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="us2"

# Self-hosting with Soketi (or any Pusher-protocol server) — optional.
# Setting a host overrides the cluster. NEXT_PUBLIC_* are baked in at build time,
# so set them before `next build` (rebuild the image to change them).
# PUSHER_HOST="soketi"                    # host the server reaches Soketi on
# PUSHER_PORT="6001"                      # Soketi port (default 443/80 by TLS)
# PUSHER_USE_TLS="false"                  # "false" for plain http; default true
# NEXT_PUBLIC_PUSHER_HOST="rt.example.com" # host the browser reaches Soketi on
# NEXT_PUBLIC_PUSHER_PORT="6001"
# NEXT_PUBLIC_PUSHER_USE_TLS="false"

# -------------------------------------------------------------
# Vercel Blob Storage (for avatar uploads — optional)
# Get from: https://vercel.com/dashboard → Storage → Blob
# -------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=""

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -------------------------------------------------------------
# GitHub OAuth App
# Get from: https://github.com/settings/developers → OAuth Apps
# -------------------------------------------------------------
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# GitHub PAT (for sandbox testing — replaced by OAuth token in production)
# Fine-grained token permissions: Contents (read/write), Pull requests (read/write)
GITHUB_TOKEN="ghp_..."
GITHUB_OWNER="your-github-username"
GITHUB_REPO="your-repo-name"

# -------------------------------------------------------------
# E2B (for sandbox execution — Sprint 2+)
# Get from: https://e2b.dev/dashboard → API Keys
# -------------------------------------------------------------
E2B_API_KEY="e2b_..."

# -------------------------------------------------------------
# Rate limiting backend (MCP tool calls, SARIF ingest, waitlist signup)
# Optional. Picked per request, first match wins (lib/rate-limit, LUM-1020):
#   1. Vercel KV / Upstash — KV_REST_API_URL + KV_REST_API_TOKEN
#      (Vercel dashboard after linking a KV store; the hosted SaaS uses this)
#   2. Standard Redis      — REDIS_URL, e.g. redis://localhost:6379
#                            or rediss://user:pass@host:6380 for TLS
#   3. In-memory fallback  — when none of the above is set.
#      SINGLE-INSTANCE ONLY: counters live in each server process, so with
#      N instances (or serverless) the effective limit is N x the configured
#      limit, and every restart/deploy resets them. Set REDIS_URL for any
#      multi-instance self-hosted deployment.
# -------------------------------------------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=
REDIS_URL=

# -------------------------------------------------------------
# Agent Server (optional — when agent-server runs as separate service)
# Set AGENT_SERVICE_URL to delegate agent execution to the external service
# AGENT_SERVICE_SECRET must match between Next.js app and agent-server
# -------------------------------------------------------------
# AGENT_SERVICE_URL="https://agent.yourdomain.com"
# AGENT_SERVICE_SECRET="your-shared-secret"
