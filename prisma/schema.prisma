/// Server-side auto-blocking ledger (LUM-544, Section 3 — automates the old
/// `lumo session wrap` blocked-tag prompt). When a session crosses the
/// same-tool failure threshold (FAILURE_PROMPT_THRESHOLD) the server applies the
/// shared `blocked` tag to the bound task AND records one ACTIVE row here. This
/// row is the seam for the three safeguards:
///   • idempotency — a partial unique on (taskId) WHERE active gives at most one
///     live auto-block per task, so re-crossing is a no-op insert.
///   • auto-untag on progress — the next successful tool/turn on the task flips
///     active→false (resolvedAt stamped) and removes the tag ONLY because this
///     row proves Lumo applied it (a human-applied `blocked` tag has no AutoBlock
///     row, so progress never silently clears it).
///   • attribution — triggeringSessionId + model record who tripped the block.
model AutoBlock {
  id                  String    @id @default(cuid())
  taskId              String
  /// Session whose failures crossed the threshold. SetNull-FK-less by intent:
  /// keep the audit row if the session is later pruned. Nullable for safety.
  triggeringSessionId String?
  /// Best-effort raw model string (first key of the session's usageByModel
  /// cumulative map). Null when the session carried no usage yet.
  model               String?
  /// The dominant failure group label + count that tripped the block, for the
  /// board/audit ("Bash ×3").
  topFailureLabel     String?
  failureCount        Int
  /// Live flag. Exactly one ACTIVE row per task (partial unique index). Flipped
  /// to false on auto-untag; the row is retained for audit.
  active              Boolean   @default(true)
  blockedAt           DateTime  @default(now())
  /// Stamped when progress auto-cleared the block. Null while active.
  resolvedAt          DateTime?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("auto_blocks")
}

model DocumentComment {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  authorActorId String?
  author        Actor?  @relation("DocumentCommentAuthor", fields: [authorActorId], references: [id], onDelete: SetNull)

  body String @db.Text

  parentId String?
  parent   DocumentComment?  @relation("DocCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  DocumentComment[] @relation("DocCommentReplies")

  quotedText  String?               @db.Text
  anchorStart Int?
  anchorEnd   Int?
  status      DocumentCommentStatus @default(OPEN)
  isOrphaned  Boolean               @default(false)

  resolvedByActorId String?
  resolvedBy        Actor?    @relation("DocumentCommentResolver", fields: [resolvedByActorId], references: [id], onDelete: SetNull)
  resolvedAt        DateTime?

  type CommentType @default(USER)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([documentId, deletedAt])
  @@index([parentId])
}

model GenerationJob {
  id        String   @id @default(cuid())
  type      String // 'project' | 'workspace' | 'sprint' | 'milestone'
  targetId  String // projectId or workspaceId
  status    String   @default("pending") // pending | completed | failed
  summaryId String? // populated on success
  createdAt DateTime @default(now())

  @@index([targetId, createdAt(sort: Desc)])
}

