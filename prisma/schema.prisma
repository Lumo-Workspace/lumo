// ─── Documents ──────────────────────────────────────────────────────────────

model Document {
  id              String  @id @default(cuid())
  title           String  @default("")
  content         String? @db.Text
  // Byte-identical markdown source of the last markdown upload (LUM-408).
  // Double-written whenever content arrives as markdown (CLI/API/gdoc);
  // nulled when content is replaced through the HTML-direct path (web
  // editor, revision restore) so it can never go stale. Null for legacy
  // docs and HTML-only edits — `doc show --raw` errors instead of falling
  // back to the lossy HTML→markdown reverse render.
  sourceMarkdown  String? @db.Text
  // Optimistic-concurrency counter for the document BODY (LUM-409).
  // Incremented on every content-changing write, whichever path it takes
  // (markdown upload, section patch/append, HTML-direct web edit, revision
  // restore, gdoc sync). Title/tag/visibility-only updates do NOT bump it.
  // Writes carrying `ifRevision` are applied as a conditional update on this
  // column and rejected with 409 on mismatch — the failure mode moves from
  // silent last-write-wins to a visible conflict.
  contentRevision Int     @default(0)
  emoji           String?

  summary            String?   @db.Text
  summaryGeneratedAt DateTime?

  // Google Docs import source (LUM-127). Null for native docs.
  googleDocId         String? // Google Drive fileId this doc mirrors
  googleDocImporterId String? // WorkspaceMember whose Google token re-syncs run as
  googleDocSyncedAt   DateTime? // last successful Google → Lumo sync
  googleDocSyncError  String?   @db.Text // last sync failure reason, cleared on success

  // Per-workspace incrementing identifier. Combined with slugified title to
  // form the user-facing slug below.
  number Int
  slug   String

  parentId     String?
  parent       Document?        @relation("DocTree", fields: [parentId], references: [id])
  children     Document[]       @relation("DocTree")
  sortOrder    Float            @default(0)
  publicToken  String?          @unique
  tags         String[]         @default([]) // @deprecated — migrating to Tag relation
  editors      DocumentEditor[]
  documentTags DocumentTag[]

  projectId   String?
  project     Project?        @relation(fields: [projectId], references: [id])
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   WorkspaceMember @relation("DocumentCreator", fields: [createdById], references: [id])

  visibility       DocVisibility      @default(PRIVATE)
  shares           DocumentShare[]
  mentions         DocumentMention[]
  documentComments DocumentComment[]
  revisions        DocumentRevision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // LUM-918: trash. A deleted row stays here with `deletedAt` set for 30
  // days (restorable), then the purge cron hard-deletes it. Reads skip it by
  // default (lib/db/soft-delete.ts). The row the user deleted is the trash
  // root (`trashRootId` null); its descendants point `trashRootId` at it and
  // are restored / purged with it.
  deletedAt        DateTime?
  trashRootId      String?
  deletedByClerkId String?

  @@unique([workspaceId, number])
  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([parentId])
  @@index([projectId])
  @@index([createdById])
  @@index([workspaceId, googleDocId])
  @@index([deletedAt])
  @@index([trashRootId])
}

model DocumentTemplate {
  id          String     @id @default(cuid())
  key         String     @unique
  emoji       String?
  content     String     @db.Text
  sortOrder   Float
  isSystem    Boolean    @default(true)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([workspaceId])
}

