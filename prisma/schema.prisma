// ─── Context Lineage (LUM-275) ────────────────────────────────────────────────
// One edge = "this context fragment was injected into this task's context during
// this run/session, and here's what came of it (outcome)". The edge — not the
// fragment — is the system-of-record asset for the Context Lineage milestone.

enum LineageFragmentType {
  MEMORY
  SLACK_CONTEXT
  WEB_LINK
  FIGMA
  PR
  PR_REVIEW_TODO
  SESSION
}

enum LineageOutcome {
  MERGED
  REJECTED
  REWORKED
  UNKNOWN
}

enum LineageDisclosure {
  FULL
  INDEX
}

model LineageEdge {
  id             String              @id @default(cuid())
  workspaceId    String
  taskId         String
  // Polymorphic reference to the source fragment. No FK relation: fragmentId
  // points at a different table per fragmentType, and source rows can be
  // consolidated / edited / deleted independently (deletion propagation is
  // tracked as known debt for the milestone). Stable-ID work lives in LUM-274/280.
  fragmentType   LineageFragmentType
  fragmentId     String
  sessionId      String?
  includedAt     DateTime            @default(now())
  // Starts UNKNOWN at birth; stamped MERGED/REJECTED/REWORKED when the edge
  // closes (PR merged / task done) — see DoD ③ in the milestone goal.
  outcome        LineageOutcome      @default(UNKNOWN)
  // LUM-300 usage vote: null = not voted, true = agent reported using this
  // fragment, false = injected but unused. usedAt also marks "has this session
  // voted?" (avoids a separate Session watermark column).
  used           Boolean?
  usedAt         DateTime?
  // 渐进式披露漏斗：FULL = Tier1 全文注入；INDEX = Tier2 仅索引行。
  disclosure     LineageDisclosure   @default(FULL)
  // agent 经 `lumo … show <id>` 主动拉取该 fragment 正文的时刻（漏斗中间环）。
  pulledAt       DateTime?
  // LUM-522 token-level funnel: per-fragment injection cost. indexTokens =
  // the INDEX/manifest line actually injected; fullTokens = the FULL rendered
  // body this INDEX impression avoided. Savings = Σ(fullTokens − indexTokens)
  // over un-pulled INDEX edges, computed read-time (nulls skipped, never 0).
  // Nullable + additive: historical edges and non-tagging aggregate callers
  // are unaffected (mirrors disclosure/pulledAt).
  indexTokens    Int?
  fullTokens     Int?
  // LUM-522: relevance-gate similarity score at injection time (LUM-486).
  // Null when the fragment was not gate-scored (small-corpus bypass,
  // fallback-all, or a non-MEMORY fragment).
  relevanceScore Float?
  updatedAt      DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  session   Session?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([sessionId, taskId, fragmentType, fragmentId])
  @@index([fragmentType, fragmentId])
  @@index([taskId])
  @@index([workspaceId])
  @@map("lineage_edges")
}

/// LUM-648: cross-milestone learning-migration edge. The task-flywheel's
/// LineageEdge requires a non-null taskId, but a milestone STEWARD session is
/// bound to a milestone, not a task — so it cannot carry a LineageEdge. This
/// dedicated table records the same used=true/false/null usage-vote substrate
/// for the one injection path a steward session has: a MILESTONE-scope memory
/// (distilled from an earlier milestone's close retro, LUM-647) injected into a
/// later milestone's steward session. Isolated from the task flywheel by design
/// (no reader assumes taskId/outcome here). One row per (steward session ×
/// injected memory); the usage vote is stamped by the audit at the CONSUMER
/// milestone's close, reusing judgeFragmentUsage.
model MilestoneMemoryEdge {
  id                  String    @id @default(cuid())
  workspaceId         String
  /// The injected MILESTONE-scope memory.
  memoryId            String
  /// The milestone whose close retro distilled the memory (= Memory.milestoneId
  /// at injection time). Nullable + SetNull so a deleted source milestone leaves
  /// the usage record intact (mirrors Memory.milestoneId).
  sourceMilestoneId   String?
  /// The later milestone whose steward session consumed the memory.
  consumerMilestoneId String
  /// The steward session the memory was injected into.
  sessionId           String
  injectedAt          DateTime  @default(now())
  /// Usage vote (mirrors LineageEdge.used): null = not yet audited / judge
  /// abstained, true = judge found concrete evidence of use, false = judged
  /// unused. usedAt also marks "has this session been audited?" (idempotency).
  used                Boolean?
  usedAt              DateTime?
  updatedAt           DateTime  @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memory    Memory     @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  source    Milestone? @relation("MilestoneMemoryEdgeSource", fields: [sourceMilestoneId], references: [id], onDelete: SetNull)
  consumer  Milestone  @relation("MilestoneMemoryEdgeConsumer", fields: [consumerMilestoneId], references: [id], onDelete: Cascade)
  session   Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, memoryId])
  @@index([consumerMilestoneId])
  @@index([memoryId])
  @@index([workspaceId])
  @@map("milestone_memory_edges")
}

/// LUM-522: a PROJECT-memory fragment the relevance gate (LUM-486) dropped
/// below its floor / past top-K — recorded id+score only (not a full edge),
/// so gate precision can be measured (did we drop something that later
/// mattered?). Side table keeps every LineageEdge an "injected impression".
model DroppedFragment {
  id             String              @id @default(cuid())
  workspaceId    String
  taskId         String
  sessionId      String?
  fragmentType   LineageFragmentType
  fragmentId     String
  relevanceScore Float?
  droppedAt      DateTime            @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  session   Session?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  // Idempotent collection: a bound session re-records the same dropped
  // fragments on every session-start. Mirrors LineageEdge's unique key
  // (LUM-530). Postgres treats NULL as distinct, so null-session rows are
  // never deduped by the index — same semantics as LineageEdge.
  @@unique([sessionId, taskId, fragmentType, fragmentId])
  @@index([taskId])
  @@index([sessionId])
  @@index([workspaceId])
  @@map("dropped_fragments")
}

/// LUM-598 事后结果井 (post-hoc outcome well). The single external oracle for
/// correctness + fidelity: the real-world fate of a delivery AFTER it ships —
/// facts the agent cannot construct, occurring post-delivery (a revert, a
/// reopen, a rollback, CI turning red, a downstream redirect of the design).
///
/// INVARIANT — falsifier, not verifier. Every row is a *rejection* signal:
/// reality revoked, redid, or bypassed the delivery. The well NEVER records a
/// "satisfied" signal. "N sprints, nobody touched it" is the ABSENCE of a
/// rejection (satisfied / tolerated / unnoticed are externally indistinguish-
/// able from outside) and reads INCONCLUSIVE — never PASS. The derived verdict
/// is therefore only REJECTED (≥1 signal) | INCONCLUSIVE (none); there is no
/// SATISFIED branch anywhere. Insert-only: signals are never updated or deleted.
model OutcomeSignal {
  id                 String              @id @default(cuid())
  workspaceId        String
  taskId             String
  kind               OutcomeSignalKind
  source             OutcomeSignalSource
  // occurredAt = when the real-world event happened (revert/reopen time), when
  // known; detectedAt = when the well recorded it. Both are post-delivery.
  occurredAt         DateTime?
  detectedAt         DateTime            @default(now())
  // Referent evidence the agent cannot fabricate: commit/PR/session pointers, a
  // revertsSha, or a human note for the MANUAL path. Free-form JSON, read-only.
  evidence           Json?
  // Audit pointers (no FK on session — it may be pruned independently).
  sessionId          String?
  recordedByMemberId String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([workspaceId])
  @@map("outcome_signals")
}

enum OutcomeSignalKind {
  REVERTED // delivery commit/PR reverted by a later change
  REOPENED // task reopened after MERGED (folds the existing REWORKED fact)
  ROLLED_BACK // deployment rolled back
  CI_REGRESSION // CI turned red after the delivery landed
  DOWNSTREAM_REDIRECT // a later change reversed this delivery's design choice
  BYPASSED // delivery bypassed / redone elsewhere
  MANUAL // human-recorded rejection (specifics in evidence)
}

enum OutcomeSignalSource {
  GIT // derived from commit/revert history
  CI // derived from CI status observed after delivery
  LINEAGE // derived from a lineage outcome transition (reopen → REWORKED)
  MANUAL // human-recorded via CLI
}

/// 交付时固化的 forecast 快照（LUM-319）。只存预测区间；actual 渲染时实算。
/// keep-first：taskId 唯一，reopen 重交付不覆盖，留住首次交付的真实预测。
model TaskForecastSnapshot {
  id                String   @id @default(cuid())
  taskId            String   @unique
  iterations        Json? // { p25, median, p75 } | null
  interactionRounds Json?
  tokenCost         Json?
  cohortSize        Int // 相似 cohort 大小（喂 iterations/interaction）
  tokenCostBasis    Int // 项目级样本数（喂 token）
  capturedAt        DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_forecast_snapshots")
}

// ─── TaskDependency (LUM-172 检测优于声明) ──────────────────────────────────
// Migration: 20260610015440_add_task_dependencies
// LUM-172: task dependency edges (检测优于声明) — initial schema.
// Purely additive: 3 enums + task_dependencies table + indexes + FKs.
// No data migration. Prod applies via `prisma migrate deploy` on next deploy.
// (Header placed here rather than in migration.sql because the migration is
// already recorded as applied in the DB — editing the SQL file would cause
// checksum drift; migrate resolve --applied returns P3008.)

enum DependencyKind {
  BLOCKS
  RELATES
  // LUM-1282: blockedTaskId is the duplicate (CANCELED), blockingTaskId the
  // canonical task it duplicates. Written by `task update --duplicate-of`.
  DUPLICATES
}

enum DependencySource {
  MANUAL
  DETECTED
}

enum DependencyStatus {
  SUGGESTED
  CONFIRMED
  DISMISSED
}

model TaskDependency {
  id             String           @id @default(cuid())
  workspaceId    String
  // 方向:blockingTask 先 merge,blockedTask 等待。
  // kind=RELATES 时无方向语义,两列只是存储位;v1 检测器只产 BLOCKS。
  blockedTaskId  String
  blockingTaskId String
  kind           DependencyKind   @default(BLOCKS)
  source         DependencySource
  status         DependencyStatus @default(SUGGESTED)
  // 可解释红线:检测边必须说得清来源。'task_mention' | 'shared_files';
  // detail 放证据(mention 表面 / 共享文件数量+样本)。MANUAL 边为 null。
  reason         String?
  detail         Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  confirmedAt    DateTime?

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  blockedTask  Task      @relation("TaskBlockedBy", fields: [blockedTaskId], references: [id], onDelete: Cascade)
  blockingTask Task      @relation("TaskBlocking", fields: [blockingTaskId], references: [id], onDelete: Cascade)

  // 唯一约束不含 status:DISMISSED 边挡住同 pair 的重新 INSERT(检测器靠
  // skipDuplicates + 先查已有 pair 实现「dismiss 即免疫重建议」);要复活走 UPDATE。
  @@unique([blockedTaskId, blockingTaskId])
  @@index([workspaceId, status])
  @@index([blockingTaskId])
  @@map("task_dependencies")
}

// LUM-582: claim faithfulness verdict — an independent "测" for the "估" claim.
// Produced offline by scripts/audit-claim-faithfulness.ts (git diff vs claim,
// LLM judge); the read path consumes the persisted verdict (no LLM at read).
// `judgedClaimAt` records the claimSnapshot watermark judged, for staleness.
model ClaimFaithfulnessVerdict {
  id              String    @id @default(cuid())
  taskId          String    @unique
  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  verdict         String // FAITHFUL | UNDERREPORT | OVERSTATED | UNJUDGEABLE
  evidence        Json?
  reasoning       String?
  diffShas        String[]
  prNumbers       Int[]
  diffScope       Int       @default(0)
  prefilterSignal String?
  judgeModel      String
  judgedClaimAt   DateTime?
  judgedAt        DateTime  @default(now())

  @@index([verdict])
  @@map("claim_faithfulness_verdicts")
}

// ─── Test cases (LUM-801) ───────────────────────────────────────────────────
// 与 AcceptanceCriterion 平行的独立资源：可反复执行的结构化用例 + append-only
// 执行记录。它不是验收合同——合同回答「这个任务算不算做完」,用例回答「这条剧本
// 跑下来是什么结果、在哪个环境、跑的哪版代码」。
// Migration: 20260921_add_test_cases

enum TestEnvironment {
  LOCAL
  PREVIEW
  PRODUCTION
}

enum TestCaseRunResult {
  PASS
  FAIL
  /// 前置条件 / 环境不满足,用例**根本没跑起来**。正因如此它不携带失败定位
  /// （没跑起来,「挂在第几步」无意义）。跑到一半被外部因素卡住记 FAIL + 定位 + note。
  BLOCKED
}

enum TestCasePhase {
  STEPS
  VERIFICATION
}

/// LUM-808 步骤 1：一条 FAIL 是谁的锅。
/// **新枚举类型**，不是给 TestCaseRunResult ADD VALUE —— 后者会撞上
/// 「PG 禁止同事务使用刚添加的 enum 值」。
/// 举证责任刻意不对称：只有 IMPLEMENTATION_DEFECT 需要额外举证（>=1 条
/// evidence，service 强制），另两类是「我没能证明」，白给。
enum TestCaseFailureAttribution {
  /// 被测实现的锅。唯一背举证责任的一类。
  IMPLEMENTATION_DEFECT
  /// 用例过时（UI / 文案漂移），实现没问题。
  CASE_OUTDATED
  /// 跑到一半被外部因素卡住（对比 BLOCKED：那是根本没跑起来）。
  EXTERNAL_BLOCK
  /// 没判断出来。**这是合法答案，不是逃避** —— 逼出一个乱填的归因只会污染统计。
  UNKNOWN
}

/// LUM-812: 一条 PROVEN_DEFECT run 的人类裁定。**两个值都清闸**（同越界的
/// FALSE_POSITIVE / CONFIRMED 都清闸）——闸门问的从来不是「缺陷修了没」，
/// 而是「有没有人看过一眼并拍板」。
enum TestCaseDefectDisposition {
  /// 认这个缺陷，照发。是个发布决定，不是对归因的否认。
  KNOWN_DEFECT
  /// 归因错了，这不是实现的锅（用例过时 / 外部因素 / 误判）。
  NOT_A_DEFECT
}

/// LUM-812: 裁定是从哪条路进来的。CLI 的三步握手**证明不了人本人点的头**
/// （agent 在转述每一步），所以来源必须留痕 —— 同 LUM-769 给越界打 channel 的理由。
enum TestCaseDispositionChannel {
  WEB
  CLI
}

model TestCase {
  id                  String           @id @default(cuid())
  /// LUM-1135: exactly one of taskId / milestoneId is set (DB CHECK test_cases_owner_check).
  taskId              String?
  /// LUM-1135: milestone-level (cross-task end-to-end) case. Number is 1-based within the milestone.
  milestoneId         String?
  /// 任务内 1-based 顺序号,兼作展示序（v1 不支持重排序）。CLI 句柄 = LUM-12/TC3。
  /// 分配走 max+1 事务 + P2002 重试（LUM-661 模式）。
  number              Int
  title               String
  setup               String?
  /// 有序。元素顺序即执行顺序。
  steps               String[]
  /// 有序,可为空数组（不是每条用例都有复验段）。
  verification        String[]
  expected            String
  /// LUM-808 步骤 2：这条用例只有在该环境跑才证明得了东西。null = 不限。
  /// **精确相等，没有 PRODUCTION ⊇ PREVIEW ⊇ LOCAL 的层级** —— 一条测本地
  /// 工具链的用例，在生产跑并不能证明它。
  requiredEnvironment TestEnvironment?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  /// 软删除墓碑：run→case 的审计链必须活着（同 AcceptanceCriterion.deletedAt）。
  /// 即使还没有 run 也软删,避免两条删除语义。
  deletedAt           DateTime?

  task      Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  milestone Milestone?    @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  runs      TestCaseRun[]

  @@unique([taskId, number])
  @@unique([milestoneId, number])
  @@index([taskId, deletedAt])
  @@index([milestoneId, deletedAt])
  @@map("test_cases")
}

/// Append-only 事件日志：一次执行一行,**永不 update、永不 delete**。
/// 不存在这两条路径——不是「有但禁用」。纠正一次误记的办法是再 append 一条。
model TestCaseRun {
  id         String @id @default(cuid())
  testCaseId String
  /// 反范式：任务级查询免 join。
  taskId      String?
  /// LUM-1135: denormalised owner, same as taskId.
  milestoneId String?

  result      TestCaseRunResult
  /// 没有默认值。整个 feature 的目的就是分清这次跑在哪,给默认值等于鼓励
  /// 不假思索地填 LOCAL —— 服务层缺失即 400。
  environment TestEnvironment

  /// FAIL 时的失败定位。哪一段的第几条（**0-based**；CLI 表面是 1-based）。
  /// 非 FAIL 必须为 null。定位本身可选（可能确实不知道哪步挂的）。
  failedPhase    TestCasePhase?
  failedIndex    Int?
  /// 判决时刻的原文快照——用例后来被改写,这条 run 仍读得懂。名字里的 step
  /// 是泛指：failedPhase 为 VERIFICATION 时快照的是复验段那一条。
  /// 同 VerificationRun 反范式 verifierType 的做法。
  failedStepText String?

  /// LUM-808 步骤 1：FAIL 的归因。非 FAIL 必须为 null。
  /// 可空是因为归因机制上线前的行只能是 null —— run 是 append-only，
  /// **不回填**。null 读作「记录于归因机制之前」，不是「没归因」。
  failureAttribution TestCaseFailureAttribution?

  /// LUM-1011：逐步结果。元素：{ phase, index, text, status, durationMs?, evidence? }。
  /// - index 0-based；text 是判决时刻的原文快照（同 failedStepText 的理由）。
  /// - status 只有 PASS / FAIL：**显式上报**的结论。没上报的步骤不在数组里，
  ///   读端把它渲染成「未逐步记录 / 未到达」，**绝不推定为通过**。
  /// - evidence 是本行 evidence 数组的下标（这一步挂的截图 / 日志）。
  /// 选填：为空时读端退回只用 failedPhase/failedIndex 的单点定位。
  /// 例外：逐步结果上线前的旧 run 已一次性回填（用户裁定，迁移
  /// 20261020090000_lum1011_backfill_step_results）：PASS → 全部 PASS（未观察到的
  /// 复验条目除外），FAIL+定位 → 失败点之前 PASS。回填条目带 backfilled: true。
  stepResults Json    @default("[]")
  /// LUM-1011：FAIL 时实际看到的结果（对照用例的期望）。非 FAIL 必须为 null。
  actual      String?

  /// LUM-808 步骤 2：本次**没能观察到**的复验条目。元素：{ index, text }。
  /// text 是判决时刻的原文快照（同 failedStepText 的理由：用例后来被改写，
  /// 这条 run 仍读得懂）。非空 → 一个上报的 PASS 被封顶为 UNPROVEN。
  /// 封顶后的结论由读端推导（deriveRunCeiling），**不落列**。
  unprovenVerification Json @default("[]")

  /// 证据数组。每项二选一：
  ///   { type: 'link', url, label? }
  ///   { type: 'file', url, filename, contentType, size }
  /// 行是 append-only 的,JSON 在这里安全（同 TaskCriteriaSnapshot.criteria）。
  evidence Json @default("[]")

  note String?

  /// 这次执行的**代码坐标**。environment 回答「在哪跑」,这两列回答「跑的哪版代码」。
  /// 只绑 PR 号是不够的：PR 一 push,这条 run 就悄悄过时了。陈旧性由读端比对
  /// commitSha 与 PR 当前 head 推导（deriveRunFreshness）,**不落列**——存下来的
  /// fresh 第二天就是谎话。
  pullRequestId String?
  /// 被测代码的 commit。null = **未记录**,不是「没变过」。
  commitSha     String?
  /// 跑的时候工作区是否有未提交改动。null = 未知；true = 这个 sha 不完全代表
  /// 被测代码,该 run 连 fresh 都不算数。绝不兜底成 false。
  commitDirty   Boolean?

  /// WorkspaceMember id。无 FK（同 VerificationRunWithdrawal.withdrawnById）。
  executedByMemberId String?
  /// X-Lumo-Session-Id。无 FK 的取证指针（同 VerificationRun.sourceSessionId）——
  /// 被清理的 session 不应抹掉出处。
  sourceSessionId    String?

  createdAt DateTime @default(now())

  disposition TestCaseRunDisposition?
  reviews     TestCaseRunReview[]
  testCase    TestCase                @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  task        Task?                   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  milestone   Milestone?              @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  pullRequest PullRequest?            @relation(fields: [pullRequestId], references: [id], onDelete: SetNull)

  @@index([testCaseId, createdAt])
  @@index([taskId, createdAt])
  @@index([milestoneId, createdAt])
  @@index([pullRequestId])
  @@map("test_case_runs")
}

/// LUM-812: 一条 PROVEN_DEFECT run 的**人类处置**——第四条 DONE 拦截面的清闸口。
///
/// 为什么单开一行而不是加列到 TestCaseRun：后者是 append-only 事件日志（永不
/// update、永不 delete，「不存在这两条路径」），装不下可变状态。同 BoundaryCrossing
/// 从 TaskActivity 里分出来的理由——append-only 的东西承载不了可变的处置态。
///
/// **处置绑定在被处置的那一条 run 上**（runId 唯一），不是绑在用例上。闸门读的是
/// 每条用例最新一条 run 的信号，所以处置完之后再 append 一条新的 defect run，新
/// 信号不被旧处置遮蔽，闸门重新拦住。绑在用例上就成了「处置一次永久放行」，
/// 整个拦截面立刻变摆设。
model TestCaseRunDisposition {
  id     String @id @default(cuid())
  /// 唯一：一条 run 最多一个裁定。要改判就在 web 面板上改这一行（同越界可改判）。
  runId  String @unique
  /// 反范式：任务级查询免 join（同 TestCaseRun.taskId）。
  taskId      String?
  /// LUM-1135: denormalised owner, same as taskId.
  milestoneId String?

  disposition TestCaseDefectDisposition
  note        String?

  /// WorkspaceMember id。无 FK（同 BoundaryCrossing.dispositionedById）——
  /// 被清理的成员不应抹掉处置的出处。
  dispositionedById String
  dispositionedAt   DateTime                   @default(now())
  channel           TestCaseDispositionChannel

  run  TestCaseRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  task      Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([milestoneId])
  @@map("test_case_run_dispositions")
}

/// LUM-819 (D): 人对一条「报了 PASS、附了证据」的 run 的**抽查复核**。
///
/// 人的角色从「逐条批准」换成「抽样估虚报率」：看证据 → 认可 / 打回。
/// **不是门闸**——从不拦 DONE；虚报率由读端推导，不落列。
///
/// **append-only，永不 update、永不 delete**（同 TestCaseRun）：改主意就再
/// append 一条，读端按 createdAt 取每条 run 最新的那条。所以这里没有 runId
/// 唯一约束——与 TestCaseRunDisposition（一条 run 至多一个可改判的裁定）不同。
///
/// 只认浏览器会话（Clerk）：复核是「某个人亲眼看过证据并裁定」，bearer 身份在
/// 路由解析 body 之前就被 403（与 human-verdict 同一条信任边界）。
///
/// LUM-1231：抽查功能已删除，产品不再读写这张表。按两步迁移（CLAUDE.md
/// 「Destructive Migrations」）在后续 release 里删表与两个反向关系。
model TestCaseRunReview {
  id            String  @id @default(cuid())
  testCaseRunId String
  /// 反范式：任务级查询免 join（同 TestCaseRun.taskId）。
  taskId        String
  /// true = 看完证据认可这个 PASS；false = 打回（证据撑不起这个 PASS）。
  accepted      Boolean
  note          String?

  /// WorkspaceMember id。无 FK（同 TestCaseRunDisposition.dispositionedById）——
  /// 被清理的成员不应抹掉复核的出处。
  reviewedByMemberId String
  createdAt          DateTime @default(now())

  run  TestCaseRun @relation(fields: [testCaseRunId], references: [id], onDelete: Cascade)
  task Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([testCaseRunId, createdAt])
  @@index([taskId])
  @@map("test_case_run_reviews")
}

/// LUM-933 / LUM-910: how a workspace keeps its session record (raw hook events).
enum HookEventRetentionMode {
  RETAIN
  USED_UP
}

// ─── Better Auth identity store (LUM-1027, self-hosted only) ─────────────────
//
// Used only when AUTH_PROVIDER=better-auth (lib/auth/better-auth/*). The SaaS
// deployment keeps Clerk as the identity provider and never writes here.
// AuthUser.id is an opaque string stored in the same identity columns a Clerk
// user id goes into (WorkspaceMember.clerkId, McpConnection.clerkUserId, …), so
// no app table references these models. Field names follow Better Auth's core
// schema (better-auth 1.7.7); the Prisma model names are mapped in
// lib/auth/better-auth/server.ts (user → authUser, …) so they cannot collide
// with Lumo's own `Session` (agent sessions).

model AuthUser {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  /// Lumo's AuthUser contract has first/last names; kept in sync with `name`
  /// by the Better Auth database hooks.
  firstName     String?
  lastName      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// LUM-1071: Better Auth admin plugin fields (names fixed by better-auth
  /// 1.7.7 plugins/admin/schema). Written by lib/services/auth-user-admin
  /// (scripts/auth-admin/*) and read by the plugin's sign-in ban check.
  role       String?
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  sessions AuthSession[]
  accounts AuthAccount[]

  oauthClients       AuthOauthClient[]
  oauthRefreshTokens AuthOauthRefreshToken[]
  oauthAccessTokens  AuthOauthAccessToken[]
  oauthConsents      AuthOauthConsent[]

  @@map("auth_users")
}

model AuthSession {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  /// LUM-1071: admin plugin field. Impersonation is disabled in Lumo, so it
  /// stays null; the column exists because the plugin's schema declares it.
  impersonatedBy String?

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  oauthRefreshTokens AuthOauthRefreshToken[]
  oauthAccessTokens  AuthOauthAccessToken[]

  @@index([userId])
  @@map("auth_sessions")
}

model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Password hash for the `credential` provider (email + password).
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_accounts")
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("auth_verifications")
}

// ─── MCP OAuth authorization server (LUM-1044) ──────────────────────────────
// Better Auth `jwt` + `@better-auth/oauth-provider` tables, used only when
// AUTH_PROVIDER=better-auth. Column names are the plugins' field names (the
// Prisma adapter addresses them directly); JSON fields are stored as text
// because the adapter serialises them. The SaaS (Clerk) deployment never
// writes here.

/// Signing keys of the `jwt` plugin (private keys encrypted with BETTER_AUTH_SECRET).
model AuthJwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("auth_jwks")
}

/// An OAuth client (in practice: an MCP client that registered dynamically).
model AuthOauthClient {
  id                               String    @id
  clientId                         String    @unique
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?  @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]
  clientCredentialsScopes          String[]
  userId                           String?
  createdAt                        DateTime?
  updatedAt                        DateTime?
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           String[]
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]
  responseTypes                    String[]
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?  @default(false)
  referenceId                      String?
  metadata                         String?

  user          AuthUser?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  resources     AuthOauthClientResource[]
  refreshTokens AuthOauthRefreshToken[]
  accessTokens  AuthOauthAccessToken[]
  consents      AuthOauthConsent[]

  @@index([userId])
  @@map("auth_oauth_clients")
}

/// A protected resource tokens are issued for (RFC 8707) — the MCP endpoint.
model AuthOauthResource {
  id                            String    @id
  identifier                    String    @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[]
  customClaims                  String?
  dpopBoundAccessTokensRequired Boolean?  @default(false)
  disabled                      Boolean?  @default(false)
  createdAt                     DateTime?
  updatedAt                     DateTime?
  policyVersion                 Int?      @default(1)
  metadata                      String?

  clients AuthOauthClientResource[]

  @@map("auth_oauth_resources")
}

/// Which client may request which resource.
model AuthOauthClientResource {
  id         String    @id
  clientId   String
  resourceId String
  metadata   String?
  createdAt  DateTime?

  client   AuthOauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resource AuthOauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)

  @@unique([clientId, resourceId])
  @@index([clientId])
  @@index([resourceId])
  @@map("auth_oauth_client_resources")
}

/// A rotating refresh token (`offline_access`); stored hashed.
model AuthOauthRefreshToken {
  id                      String    @id
  token                   String    @unique
  clientId                String
  sessionId               String?
  userId                  String
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            String?
  scopes                  String[]

  client       AuthOauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  session      AuthSession?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user         AuthUser               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokens AuthOauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("auth_oauth_refresh_tokens")
}

/// An opaque access token (issued only when no resource is bound — the MCP
/// endpoint rejects those; resource-bound tokens are JWTs and not stored).
model AuthOauthAccessToken {
  id                      String    @id
  token                   String?   @unique
  clientId                String
  sessionId               String?
  userId                  String?
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  refreshId               String?
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  confirmation            String?
  scopes                  String[]

  client  AuthOauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  session AuthSession?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user    AuthUser?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh AuthOauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("auth_oauth_access_tokens")
}

/// A user's consent to a client for a set of scopes.
model AuthOauthConsent {
  id                      String   @id
  clientId                String
  userId                  String?
  referenceId             String?
  resources               String[]
  requestedUserInfoClaims String[]
  scopes                  String[]
  createdAt               DateTime
  updatedAt               DateTime

  client AuthOauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   AuthUser?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@map("auth_oauth_consents")
}

/// Single-use `jti` tombstones for `private_key_jwt` client assertions.
model AuthOauthClientAssertion {
  id        String   @id
  expiresAt DateTime

  @@map("auth_oauth_client_assertions")
}

// ─── Better Auth rate limiting (LUM-1070) ───────────────────────────────────
// `rateLimit.storage = 'database'`: one row per (client IP, auth path) bucket,
// shared by every app instance. Only Better Auth deployments write here; it
// deletes expired rows itself whenever a bucket's window rolls over.

/// A rate-limit counter of the Better Auth handler (`key` = IP + path).
model AuthRateLimit {
  id          String @id
  key         String @unique
  count       Int
  /// Epoch milliseconds of the last counted request.
  lastRequest BigInt

  @@index([lastRequest])
  @@map("auth_rate_limits")
}

// LUM-1234: per-workspace monthly LLM spend per feature (month = YYYY-MM, UTC).
model WorkspaceLlmSpend {
  id          String    @id @default(cuid())
  workspaceId String
  feature     String
  month       String
  usdMicros   BigInt    @default(0)
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, feature, month])
  @@map("workspace_llm_spend")
}

// ─── Feedback to the Lumo team (LUM-1240) ───────────────────────────────────
// A customer (person or agent) reports a bug, idea or question to the Lumo
// team. Kept apart from the task system: no task is created in any workspace.
// Design: docs/rfc/2026-10-19-LUM-1240-feedback.md.

enum FeedbackKind {
  BUG
  IDEA
  QUESTION
}

enum FeedbackStatus {
  NEW
  TRIAGED
  RESOLVED
  WONTFIX
}

enum FeedbackSource {
  CLI
  WEB
  API
}

model Feedback {
  id                  String         @id @default(cuid())
  /// Global sequence, for the Lumo team's cross-workspace handle (`#<seq>`).
  /// Never sent to customers (it would leak the total volume).
  seq                 Int            @unique @default(autoincrement())
  workspaceId         String
  /// 1-based within the workspace; the customer handle is `FB-<number>`.
  /// Allocated from Workspace.feedbackSeq inside the create transaction.
  number              Int
  kind                FeedbackKind   @default(BUG)
  /// title / steps / expected / actual are stored credential-redacted.
  title               String
  steps               String[]       @default([])
  expected            String?
  actual              String?
  /// [{ type: 'file', url, filename, contentType, size }] — same shape as
  /// TestCaseRun.evidence. Files live under workspaces/<workspaceId>/feedback/.
  evidence            Json           @default("[]")
  /// Whitelisted client environment (lib/validation/feedback.ts). null = the
  /// submitter turned it off (--no-env), not "unknown".
  environment         Json?
  /// Task ref text only (e.g. LUM-1185) — no FK, no task content.
  taskRef             String?
  /// X-Lumo-Session-Id, a provenance pointer without FK (as TestCaseRun.sourceSessionId).
  sessionId           String?
  submittedByMemberId String?
  submittedVia        FeedbackSource
  /// Suspected credentials redacted before saving (text fields + text evidence).
  secretsRedacted     Int            @default(0)
  status              FeedbackStatus @default(NEW)
  statusChangedAt     DateTime?
  /// Staff WorkspaceMember id (another workspace) — no FK on purpose.
  statusChangedById   String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  submittedBy WorkspaceMember? @relation("FeedbackSubmitter", fields: [submittedByMemberId], references: [id], onDelete: SetNull)
  replies     FeedbackReply[]

  @@unique([workspaceId, number])
  @@index([workspaceId, createdAt])
  @@index([submittedByMemberId, createdAt])
  @@index([status, createdAt])
  @@map("feedback")
}

/// Lumo team replies to a Feedback. Append-only: never updated or deleted.
model FeedbackReply {
  id             String   @id @default(cuid())
  feedbackId     String
  /// Stored credential-redacted.
  body           String
  /// Staff WorkspaceMember id (another workspace) — no FK on purpose.
  /// Customers see the author as "Lumo team".
  authorMemberId String
  createdAt      DateTime @default(now())

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId, createdAt])
  @@map("feedback_replies")
}
