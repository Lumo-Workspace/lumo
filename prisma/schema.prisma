// Lumo — Sprint 1 Schema
// Workspace-centric data model. Clerk owns user identity; clerkId is the FK.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum WorkspaceRole {
  OWNER
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ViewType {
  DOCUMENT
  KANBAN
}

enum ViewVisibility {
  PRIVATE // only the creator (memberId owner)
  WORKSPACE // all workspace members
  SHARED // only members listed in ViewMember
}

enum SprintStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum MilestoneStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum DocVisibility {
  PRIVATE
  SHARED
  WORKSPACE
}

enum DocShareRole {
  VIEWER
  EDITOR
  MANAGER
}

enum DocMentionSource {
  CONTENT  // derived from a mention node in document content
  EXPLICIT // created via CLI or explicit API; survives content re-sync
}

enum NotificationType {
  TASK_IN_REVIEW // task moved to IN_REVIEW — sent to workspace owners
  TASK_MENTIONED // someone @mentioned you in a comment
  TASK_SENT_BACK // owner sent a task back to IN_PROGRESS — sent to assignee
  TASK_ASSIGNED // task assigned to you
  TASK_SPEC_READY // agent generated a spec draft — sent to workspace owners
  TASK_DONE // task marked as done — sent to assignee
  AGENT_CLARIFY // agent needs clarification — requires reply to continue
  AGENT_AUTHORIZE // agent needs authorization for a high-risk operation
  AGENT_VERIFY // agent finished, requests human verification before DONE
  AGENT_FAILED // agent execution failed — informational
  AGENT_DONE // agent finished, PR created — informational
  SPRINT_STARTED
  SPRINT_CLOSED
}

enum CommentType {
  USER
  AGENT
}

enum AgentStatus {
  SUBMITTED      @map("IDLE")
  WORKING        @map("RUNNING")
  INPUT_REQUIRED @map("PAUSED")
  COMPLETED      @map("DONE")
  FAILED
  CANCELED       @map("CANCELLED")
}

enum ActorType {
  HUMAN
  AGENT
  GITHUB_USER
}

enum TaskActivityType {
  TASK_CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNEE_CHANGED
  TITLE_CHANGED
  DESCRIPTION_CHANGED
  DUE_DATE_CHANGED
  PARENT_CHANGED
  TAGS_CHANGED
  REPOSITORY_CHANGED
  COMMENT_ADDED
  COMMENT_DELETED
  SUBTASK_ADDED
  SUBTASK_REMOVED
  SPEC_GENERATED
  BRANCH_CREATED
  PR_LINKED
  PR_UNLINKED
  PR_CREATED
  PR_MERGED
  AGENT_RUN_STARTED
  AGENT_RUN_COMPLETED
  AGENT_RUN_FAILED
  AGENT_INPUT_REQUIRED
  SENTRY_ALERT
  SPRINT_CHANGED
}

enum AgentType {
  CODING
  REVIEW
  PLANNER
}

enum SummaryFrequency {
  DAILY
  EVERY_TWO_DAYS
  WEEKLY
}

// ─── Workspace ──────────────────────────────────────────────────────────────

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String
  logoUrl     String?
  // Monotonic per-workspace counter used to allocate Document.number on create.
  // Mirrors Team.taskSeq. Atomic increment inside the create transaction
  // serialises concurrent inserts without contention on a SELECT MAX query.
  documentSeq Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members            WorkspaceMember[]
  teams              Team[]
  projects           Project[]
  views              View[]
  invites            WorkspaceInvite[]
  githubIntegrations GitHubIntegration[]
  pullRequests       PullRequest[]
  slackIntegration   SlackIntegration?
  sentryIntegration  SentryIntegration?
  actors             Actor[]
  agentProfiles      AgentProfile[]
  documents          Document[]
  drafts             Draft[]
  summaries          WorkspaceSummary[]
  tags               Tag[]
  mcpConnections     McpConnection[]     @relation("WorkspaceMcpConnections")
  hookEvents         HookEvent[]
  sessions           Session[]
  memories           Memory[]
  taskSlackContexts  TaskSlackContext[]
  taskWebLinks       TaskWebLink[]
  prCommentSyncJobs  PrCommentSyncJob[]
  figmaIntegrations  FigmaIntegration[]
  taskFigmaLinks     TaskFigmaLink[]
  taskArtifacts      TaskArtifact[]

  summaryFrequency SummaryFrequency @default(DAILY)
  summaryEnabled   Boolean          @default(true)
  summaryLocale    String           @default("en")

  riskOverdueRatio    Float @default(0.25)
  riskStalledDays     Int   @default(7)
  riskStalledMinCount Int   @default(3)
  riskAgentFailRatio  Float @default(0.30)
  riskStalePrDays     Int   @default(3)
  riskThroughputDrop  Float @default(0.50)

  @@map("workspaces")
}

// ─── Team ───────────────────────────────────────────────────────────────────

model Team {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  identifier  String // task ID prefix e.g. "ENG"
  isDefault   Boolean  @default(false)
  taskSeq     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sprintsEnabled Boolean @default(false)

  // Sprint cadence config — applied when auto-creating future sprints.
  // startWeekday: 0=Sun … 6=Sat (ISO Monday = 1).
  // Cooldown is the number of full days between the last day of one sprint
  // and the first day of the next (0 = back-to-back, i.e. next sprint
  // starts the day after the previous one ends).
  sprintDurationDays Int @default(14)
  sprintCooldownDays Int @default(0)
  sprintStartWeekday Int @default(1)
  sprintAutoCreate   Int @default(0)

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects  Project[]
  members   TeamMember[]
  tasks     Task[]
  sprints   Sprint[]

  @@unique([workspaceId, identifier])
  @@index([workspaceId])
  @@map("teams")
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  memberId String
  joinedAt DateTime @default(now())

  team   Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  member WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([teamId, memberId])
  @@index([memberId])
  @@map("team_members")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  clerkId     String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  workspace            Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  teams                TeamMember[]
  createdProjects      Project[]           @relation("ProjectCreator")
  ownsProjects         Project[]           @relation("ProjectOwner")
  ownedViews           View[]              @relation("ViewOwner")
  createdViews         View[]              @relation("ViewCreator")
  sharedViews          ViewMember[]
  sentInvites          WorkspaceInvite[]
  githubIntegrations   GitHubIntegration[]
  slackInstalled       SlackIntegration[]  @relation("SlackInstaller")
  sentryInstalled      SentryIntegration[] @relation("SentryInstaller")
  actor                Actor?
  agentProfiles        AgentProfile[]
  apiKeys              ApiKey[]
  hookEvents           HookEvent[]
  sessions             Session[]
  preference           UserPreference?
  createdDocuments     Document[]          @relation("DocumentCreator")
  documentShares       DocumentShare[]     @relation("DocumentShareMember")
  documentEdits        DocumentEditor[]
  createdSlackContexts TaskSlackContext[]  @relation("TaskSlackContextCreator")
  createdWebLinks      TaskWebLink[]       @relation("TaskWebLinkCreator")
  figmaIntegrations    FigmaIntegration[]
  taskFigmaLinks       TaskFigmaLink[]     @relation("TaskFigmaLinkCreator")

  @@unique([workspaceId, clerkId])
  @@index([clerkId])
  @@map("workspace_members")
}

// ─── Agent Profiles ─────────────────────────────────────────────────────────

model AgentProfile {
  id          String    @id @default(cuid())
  workspaceId String
  memberId    String? // null = workspace-shared agent; set = personal agent (Phase 4)
  name        String // "Coding Agent"
  type        AgentType
  avatarColor String    @default("#6366f1")
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member    WorkspaceMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  actor     Actor?

  @@unique([workspaceId, type, memberId])
  @@map("agent_profiles")
}

model Actor {
  id                String    @id @default(cuid())
  workspaceId       String
  type              ActorType
  memberId          String?   @unique
  agentId           String?   @unique
  externalIdentity  String?   // "github:<login>" for GITHUB_USER; null otherwise
  externalAvatarUrl String?

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member    WorkspaceMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  agent     AgentProfile?    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  assignedTasks          Task[]         @relation("TaskAssignee")
  comments               Comment[]      @relation("CommentAuthor")
  activities             TaskActivity[]
  receivedNotifications  Notification[] @relation("NotificationRecipient")
  triggeredNotifications Notification[] @relation("NotificationTrigger")

  @@unique([workspaceId, externalIdentity])
  @@index([workspaceId])
  @@map("actors")
}

// ─── Project ────────────────────────────────────────────────────────────────

model Project {
  id                String   @id @default(cuid())
  workspaceId       String
  teamId            String
  createdByMemberId String
  ownerId           String?
  name              String
  description       String?
  isIdea            Boolean  @default(false)
  order             Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  riskOverdueRatio    Float?
  riskStalledDays     Int?
  riskStalledMinCount Int?
  riskAgentFailRatio  Float?
  riskStalePrDays     Int?
  riskThroughputDrop  Float?

  workspace             Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team                  Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy             WorkspaceMember        @relation("ProjectCreator", fields: [createdByMemberId], references: [id])
  owner                 WorkspaceMember?       @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks                 Task[]
  milestones            Milestone[]
  views                 View[]
  slackChannels         SlackChannel[]
  repositories          ProjectRepository[]
  sentryProjectMappings SentryProjectMapping[]
  documents             Document[]
  priorityOverrides     PriorityOverride[]
  summaries             ProjectSummary[]
  memories              Memory[]

  @@index([workspaceId])
  @@index([teamId])
  @@index([createdByMemberId])
  @@index([workspaceId, order])
  @@map("projects")
}

model ProjectRepository {
  id        String   @id @default(cuid())
  projectId String
  fullName  String // "owner/repo"
  name      String // short repo name
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@unique([projectId, fullName])
  @@index([projectId])
  @@map("project_repositories")
}

// ─── Task (self-referencing tree) ───────────────────────────────────────────

model Task {
  id              String       @id @default(cuid())
  projectId       String
  teamId          String
  number          Int
  parentTaskId    String?
  assigneeActorId String?
  repositoryId    String? // optional link to ProjectRepository
  sprintId        String?
  milestoneId     String?
  title           String
  description     String?
  spec            String?
  status          TaskStatus   @default(TODO)
  priority        TaskPriority @default(MEDIUM)
  order           Float        @default(0)
  agentStatus     AgentStatus?
  agentError      String?
  inputReason     String? // Why INPUT_REQUIRED: "spec_review" | "clarify" | etc.
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  dueDate         DateTime?

  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team       Team               @relation(fields: [teamId], references: [id])
  repository ProjectRepository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  sprint     Sprint?            @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  milestone  Milestone?         @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  parent     Task?              @relation("TaskChildren", fields: [parentTaskId], references: [id], onDelete: SetNull)
  children   Task[]             @relation("TaskChildren")
  assignee   Actor?             @relation("TaskAssignee", fields: [assigneeActorId], references: [id], onDelete: SetNull)

  viewTaskOrders    ViewTaskOrder[]
  comments          Comment[]
  pullRequests      PullRequest[]
  branches          TaskBranch[]
  clarifies         AgentClarify[]
  agentRuns         AgentRun[]
  sessions          Session[]
  activities        TaskActivity[]
  documentMentions  DocumentMention[]
  priorityOverrides PriorityOverride[]
  taskTags          TaskTag[]
  sentryIssueLinks  SentryIssueLink[]
  memories          Memory[]
  slackContexts     TaskSlackContext[]
  webLinks          TaskWebLink[]
  figmaLinks        TaskFigmaLink[]
  artifacts         TaskArtifact[]

  @@unique([teamId, number])
  @@index([projectId])
  @@index([projectId, status])
  @@index([teamId])
  @@index([teamId, status])
  @@index([parentTaskId])
  @@index([assigneeActorId])
  @@index([repositoryId])
  @@index([sprintId])
  @@index([milestoneId])
  @@map("tasks")
}

// ─── Sprint & SprintSummary ───────────────────────────────────────────────

model Sprint {
  id        String       @id @default(cuid())
  teamId    String
  number    Int
  name      String
  status    SprintStatus @default(DRAFT)
  startDate DateTime
  endDate   DateTime
  startedAt DateTime?
  closedAt  DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  team    Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tasks   Task[]
  summary SprintSummary?

  @@unique([teamId, number])
  @@index([teamId, status])
  @@map("sprints")
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  name        String
  slug        String
  description String?
  status      MilestoneStatus @default(PLANNED)
  startDate   DateTime?
  targetDate  DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@unique([projectId, slug])
  @@index([projectId])
  @@index([projectId, status])
  @@map("milestones")
}

model SprintSummary {
  id          String   @id @default(cuid())
  sprintId    String   @unique
  stats       Json
  tldr        String
  report      String
  generatedAt DateTime @default(now())

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@map("sprint_summaries")
}

// ─── View system (Document / Kanban / future) ───────────────────────────────

model View {
  id          String   @id @default(cuid())
  workspaceId String // security boundary — always required
  projectId   String? // set for project-level views
  memberId    String? // set for personal views (My Tasks); null = workspace-shared view
  name        String
  type        ViewType
  config      Json     @default("{}")
  // config shape: { filters?: { projectIds?: string[], statuses?: string[], assigneeIds?: string[] } }
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  visibility        ViewVisibility @default(WORKSPACE)
  createdByMemberId String?

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project    Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member     WorkspaceMember? @relation("ViewOwner", fields: [memberId], references: [id], onDelete: Cascade)
  createdBy  WorkspaceMember? @relation("ViewCreator", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  taskOrders ViewTaskOrder[]
  sharedWith ViewMember[]

  @@index([workspaceId])
  @@index([projectId])
  @@index([memberId])
  @@map("views")
}

enum ViewMemberRole {
  VIEWER
  EDITOR
}

model ViewMember {
  id       String         @id @default(cuid())
  viewId   String
  memberId String
  role     ViewMemberRole @default(VIEWER)
  addedAt  DateTime       @default(now())

  view   View            @relation(fields: [viewId], references: [id], onDelete: Cascade)
  member WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([viewId, memberId])
  @@map("view_members")
}

model ViewTaskOrder {
  id       String @id @default(cuid())
  viewId   String
  taskId   String
  groupKey String
  order    Float

  view View @relation(fields: [viewId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([viewId, taskId])
  @@index([viewId, groupKey, order])
  @@map("view_task_orders")
}

// ─── Comments ────────────────────────────────────────────────────────────────

model Comment {
  id              String      @id @default(cuid())
  taskId          String
  authorActorId   String?
  body            String // HTML; @mentions encoded as data-id attributes
  parentId        String? // null = top-level; non-null = reply (max 1 level deep)
  quotedCommentId String? // which specific comment this reply is quoting
  type            CommentType @default(USER)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  task     Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author   Actor?             @relation("CommentAuthor", fields: [authorActorId], references: [id], onDelete: SetNull)
  parent   Comment?           @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[]          @relation("CommentReplies")
  mirror   PrCommentMirror?
  syncJobs PrCommentSyncJob[]

  @@index([taskId])
  @@index([parentId])
  @@index([authorActorId])
  @@map("comments")
}

model TaskActivity {
  id        String           @id @default(cuid())
  taskId    String
  actorId   String?
  type      TaskActivityType
  payload   Json?
  createdAt DateTime         @default(now())

  task  Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor Actor? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([taskId])
  @@map("task_activities")
}

// ─── Notifications ───────────────────────────────────────────────────────────

model Notification {
  id               String           @id @default(cuid())
  workspaceId      String
  recipientActorId String // Actor.id — who receives this notification
  type             NotificationType
  taskId           String?
  commentId        String? // set for TASK_MENTIONED — scroll to comment
  clarifyId        String? // set for AGENT_CLARIFY — link to AgentClarify
  sprintId         String?
  triggerActorId   String? // Actor.id — who/what triggered it; null for system
  read             Boolean          @default(false)
  requiresAction   Boolean          @default(false) // AGENT_CLARIFY / AGENT_AUTHORIZE / AGENT_VERIFY
  actionTakenAt    DateTime? // when the user responded to an actionable notification
  createdAt        DateTime         @default(now())

  recipient Actor  @relation("NotificationRecipient", fields: [recipientActorId], references: [id], onDelete: Cascade)
  trigger   Actor? @relation("NotificationTrigger", fields: [triggerActorId], references: [id], onDelete: SetNull)

  @@index([recipientActorId, read])
  @@index([recipientActorId, requiresAction, actionTakenAt]) // pending action queries
  @@map("notifications")
}

model GitHubIntegration {
  id            String   @id @default(cuid())
  workspaceId   String
  memberId      String
  accessToken   String // AES-256-GCM encrypted: "iv:authTag:ciphertext" (hex)
  tokenType     String   @default("oauth")
  githubUserId  String
  githubLogin   String
  repositories  String[]
  webhookSecret String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member       WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  webhooks     GitHubWebhook[]
  pullRequests PullRequest[]

  @@unique([workspaceId, memberId])
  @@index([workspaceId])
  @@map("github_integrations")
}

model GitHubWebhook {
  id            String @id @default(cuid())
  integrationId String
  repo          String // "owner/repo"
  githubHookId  Int // GitHub's webhook ID, needed for deletion

  createdAt DateTime @default(now())

  integration GitHubIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, repo])
  @@index([repo])
  @@map("github_webhooks")
}

model SlackIntegration {
  id            String           @id @default(cuid())
  workspaceId   String           @unique
  installedBy   String?
  installer     WorkspaceMember? @relation("SlackInstaller", fields: [installedBy], references: [id], onDelete: SetNull)
  accessToken   String
  slackTeamId   String
  slackTeamName String
  slackUserId   String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channels  SlackChannel[]

  @@index([slackTeamId])
  @@map("slack_integrations")
}

model SlackChannel {
  id            String   @id @default(cuid())
  integrationId String
  channelId     String
  channelName   String
  events        String[]
  projectId     String?
  createdAt     DateTime @default(now())

  integration SlackIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([integrationId])
  @@index([projectId])
  @@map("slack_channels")
}

model PullRequest {
  id            String    @id @default(cuid())
  workspaceId   String
  taskId        String?
  integrationId String? // null for agent-created PRs (GitHub App, not OAuth)
  repo          String // "owner/repo"
  number        Int
  title         String
  url           String
  state         String // "open" | "closed" | "merged"
  authorLogin   String
  headBranch    String
  baseBranch    String
  isDraft       Boolean   @default(false)
  ciStatus      String? // null | "pending" | "success" | "failure"
  mergedAt      DateTime?
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace        Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task             Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  integration      GitHubIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  mirroredComments PrCommentMirror[]

  @@unique([repo, number])
  @@index([workspaceId])
  @@index([taskId])
  @@index([integrationId])
  @@map("pull_requests")
}

model TaskBranch {
  id                String    @id @default(cuid())
  taskId            String
  repo              String // "owner/repo"
  branchName        String
  lastCommitSha     String?
  lastCommitMessage String?
  lastCommitAuthor  String?
  lastPushedAt      DateTime?
  createdAt         DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, repo, branchName])
  @@index([taskId])
  @@map("task_branches")
}

model AgentRun {
  id           String      @id @default(cuid())
  taskId       String
  runNumber    Int
  status       AgentStatus // WORKING while active, terminal when done
  trigger      String? // "initial"|"retry"|"comment"|"confirm_spec"|"clarify_reply"|"send_back"
  errorCode    String?
  errorMessage String?
  sandboxId    String?
  mcpToken     String?     @unique // ephemeral token injected into sandbox; validated by mcp-clarify routes
  summary      String?
  steps        Json? // JSON array of { text, elapsedMs, status } persisted for resume after refresh
  changedFiles Json?
  durationMs   Int?
  prNumber     Int?
  prUrl        String?
  branchName   String?
  startedAt    DateTime    @default(now())
  finishedAt   DateTime?

  task      Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  clarifies AgentClarify[]

  @@unique([taskId, runNumber])
  @@index([taskId])
  @@map("agent_runs")
}

model AgentClarify {
  id         String    @id @default(cuid())
  taskId     String
  agentRunId String?
  question   String
  context    String?
  reply      String?
  repliedAt  DateTime?
  createdAt  DateTime  @default(now())

  task     Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agentRun AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([agentRunId])
  @@map("agent_clarifies")
}

model WorkspaceInvite {
  id          String       @id @default(cuid())
  token       String       @unique @default(cuid())
  workspaceId String
  email       String // always stored lowercase
  inviterName String // denormalized from Clerk at invite time
  invitedById String // WorkspaceMember.id
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime     @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy WorkspaceMember @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@map("workspace_invites")
}

// ─── API Keys (per-user, long-lived, for MCP servers) ───────────────────────

model ApiKey {
  id                String    @id @default(cuid())
  workspaceMemberId String
  label             String // user-given name, e.g. "My laptop"
  keyHash           String    @unique // SHA-256(fullKey) as hex
  keyPrefix         String // first 16 chars of key, for display ("lum_xxxxxxxx...")
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime?
  revokedAt         DateTime?

  member WorkspaceMember @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)

  @@index([workspaceMemberId])
  @@map("api_keys")
}

// ─── User Preferences ────────────────────────────────────────────────────────

model UserPreference {
  id       String          @id @default(cuid())
  memberId String          @unique
  member   WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // Appearance
  theme    String @default("system") // "light" | "dark" | "system"
  locale   String @default("en") // "en" | "zh"
  timezone String @default("auto") // IANA tz string or "auto"

  // In-app notification toggles
  notifyInAppAssigned   Boolean @default(true)
  notifyInAppComment    Boolean @default(true)
  notifyInAppAgentDone  Boolean @default(true)
  notifyInAppAgentInput Boolean @default(true)
  notifyInAppMention    Boolean @default(true)

  // Slack notification toggles
  notifySlackAssigned   Boolean @default(true)
  notifySlackComment    Boolean @default(true)
  notifySlackAgentDone  Boolean @default(true)
  notifySlackAgentInput Boolean @default(true)
  notifySlackMention    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}

// ─── Waitlist ───────────────────────────────────────────────────────────────

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  company   String?
  teamSize  String?
  createdAt DateTime @default(now())

  @@map("waitlist_entries")
}

// ─── Documents ──────────────────────────────────────────────────────────────

model Document {
  id      String  @id @default(cuid())
  title   String  @default("")
  content String? @db.Text
  emoji   String?

  // Per-workspace incrementing identifier. Combined with slugified title to
  // form the user-facing slug below.
  number Int
  slug   String

  parentId     String?
  parent       Document?        @relation("DocTree", fields: [parentId], references: [id])
  children     Document[]       @relation("DocTree")
  sortOrder    Float            @default(0)
  publicToken  String?          @unique
  tags         String[]         @default([]) // @deprecated — migrating to Tag relation
  editors      DocumentEditor[]
  documentTags DocumentTag[]

  projectId   String?
  project     Project?        @relation(fields: [projectId], references: [id])
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id])
  createdById String
  createdBy   WorkspaceMember @relation("DocumentCreator", fields: [createdById], references: [id])

  visibility DocVisibility     @default(PRIVATE)
  shares     DocumentShare[]
  mentions   DocumentMention[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, number])
  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([parentId])
  @@index([projectId])
  @@index([createdById])
}

model DocumentShare {
  id         String          @id @default(cuid())
  documentId String
  document   Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  memberId   String
  member     WorkspaceMember @relation("DocumentShareMember", fields: [memberId], references: [id])
  role       DocShareRole    @default(VIEWER)

  createdAt DateTime @default(now())

  @@unique([documentId, memberId])
}

model DocumentMention {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  source     DocMentionSource @default(CONTENT)

  createdAt DateTime @default(now())

  @@unique([documentId, taskId])
}

model DocumentEditor {
  id           String          @id @default(cuid())
  document     Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId   String
  member       WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId     String
  lastEditedAt DateTime        @default(now())

  @@unique([documentId, memberId])
}

// ─── Priority Overrides ──────────────────────────────────────────────────────

model PriorityOverride {
  id              String       @id @default(cuid())
  taskId          String
  task            Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  memberId        String
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  aiSuggested     TaskPriority
  userChosen      TaskPriority
  taskTitle       String
  taskDescription String?
  createdAt       DateTime     @default(now())

  @@index([memberId, projectId])
  @@map("priority_overrides")
}

// ─── Drafts ─────────────────────────────────────────────────────────────────

model Draft {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creatorId   String // actorId — drafts are private to creator
  type        String // "TASK" | "PROJECT"
  data        Json // serialized form field snapshot
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, creatorId])
  @@map("drafts")
}

