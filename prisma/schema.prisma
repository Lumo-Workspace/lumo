// ─── Hook Events (Claude Code runtime observability) ────────────────────────

enum HookEventType {
  PRE_TOOL_USE
  POST_TOOL_USE
  POST_TOOL_USE_FAILURE
  STOP
  STOP_FAILURE
  USER_PROMPT_SUBMIT
  PERMISSION_REQUEST
  PERMISSION_DENIED
  SESSION_START
  SESSION_END
  SUBAGENT_START
  SUBAGENT_STOP
  WORKTREE_CREATE
  WORKTREE_REMOVE
  FILE_CHANGED
  CONFIG_CHANGE
  TASK_CREATED
  TASK_COMPLETED
  POST_TOOL_BATCH
  USER_PROMPT_EXPANSION
  NOTIFICATION
  ELICITATION
  ELICITATION_RESULT
  CWD_CHANGED
  INSTRUCTIONS_LOADED
}

model HookEvent {
  id                String        @id @default(cuid())
  workspaceId       String
  workspaceMemberId String
  sessionId         String? // Claude Code session UUID, FK to Session.id
  taskId            String? // associated Lumo task
  type              HookEventType
  toolName          String? // extracted from payload.tool_name when present
  payload           Json // raw hook body from Claude Code
  // LLM-generated one-line summary of what Claude did in the turn that
  // just ended. Populated only on STOP / STOP_FAILURE rows, written
  // async by the turn-summary service. Null on every other event type
  // and on pre-feature historical rows; UI falls back to a first-
  // sentence excerpt of payload.last_assistant_message in that case.
  turnSummary       String?
  createdAt         DateTime      @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member    WorkspaceMember @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)
  session   Session?        @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceMemberId, createdAt])
  @@index([sessionId, createdAt])
  @@map("hook_events")
}

model Session {
  id                   String    @id // Claude Code session UUID — not cuid
  workspaceId          String
  workspaceMemberId    String
  taskId               String?
  cwd                  String?
  startedAt            DateTime  @default(now())
  lastActivityAt       DateTime
  eventCount           Int       @default(0)
  // Session summary — generated on demand via Claude. The generation flow is a
  // two-step pipeline: a cheap classifier picks a `summaryType`, then a content
  // model fills a type-specific template. `summary` holds the structured output
  // (shape depends on summaryType). `summaryEventCount` records how many events
  // were covered so callers can surface staleness as a delta against the current
  // event count; `summaryGeneratedAt` still lets callers compare against
  // lastActivityAt for a time-based staleness check.
  summary              Json?
  summaryType          String?
  summaryGeneratedAt   DateTime?
  summaryClassifyModel String?
  summaryContentModel  String?
  summaryEventCount    Int?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member    WorkspaceMember @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)
  task      Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  events    HookEvent[]
  memories  Memory[]

  @@index([workspaceId, lastActivityAt])
  @@index([workspaceMemberId, lastActivityAt])
  @@index([taskId, lastActivityAt])
  @@map("sessions")
}

// ─── Memory (long-term context across tasks) ────────────────────────────────

enum MemoryCategory {
  TRAP // 踩过的坑
  DECISION // 工程决策
  CONVENTION // 项目约定
  PROCEDURAL // 工作流程
}

enum MemoryScope {
  TASK
  PROJECT
}

model Memory {
  id              String         @id @default(cuid())
  workspaceId     String
  projectId       String
  taskId          String?
  scope           MemoryScope
  category        MemoryCategory
  content         Json
  sourceSessionId String?
  createdAt       DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  session   Session?  @relation(fields: [sourceSessionId], references: [id], onDelete: SetNull)

  @@index([projectId, scope])
  @@index([taskId])
  @@map("memories")
}

// ─── Task Slack Context ──────────────────────────────────────────────────────

model TaskSlackContext {
  id          String @id @default(cuid())
  taskId      String
  workspaceId String

  permalink        String
  slackTeamId      String
  slackChannelId   String
  slackChannelName String?
  rootTs           String
  threadTs         String?
  isThread         Boolean

  snapshot     Json
  snapshotAt   DateTime
  refreshError String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task      Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy WorkspaceMember @relation("TaskSlackContextCreator", fields: [createdById], references: [id])

  @@index([taskId])
  @@index([workspaceId])
  @@map("task_slack_contexts")
}

model TaskWebLink {
  id          String @id @default(cuid())
  taskId      String
  workspaceId String

  url         String
  domain      String
  title       String?
  description String?
  note        String?
  imageUrl    String?
  faviconUrl  String?
  fetchedAt   DateTime?
  fetchError  String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task      Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy WorkspaceMember @relation("TaskWebLinkCreator", fields: [createdById], references: [id])

  @@index([taskId, createdAt])
  @@index([workspaceId])
  @@map("task_web_links")
}

model TaskArtifact {
  id          String @id @default(cuid())
  taskId      String
  workspaceId String

  kind    String // "spec" | "plan" | "design" … opaque, declared by writer
  title   String
  content String  @db.Text
  source  String // "superpowers" | "claude-code" | "manual"
  order   Int     @default(0)

  createdById String? // WorkspaceMember.id; nullable, intentionally no FK relation
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([taskId, order])
  @@index([workspaceId])
  @@map("task_artifacts")
}

// ─── PR Comment Mirror ───────────────────────────────────────────────────────

enum PrCommentSource {
  ISSUE
  REVIEW
  REVIEW_LINE
}

enum DiffSide {
  LEFT
  RIGHT
}

enum OutboundActorKind {
  USER_OAUTH
  BOT_APP
}

enum SyncDirection {
  OUTBOUND
  INBOUND
}

enum SyncJobStatus {
  PENDING
  DEAD_LETTER
}

model PrCommentMirror {
  id                  String          @id @default(cuid())
  commentId           String          @unique
  pullRequestId       String

  externalSource      PrCommentSource
  externalId          String
  externalNodeId      String?
  externalUrl         String
  externalUpdatedAt   DateTime
  lastSyncedAt        DateTime
  deletedAt           DateTime?

  filePath            String?
  lineStart           Int?
  lineEnd             Int?
  diffSide            DiffSide?
  inReplyToExternalId String?

  outboundActor       OutboundActorKind
  outboundActorUserId String?

  bodyHash            String?

  comment     Comment     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@unique([externalSource, externalId])
  @@index([pullRequestId])
  @@index([pullRequestId, bodyHash, lastSyncedAt])
  @@map("pr_comment_mirrors")
}

model PrCommentSyncJob {
  id           String        @id @default(cuid())
  direction    SyncDirection
  payload      Json
  commentId    String?
  externalId   String?
  attempts     Int           @default(0)
  lastError    String?
  status       SyncJobStatus @default(PENDING)
  scheduledFor DateTime      @default(now())
  workspaceId  String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  comment   Comment?   @relation(fields: [commentId], references: [id], onDelete: SetNull)
  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([workspaceId])
  @@index([commentId])
  @@map("pr_comment_sync_jobs")
}

// ─── Figma Integration ───────────────────────────────────────────────────────

model FigmaIntegration {
  id            String   @id @default(cuid())
  workspaceId   String
  memberId      String
  accessToken   String   // AES-256-GCM encrypted via lib/crypto.ts
  refreshToken  String   // same encryption
  expiresAt     DateTime
  figmaUserId   String
  figmaHandle   String
  figmaEmail    String?
  scopes        String[]
  needsReauth   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member     WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  figmaLinks TaskFigmaLink[]

  @@unique([workspaceId, memberId])
  @@index([workspaceId])
  @@map("figma_integrations")
}

model TaskFigmaLink {
  id            String  @id @default(cuid())
  taskId        String
  workspaceId   String
  createdById   String
  integrationId String?

  url                String
  fileKey            String
  nodeId             String   // "" = file-level (sentinel, see spec §2)
  fileName           String
  frameName          String?
  thumbnailUrl       String?
  thumbnailFetchedAt DateTime?
  lastSyncedAt       DateTime @default(now())
  lastSyncError      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task        Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   WorkspaceMember   @relation("TaskFigmaLinkCreator", fields: [createdById], references: [id], onDelete: Restrict)
  integration FigmaIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@unique([taskId, fileKey, nodeId])
  @@index([taskId])
  @@index([workspaceId])
  @@map("task_figma_links")
}
