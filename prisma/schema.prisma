// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PROD_DATABASE_URL")
  directUrl = env("PROD_DATABASE_URL_UNPOOLED")
}

// Enum for onboarding: team size options
enum TeamSize {
  ONE                // 1 (Just me)
  TWO_TO_FIVE        // 2–5
  SIX_TO_TWENTY      // 6–20
  TWENTY_ONE_TO_FIFTY // 21–50
  FIFTY_ONE_TO_TWO_HUNDRED // 51–200
  TWO_HUNDRED_PLUS   // 200+
}

// Enum for team member roles
enum TeamRole {
  owner
  admin
  member
  guest
}

// NextAuth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String  @unique
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text  // Encrypted with AES-256-GCM
  access_token      String? @db.Text  // Encrypted with AES-256-GCM
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  
  lastUsedAt        DateTime @default(now()) @updatedAt  // Track token usage for SR-009

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([lastUsedAt])  // For cleanup queries
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])  // For cleanup queries
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

// Custom models for Google OAuth Login feature
model User {
  id            String    @id @default(cuid())
  name          String?   // Display name (editable by user)
  email         String?   @unique
  emailVerified DateTime?  // Email verification timestamp from Google
  image         String?   // Profile picture URL from Google
  
  // New fields for account management
  displayName   String?   // User's preferred display name
  avatarUrl     String?   // URL to uploaded avatar image
  avatarBlobId  String?   // Vercel Blob ID for avatar storage
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Authentication relationships (enforce 1:1 Account:User)
  accounts Account?
  sessions Session[]

  // User data relationships
  profile UserProfile?
  
  // Team relationships
  teamMemberships TeamMember[]

  // Document relationships
  authoredDocuments Document[]        @relation("UserToDocuments")
  authoredUpdatedDocuments Document[] @relation("UserToUpdatedDocuments")

  @@index([email])  // For account matching queries
  @@index([displayName]) // For team member list queries
  @@map("users")
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Avatar metadata
  avatarMetadata Json? // { originalSize, processedSize, format, dimensions }
  
  // Profile preferences
  preferences Json? // { theme, notifications, etc. }
  settings     Json? // { privacy, visibility, etc. }
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_profiles")
}

// Team and Workspace models for onboarding
model Team {
  id            String   @id @default(cuid())
  name          String
  workspaceUrl  String  @unique // e.g., "hello-world" for uselumo.ai/hello-world
  domain        String? @unique // e.g., "acme.com" for auto-join
  allowAutoJoin Boolean @default(true) // Allow auto-join for same domain emails
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relationships
  members     TeamMember[]
  workspace   Workspace?
  
  @@index([workspaceUrl])
  @@index([domain])
  @@map("teams")
}

model TeamMember {
  id        String    @id @default(cuid())
  userId    String
  teamId    String
  role      TeamRole  @default(member)
  joinedAt  DateTime  @default(now())
  
  // Relationships
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  
  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
  @@map("team_members")
}

model Workspace {
  id        String   @id @default(cuid())
  teamId    String   @unique
  settings  Json?    // Workspace-specific settings
  teamSize  TeamSize?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relationships
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  
  // Documents relationship
  documents Document[]
  
  @@map("workspaces")
}

enum DocumentStatus {
  draft
  published
  archived
}

model Document {
  id                 String            @id @default(cuid())
  workspaceId        String
  title              String
  slug               String
  path               String
  status             DocumentStatus    @default(draft)
  content            Json
  authorId           String
  updatedById        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?

  // Relations
  workspace          Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author             User              @relation(fields: [authorId], references: [id], name: "UserToDocuments")
  updatedBy          User?             @relation(fields: [updatedById], references: [id], name: "UserToUpdatedDocuments")

  @@unique([workspaceId, path])
  @@index([workspaceId])
  @@map("documents")
}
