// ─── Context Lineage (LUM-275) ────────────────────────────────────────────────
// One edge = "this context fragment was injected into this task's context during
// this run/session, and here's what came of it (outcome)". The edge — not the
// fragment — is the system-of-record asset for the Context Lineage milestone.

enum LineageFragmentType {
  MEMORY
  SLACK_CONTEXT
  WEB_LINK
  FIGMA
  PR
  PR_REVIEW_TODO
  SESSION
}

enum LineageOutcome {
  MERGED
  REJECTED
  REWORKED
  UNKNOWN
}

enum LineageDisclosure {
  FULL
  INDEX
}

model LineageEdge {
  id              String              @id @default(cuid())
  workspaceId     String
  taskId          String
  // Polymorphic reference to the source fragment. No FK relation: fragmentId
  // points at a different table per fragmentType, and source rows can be
  // consolidated / edited / deleted independently (deletion propagation is
  // tracked as known debt for the milestone). Stable-ID work lives in LUM-274/280.
  fragmentType    LineageFragmentType
  fragmentId      String
  sessionId       String?
  includedAt      DateTime            @default(now())
  // Starts UNKNOWN at birth; stamped MERGED/REJECTED/REWORKED when the edge
  // closes (PR merged / task done) — see DoD ③ in the milestone goal.
  outcome         LineageOutcome      @default(UNKNOWN)
  // LUM-397 outcome strength (ProdCodeBench: merged ≠ ground truth). Only
  // meaningful alongside MERGED: true = the task had an all-PASS verification
  // round (MERGED_VERIFIED), false = task closed without one (weak MERGED),
  // null = not yet stratified (pre-LUM-397 stamps / non-MERGED outcomes).
  // Monotonic: null/false may upgrade to true, never the reverse. Data-only —
  // no scoring path reads this column until sample size justifies weighting.
  outcomeVerified Boolean?
  // LUM-300 usage vote: null = not voted, true = agent reported using this
  // fragment, false = injected but unused. usedAt also marks "has this session
  // voted?" (avoids a separate Session watermark column).
  used            Boolean?
  usedAt          DateTime?
  // 渐进式披露漏斗：FULL = Tier1 全文注入；INDEX = Tier2 仅索引行。
  disclosure      LineageDisclosure   @default(FULL)
  // agent 经 `lumo … show <id>` 主动拉取该 fragment 正文的时刻（漏斗中间环）。
  pulledAt        DateTime?
  // LUM-522 token-level funnel: per-fragment injection cost. indexTokens =
  // the INDEX/manifest line actually injected; fullTokens = the FULL rendered
  // body this INDEX impression avoided. Savings = Σ(fullTokens − indexTokens)
  // over un-pulled INDEX edges, computed read-time (nulls skipped, never 0).
  // Nullable + additive: historical edges and non-tagging aggregate callers
  // are unaffected (mirrors disclosure/pulledAt).
  indexTokens     Int?
  fullTokens      Int?
  // LUM-522: relevance-gate similarity score at injection time (LUM-486).
  // Null when the fragment was not gate-scored (small-corpus bypass,
  // fallback-all, or a non-MEMORY fragment).
  relevanceScore  Float?
  updatedAt       DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  session   Session?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([sessionId, taskId, fragmentType, fragmentId])
  @@index([fragmentType, fragmentId])
  @@index([taskId])
  @@index([workspaceId])
  @@map("lineage_edges")
}

/// LUM-648: cross-milestone learning-migration edge. The task-flywheel's
/// LineageEdge requires a non-null taskId, but a milestone STEWARD session is
/// bound to a milestone, not a task — so it cannot carry a LineageEdge. This
/// dedicated table records the same used=true/false/null usage-vote substrate
/// for the one injection path a steward session has: a MILESTONE-scope memory
/// (distilled from an earlier milestone's close retro, LUM-647) injected into a
/// later milestone's steward session. Isolated from the task flywheel by design
/// (no reader assumes taskId/outcome here). One row per (steward session ×
/// injected memory); the usage vote is stamped by the audit at the CONSUMER
/// milestone's close, reusing judgeFragmentUsage.
model MilestoneMemoryEdge {
  id                  String    @id @default(cuid())
  workspaceId         String
  /// The injected MILESTONE-scope memory.
  memoryId            String
  /// The milestone whose close retro distilled the memory (= Memory.milestoneId
  /// at injection time). Nullable + SetNull so a deleted source milestone leaves
  /// the usage record intact (mirrors Memory.milestoneId).
  sourceMilestoneId   String?
  /// The later milestone whose steward session consumed the memory.
  consumerMilestoneId String
  /// The steward session the memory was injected into.
  sessionId           String
  injectedAt          DateTime  @default(now())
  /// Usage vote (mirrors LineageEdge.used): null = not yet audited / judge
  /// abstained, true = judge found concrete evidence of use, false = judged
  /// unused. usedAt also marks "has this session been audited?" (idempotency).
  used                Boolean?
  usedAt              DateTime?
  updatedAt           DateTime  @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memory    Memory     @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  source    Milestone? @relation("MilestoneMemoryEdgeSource", fields: [sourceMilestoneId], references: [id], onDelete: SetNull)
  consumer  Milestone  @relation("MilestoneMemoryEdgeConsumer", fields: [consumerMilestoneId], references: [id], onDelete: Cascade)
  session   Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, memoryId])
  @@index([consumerMilestoneId])
  @@index([memoryId])
  @@index([workspaceId])
  @@map("milestone_memory_edges")
}

/// LUM-522: a PROJECT-memory fragment the relevance gate (LUM-486) dropped
/// below its floor / past top-K — recorded id+score only (not a full edge),
/// so gate precision can be measured (did we drop something that later
/// mattered?). Side table keeps every LineageEdge an "injected impression".
model DroppedFragment {
  id             String              @id @default(cuid())
  workspaceId    String
  taskId         String
  sessionId      String?
  fragmentType   LineageFragmentType
  fragmentId     String
  relevanceScore Float?
  droppedAt      DateTime            @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  session   Session?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  // Idempotent collection: a bound session re-records the same dropped
  // fragments on every session-start. Mirrors LineageEdge's unique key
  // (LUM-530). Postgres treats NULL as distinct, so null-session rows are
  // never deduped by the index — same semantics as LineageEdge.
  @@unique([sessionId, taskId, fragmentType, fragmentId])
  @@index([taskId])
  @@index([sessionId])
  @@index([workspaceId])
  @@map("dropped_fragments")
}

/// LUM-598 事后结果井 (post-hoc outcome well). The single external oracle for
/// correctness + fidelity: the real-world fate of a delivery AFTER it ships —
/// facts the agent cannot construct, occurring post-delivery (a revert, a
/// reopen, a rollback, CI turning red, a downstream redirect of the design).
///
/// INVARIANT — falsifier, not verifier. Every row is a *rejection* signal:
/// reality revoked, redid, or bypassed the delivery. The well NEVER records a
/// "satisfied" signal. "N sprints, nobody touched it" is the ABSENCE of a
/// rejection (satisfied / tolerated / unnoticed are externally indistinguish-
/// able from outside) and reads INCONCLUSIVE — never PASS. The derived verdict
/// is therefore only REJECTED (≥1 signal) | INCONCLUSIVE (none); there is no
/// SATISFIED branch anywhere. Insert-only: signals are never updated or deleted.
model OutcomeSignal {
  id                 String              @id @default(cuid())
  workspaceId        String
  taskId             String
  kind               OutcomeSignalKind
  source             OutcomeSignalSource
  // occurredAt = when the real-world event happened (revert/reopen time), when
  // known; detectedAt = when the well recorded it. Both are post-delivery.
  occurredAt         DateTime?
  detectedAt         DateTime            @default(now())
  // Referent evidence the agent cannot fabricate: commit/PR/session pointers, a
  // revertsSha, or a human note for the MANUAL path. Free-form JSON, read-only.
  evidence           Json?
  // Audit pointers (no FK on session — it may be pruned independently).
  sessionId          String?
  recordedByMemberId String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([workspaceId])
  @@map("outcome_signals")
}

enum OutcomeSignalKind {
  REVERTED // delivery commit/PR reverted by a later change
  REOPENED // task reopened after MERGED (folds the existing REWORKED fact)
  ROLLED_BACK // deployment rolled back
  CI_REGRESSION // CI turned red after the delivery landed
  DOWNSTREAM_REDIRECT // a later change reversed this delivery's design choice
  BYPASSED // delivery bypassed / redone elsewhere
  MANUAL // human-recorded rejection (specifics in evidence)
}

enum OutcomeSignalSource {
  GIT // derived from commit/revert history
  CI // derived from CI status observed after delivery
  LINEAGE // derived from a lineage outcome transition (reopen → REWORKED)
  MANUAL // human-recorded via CLI
}

/// 交付时固化的 forecast 快照（LUM-319）。只存预测区间；actual 渲染时实算。
/// keep-first：taskId 唯一，reopen 重交付不覆盖，留住首次交付的真实预测。
model TaskForecastSnapshot {
  id                 String   @id @default(cuid())
  taskId             String   @unique
  iterations         Json? // { p25, median, p75 } | null
  interactionRounds  Json?
  tokenCost          Json?
  cohortSize         Int // 相似 cohort 大小（喂 iterations/interaction）
  tokenCostBasis     Int // 项目级样本数（喂 token）
  // LUM-606 verification-friction axis — frozen at delivery, cut at capturedAt.
  // Two SEPARATE raw scalars (never a merged friction score); null = no
  // verification record by capture (the no-verification bucket, distinct from 0).
  verificationRounds Int?
  sendBackCount      Int?
  capturedAt         DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_forecast_snapshots")
}

/// LUM-609 (fidelity premise A): append-only delivery-time freeze of the
/// acceptance contract. One row per delivery (IN_REVIEW entry) — deliberately
/// NOT @unique on taskId: a reopen→re-deliver appends another immutable row.
/// Never updated or deleted (the repository exposes no update/delete path), so a
/// fidelity comparison can replay the contract AS IT STOOD AT DELIVERY
/// (selectActiveAsOf: latest frozenAt ≤ T) rather than the since-edited `latest`
/// — the self-confirming trap this premise removes. The CRITERION_CHANGED
/// TaskActivity trail remains the immutable mutable-criteria audit backstop.
model TaskCriteriaSnapshot {
  id        String   @id @default(cuid())
  taskId    String
  // Full active criteria set frozen at delivery — replay-sufficient (per
  // criterion: id, statement, verifierType, checkpointer, referentKind,
  // evidenceRequired). JSON, never mutated.
  criteria  Json
  // Why the freeze fired (e.g. IN_REVIEW_ENTRY).
  trigger   String
  // The session that delivered, when known.
  sessionId String?
  frozenAt  DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([taskId, frozenAt])
  @@map("task_criteria_snapshots")
}

// ─── Acceptance v1: criteria contract + verification event log (LUM-341) ────
// Two-table foundation for the task-acceptance loop. The Task model carries
// NO derived columns: verification state / current round are always derived
// from VerificationRun (same zero-schema derived-state route as LUM-323).

enum AcceptanceVerifierType {
  MACHINE
  HUMAN
  // Agent-initiated send-back (LUM-422). FAIL-only — the agent input schema
  // cannot express PASS/PASS_WITH_FOLLOWUP (red line: no passing data row is
  // ever agent-produced). A separate channel from HUMAN so "machine all-pass
  // but human FAIL" stays an uncontaminated Slice-3 signal.
  AGENT
}

/// Provenance of a criterion — the key feedback-loop signal. AGENT_DRAFT =
/// initial contract drafted by the agent (round 0); HUMAN_EDIT = a human
/// revision (possibly transcribed by the agent from a conversation, with
/// attribution); REVIEW_ADDED = a gap found during review, appended in place
/// at the round it surfaced.
enum AcceptanceCriterionSource {
  AGENT_DRAFT
  HUMAN_EDIT
  REVIEW_ADDED
}

/// What a criterion anchors — the only dimension that determines independence
/// (LUM-602). Agent-declared, one of these three; UNVERIFIED_ASSERTION is a
/// falsifier-derived effective kind (shared/src/referent-kind.ts), never stored.
/// Mirrors REFERENT_KIND_DECLARABLE in shared/src/referent-kind.ts — keep in sync.
enum ReferentKind {
  EXTERNAL_FACT
  AGENT_CONSTRUCTED_STATE
  PENDING_OUTCOME
}

enum VerificationVerdict {
  PASS
  FAIL
  PASS_WITH_FOLLOWUP
}

/// First-pass rejection taxonomy (paired with free-text rejectionReason).
/// Extend additively as Slice 3 metrics reveal missing buckets.
enum VerificationRejectionReason {
  CRITERION_UNMET // the check ran and the criterion is not satisfied
  EVIDENCE_INSUFFICIENT // evidence missing or does not prove the statement
  CHECK_EXECUTION_ERROR // the checkpointer itself failed to run (env/infra)
  SCOPE_MISMATCH // the work does not address the criterion
  OTHER
}

model AcceptanceCriterion {
  id               String                    @id @default(cuid())
  taskId           String
  statement        String
  verifierType     AcceptanceVerifierType
  // Executable check pointer (test command, script, probe…). Free-form in v1.
  // Required for MACHINE at the validation layer — a criterion that can't
  // name its check is drafted as HUMAN instead.
  checkpointer     String?
  // Whether a verdict on this criterion must carry an evidencePointer.
  // Independently of this flag, a MACHINE PASS always requires evidence
  // (enforced at the validation layer).
  evidenceRequired Boolean                   @default(false)
  source           AcceptanceCriterionSource
  // Agent-drafted human-readable judging instructions for a HUMAN criterion
  // (LUM-465): where to look → what to do → ✓pass / ✗send-back. Light markdown,
  // may contain URLs. Rendered on the human adjudication card and in
  // `lumo task status`. null = no guidance drafted (legacy rows + MACHINE
  // criteria) → the card shows a "missing guidance" fallback hint, no backfill.
  judgeSteps       String?
  // Verification round at which the criterion was added; initial draft = 0.
  addedAtRound     Int                       @default(0)
  // What this criterion anchors (LUM-602). Nullable: rows predating the field
  // are UNCLASSIFIED (an honest "predates the discipline" bucket, never
  // backfilled). Required for NEW writes at the validation layer (forced fill).
  referentKind     ReferentKind?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  // Soft-delete tombstone (LUM-437). A criterion with VerificationRun rows is
  // soft-deleted, not hard-deleted, so the verdict→criterion audit chain
  // survives (the run FK is onDelete: Cascade). null = active.
  deletedAt        DateTime?

  task             Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  verificationRuns VerificationRun[]

  @@index([taskId])
  @@index([taskId, deletedAt])
  @@map("acceptance_criteria")
}

/// Append-only event log: one row per (criterion, round) verdict. Rows are
/// never updated — later rounds append new rows, and task-level state is
/// derived by reading the latest round. RED LINE: rows with verifierType =
/// HUMAN must only ever be written via human-initiated paths (web UI / Slack
/// action). Agent-facing input schemas hard-code MACHINE and cannot express
/// a HUMAN verdict (see lib/validation/acceptance.ts).
model VerificationRun {
  id                  String                       @id @default(cuid())
  taskId              String
  criterionId         String
  round               Int
  // Denormalized from the criterion at verdict time so the event log stays
  // faithful even if a HUMAN_EDIT later retypes the criterion.
  verifierType        AcceptanceVerifierType
  verdict             VerificationVerdict
  evidencePointer     String?
  rejectionReason     String?
  rejectionReasonEnum VerificationRejectionReason?
  /// Shared id stamped on every run written by ONE human-verdict action
  /// (one transaction → one id). Null on machine runs. Lets an action be
  /// withdrawn as a unit (LUM-586).
  verdictActionId     String?
  /// LUM-640: the Claude Code session that produced this run, when the caller
  /// carried an `X-Lumo-Session-Id` header — how a governance write (an AGENT
  /// send-back from a STEWARD session) stays attributable to its session.
  /// FK-less audit pointer (mirrors OutcomeSignal.sessionId): a pruned session
  /// must not erase the provenance trail. Null on web/human rows and legacy rows.
  sourceSessionId     String?
  createdAt           DateTime                     @default(now())

  task      Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  criterion AcceptanceCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@index([taskId, round])
  @@index([criterionId])
  @@map("verification_runs")
}

/// Append-only tombstone for a withdrawn human-verdict action (LUM-586). The
/// run rows survive; this marks the action withdrawn so the latest-verdict
/// derivation falls through to the prior row. One action withdrawn at most once.
model VerificationRunWithdrawal {
  id              String   @id @default(cuid())
  taskId          String
  verdictActionId String
  withdrawnById   String?
  note            String?
  createdAt       DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, verdictActionId])
  @@index([taskId])
}

// ─── TaskDependency (LUM-172 检测优于声明) ──────────────────────────────────
// Migration: 20260610015440_add_task_dependencies
// LUM-172: task dependency edges (检测优于声明) — initial schema.
// Purely additive: 3 enums + task_dependencies table + indexes + FKs.
// No data migration. Prod applies via `prisma migrate deploy` on next deploy.
// (Header placed here rather than in migration.sql because the migration is
// already recorded as applied in the DB — editing the SQL file would cause
// checksum drift; migrate resolve --applied returns P3008.)

enum DependencyKind {
  BLOCKS
  RELATES
}

enum DependencySource {
  MANUAL
  DETECTED
}

enum DependencyStatus {
  SUGGESTED
  CONFIRMED
  DISMISSED
}

model TaskDependency {
  id             String           @id @default(cuid())
  workspaceId    String
  // 方向:blockingTask 先 merge,blockedTask 等待。
  // kind=RELATES 时无方向语义,两列只是存储位;v1 检测器只产 BLOCKS。
  blockedTaskId  String
  blockingTaskId String
  kind           DependencyKind   @default(BLOCKS)
  source         DependencySource
  status         DependencyStatus @default(SUGGESTED)
  // 可解释红线:检测边必须说得清来源。'task_mention' | 'shared_files';
  // detail 放证据(mention 表面 / 共享文件数量+样本)。MANUAL 边为 null。
  reason         String?
  detail         Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  confirmedAt    DateTime?

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  blockedTask  Task      @relation("TaskBlockedBy", fields: [blockedTaskId], references: [id], onDelete: Cascade)
  blockingTask Task      @relation("TaskBlocking", fields: [blockingTaskId], references: [id], onDelete: Cascade)

  // 唯一约束不含 status:DISMISSED 边挡住同 pair 的重新 INSERT(检测器靠
  // skipDuplicates + 先查已有 pair 实现「dismiss 即免疫重建议」);要复活走 UPDATE。
  @@unique([blockedTaskId, blockingTaskId])
  @@index([workspaceId, status])
  @@index([blockingTaskId])
  @@map("task_dependencies")
}

// LUM-582: claim faithfulness verdict — an independent "测" for the "估" claim.
// Produced offline by scripts/audit-claim-faithfulness.ts (git diff vs claim,
// LLM judge); the read path consumes the persisted verdict (no LLM at read).
// `judgedClaimAt` records the claimSnapshot watermark judged, for staleness.
model ClaimFaithfulnessVerdict {
  id              String    @id @default(cuid())
  taskId          String    @unique
  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  verdict         String // FAITHFUL | UNDERREPORT | OVERSTATED | UNJUDGEABLE
  evidence        Json?
  reasoning       String?
  diffShas        String[]
  prNumbers       Int[]
  diffScope       Int       @default(0)
  prefilterSignal String?
  judgeModel      String
  judgedClaimAt   DateTime?
  judgedAt        DateTime  @default(now())

  @@index([verdict])
  @@map("claim_faithfulness_verdicts")
}
