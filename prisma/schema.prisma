// Lumo — Sprint 1 Schema
// Workspace-centric data model. Clerk owns user identity; clerkId is the FK.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum WorkspaceRole {
  OWNER
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ViewType {
  DOCUMENT
  KANBAN
}

enum ViewVisibility {
  PRIVATE    // only the creator (memberId owner)
  WORKSPACE  // all workspace members
  SHARED     // only members listed in ViewMember
}

// ─── Workspace ──────────────────────────────────────────────────────────────

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  WorkspaceMember[]
  teams    Team[]
  projects Project[]
  views    View[]

  @@map("workspaces")
}

// ─── Team ───────────────────────────────────────────────────────────────────

model Team {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  identifier  String   // task ID prefix e.g. "ENG"
  isDefault   Boolean  @default(false)
  taskSeq     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects  Project[]
  members   TeamMember[]
  tasks     Task[]

  @@unique([workspaceId, identifier])
  @@index([workspaceId])
  @@map("teams")
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  memberId String
  joinedAt DateTime @default(now())

  team   Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  member WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([teamId, memberId])
  @@index([memberId])
  @@map("team_members")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  clerkId     String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  teams           TeamMember[]
  createdProjects Project[]
  assignedTasks   Task[]
  ownedViews      View[]       @relation("ViewOwner")
  createdViews    View[]       @relation("ViewCreator")
  sharedViews     ViewMember[]

  @@unique([workspaceId, clerkId])
  @@index([clerkId])
  @@map("workspace_members")
}

// ─── Project ────────────────────────────────────────────────────────────────

model Project {
  id                String   @id @default(cuid())
  workspaceId       String
  teamId            String
  createdByMemberId String
  name              String
  description       String?
  isIdea            Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team       Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy  WorkspaceMember @relation(fields: [createdByMemberId], references: [id])
  tasks      Task[]
  views      View[]

  @@index([workspaceId])
  @@index([teamId])
  @@index([createdByMemberId])
  @@map("projects")
}

// ─── Task (self-referencing tree) ───────────────────────────────────────────

model Task {
  id             String       @id @default(cuid())
  projectId      String
  teamId         String
  number         Int
  parentTaskId   String?
  assigneeId     String?
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  order          Float        @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team     Team             @relation(fields: [teamId], references: [id])
  parent   Task?            @relation("TaskChildren", fields: [parentTaskId], references: [id], onDelete: SetNull)
  children Task[]           @relation("TaskChildren")
  assignee WorkspaceMember? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  viewTaskOrders ViewTaskOrder[]

  @@unique([teamId, number])
  @@index([projectId])
  @@index([teamId])
  @@index([parentTaskId])
  @@index([assigneeId])
  @@map("tasks")
}

// ─── View system (Document / Kanban / future) ───────────────────────────────

model View {
  id          String   @id @default(cuid())
  workspaceId String   // security boundary — always required
  projectId   String?  // set for project-level views
  memberId    String?  // set for personal views (My Tasks); null = workspace-shared view
  name        String
  type        ViewType
  config      Json     @default("{}")
  // config shape: { filters?: { projectIds?: string[], statuses?: string[], assigneeIds?: string[] } }
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  visibility        ViewVisibility   @default(WORKSPACE)
  createdByMemberId String?

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project    Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member     WorkspaceMember? @relation("ViewOwner", fields: [memberId], references: [id], onDelete: Cascade)
  createdBy  WorkspaceMember? @relation("ViewCreator", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  taskOrders ViewTaskOrder[]
  sharedWith ViewMember[]

  @@index([workspaceId])
  @@index([projectId])
  @@index([memberId])
  @@map("views")
}

enum ViewMemberRole {
  VIEWER
  EDITOR
}

model ViewMember {
  id       String         @id @default(cuid())
  viewId   String
  memberId String
  role     ViewMemberRole @default(VIEWER)
  addedAt  DateTime       @default(now())

  view   View            @relation(fields: [viewId], references: [id], onDelete: Cascade)
  member WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([viewId, memberId])
  @@map("view_members")
}

model ViewTaskOrder {
  id       String @id @default(cuid())
  viewId   String
  taskId   String
  groupKey String
  order    Float

  view View @relation(fields: [viewId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([viewId, taskId])
  @@index([viewId, groupKey, order])
  @@map("view_task_orders")
}
