model SentryIssueLink {
  id            String   @id @default(cuid())
  integrationId String
  sentryIssueId String
  taskId        String
  createdAt     DateTime @default(now())

  integration SentryIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  task        Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([integrationId, sentryIssueId])
  @@index([taskId])
  @@map("sentry_issue_links")
}

model McpConnection {
  id                String    @id @default(cuid())
  clerkUserId       String
  activeWorkspaceId String?
  clientName        String?
  clientId          String?
  autoBoundAt       DateTime?
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())
  revokedAt         DateTime?

  activeWorkspace Workspace? @relation("WorkspaceMcpConnections", fields: [activeWorkspaceId], references: [id], onDelete: SetNull)

  @@unique([clerkUserId, clientId])
