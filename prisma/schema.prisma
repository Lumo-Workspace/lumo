/**
 * LUM-426/435 forbidden-action boundary-crossing. A marker is mirrored onto a
 * TaskActivity for the timeline; this row holds the MUTABLE disposition state
 * the DONE gate reads (TaskActivity is append-only and cannot). A crossing is
 * "open" while disposition is null — open crossings block DONE unless the
 * workspace toggle is off or a human dispositions it (FALSE_POSITIVE or
 * CONFIRMED both clear the gate). dispositionedById is a plain Actor id (no FK
 * back-relation — the disposition TaskActivity carries the human's actor for
 * rendering). reversible is set by the detector taxonomy; remediationTaskId
 * optionally links a follow-up fix task whose live status surfaces on the bar.
 */
model BoundaryCrossing {
  id                String                       @id @default(cuid())
  taskId            String
  hookEventId       String?
  // The originating Claude Code session, when the crossing was recorded from a
  // path that has no hook event to attribute through (LUM-511 spinoff laundering
  // is detected on a `lumo task create` call, not an Edit/Bash hook). The LUM-469
  // attribution read model falls back to this session — owner/agent/worktree +
  // dominant model from its cumulative usageByModel — when hookEventId is null.
  // Null for hook-sourced crossings (they attribute via hookEventId) and legacy rows.
  sessionId         String?
  category          BoundaryCrossingCategory
  detail            String
  // Coalescing key (LUM-477): the specific target an OPEN crossing is deduped
  // on alongside (taskId, category) — the edited file for TEST_TAMPERING/secret,
  // the normalized command for action classes. Nullable: legacy rows have none
  // and simply never coalesce.
  target            String?
  // How many detections have coalesced into this OPEN crossing (LUM-477) — 1 for
  // a never-repeated crossing; a recurrence bumps it instead of inserting a row.
  occurrenceCount   Int                          @default(1)
  // When this crossing was last (re)detected (LUM-477) — null until it first
  // recurs; readers fall back to detectedAt.
  lastSeenAt        DateTime?
  detectedAt        DateTime                     @default(now())
  reversible        Boolean                      @default(false)
  severity          BoundaryCrossingSeverity     @default(MEDIUM)
  disposition       BoundaryCrossingDisposition?
  dispositionNote   String?
  dispositionedAt   DateTime?
  dispositionedById String?
  remediationTaskId String?
  // LUM-542: when the agent was first reminded (via the next hook's stdout) that
  // this crossing exists and can be explained. Set once, the first time a
  // reminder is emitted, so the reminder fires exactly once per crossing and a
  // later hook never re-nags. Null = not yet reminded; orthogonal to disposition
  // and the DONE gate (which key only on `disposition`).
  agentNotifiedAt   DateTime?
  advisory          Boolean  @default(false)    // LUM-590: semantic finding — surfaced, never blocks DONE
  policyRuleRef     String?                     // LUM-590: which compiled PolicyRule fired (text/id)

  task            Task                          @relation("CrossingTask", fields: [taskId], references: [id], onDelete: Cascade)
  remediationTask Task?                         @relation("CrossingRemediation", fields: [remediationTaskId], references: [id], onDelete: SetNull)
  // LUM-542: append-only agent self-explanations ("申辩"). A purely additive
  // annotation layer — never read by the DONE gate, never a disposition.
  explanations    BoundaryCrossingExplanation[]

  @@index([taskId, disposition])
  // Supports the LUM-477 open-crossing coalescing lookup (taskId, category, target).
  @@index([taskId, category, target])
  @@map("boundary_crossings")
}

/**
 * LUM-542: an append-only agent self-explanation ("申辩") attached to a
 * BoundaryCrossing. When a crossing is detected the agent gets one reminder and
 * may record why it took the action; the note is shown to the human reviewer at
 * disposition time and kept for later review, but is **never** a disposition and
 * never touches the DONE gate. Rows are insert-only — there is deliberately no
 * update or delete path (a correction is a new row, so prior wording survives).
 * `authorSessionId` / `authorAgent` carry attribution (the originating Claude
 * Code session and its agent type); both nullable for resilience. The note is
 * untrusted free text — every render boundary sanitizes it.
 */
model BoundaryCrossingExplanation {
  id              String   @id @default(cuid())
  crossingId      String
  note            String
  authorSessionId String?
  authorAgent     String?
  createdAt       DateTime @default(now())

  crossing BoundaryCrossing @relation(fields: [crossingId], references: [id], onDelete: Cascade)

  @@index([crossingId, createdAt])
  @@map("boundary_crossing_explanations")
}

