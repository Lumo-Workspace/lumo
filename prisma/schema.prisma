// Lumo — Sprint 1 Schema
// Workspace-centric data model. Clerk owns user identity; clerkId is the FK.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector, pg_trgm]
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum WorkspaceRole {
  OWNER
  MEMBER
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  // LUM-1282: terminal "we won't do this / duplicate". A human ruling only —
  // gated like DONE, with no agent one-step path. Excluded from completion
  // metrics; counts as closed for the milestone rollup.
  CANCELED
}

enum TaskPriority {
  // Not assessed yet: the default, so a real MEDIUM ruling is distinguishable
  // from a task nobody prioritised. Sorts after LOW (LUM-1284).
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

// LUM-663: coarse S/M/L sizing hint on materialised Tasks (nullable, best-effort).
enum SizeHint {
  S
  M
  L
}

enum ViewType {
  DOCUMENT
  KANBAN
}

enum ViewVisibility {
  PRIVATE // only the creator (memberId owner)
  WORKSPACE // all workspace members
  SHARED // only members listed in ViewMember
}

/// LUM-1285: human ruling on a project. No COMPLETED — completion is derived.
enum ProjectStatus {
  ACTIVE
  PAUSED
  CANCELED
}

enum SprintStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum DocVisibility {
  PRIVATE
  SHARED
  WORKSPACE
}

enum DocShareRole {
  VIEWER
  EDITOR
  MANAGER
}

enum DocMentionSource {
  CONTENT // derived from a mention node in document content
  EXPLICIT // created via CLI or explicit API; survives content re-sync
}

enum NotificationType {
  TASK_IN_REVIEW // task moved to IN_REVIEW — sent to workspace owners
  TASK_MENTIONED // someone @mentioned you in a comment
  TASK_SENT_BACK // owner sent a task back to IN_PROGRESS — sent to assignee
  TASK_ASSIGNED // task assigned to you
  TASK_SPEC_READY // agent generated a spec draft — sent to workspace owners
  TASK_DONE // task marked as done — sent to assignee
  AGENT_CLARIFY // agent needs clarification — requires reply to continue
  AGENT_AUTHORIZE // agent needs authorization for a high-risk operation
  AGENT_VERIFY // agent finished, requests human verification before DONE
  AGENT_FAILED // agent execution failed — informational
  AGENT_DONE // agent finished, PR created — informational
  SPRINT_STARTED
  SPRINT_CLOSED
  DOCUMENT_COMMENT_MENTIONED
  PROJECT_MENTIONED // @mentioned in a project description
  MILESTONE_MENTIONED // @mentioned in a milestone description
  DOCUMENT_MENTIONED // @mentioned in a document body
}

enum CommentType {
  USER
  AGENT
}

enum DocumentCommentStatus {
  OPEN
  RESOLVED
}

enum AgentStatus {
  SUBMITTED      @map("IDLE")
  WORKING        @map("RUNNING")
  INPUT_REQUIRED @map("PAUSED")
  COMPLETED      @map("DONE")
  FAILED
  CANCELED       @map("CANCELLED")
}

enum ActorType {
  HUMAN
  AGENT
  GITHUB_USER
}

enum TaskActivityType {
  TASK_CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNEE_CHANGED
  TITLE_CHANGED
  DESCRIPTION_CHANGED
  DUE_DATE_CHANGED
  PARENT_CHANGED // LUM-959: no longer written (subtasks removed); kept for history rows
  TAGS_CHANGED
  REPOSITORY_CHANGED
  COMMENT_ADDED
  COMMENT_DELETED
  SUBTASK_ADDED // LUM-959: no longer written; kept for history rows
  SUBTASK_REMOVED // LUM-959: no longer written; kept for history rows
  SPEC_GENERATED
  BRANCH_CREATED
  PR_LINKED
  PR_UNLINKED
  PR_CREATED
  PR_MERGED
  AGENT_RUN_STARTED
  AGENT_RUN_COMPLETED
  AGENT_RUN_FAILED
  AGENT_INPUT_REQUIRED
  SENTRY_ALERT
  SPRINT_CHANGED
  CRITERION_CHANGED
  // LUM-942: deprecated with CRITERION_CHANGED / CONTRACT_CONFIRMED — acceptance
  // criteria + verification rounds were removed; nothing writes these anymore.
  // Kept because Postgres cannot drop enum values and old activity rows exist.
  VERIFICATION_RUN_RECORDED
  VERIFICATION_RUN_WITHDRAWN
  VERIFICATION_ESCALATED
  BOUNDARY_CROSSING_DETECTED
  BOUNDARY_CROSSING_ACKNOWLEDGED
  BOUNDARY_CROSSING_DISPOSITIONED
  BOUNDARY_CROSSING_REMEDIATION_SPAWNED
  // LUM-780: a SYSTEM re-judge flipped an OPEN blocking crossing to advisory
  // because its cause no longer holds (rule text still in the source / no linked
  // PR removes a tracked test file). Append-only trail: reason + evidence +
  // criterion version. Never a disposition.
  BOUNDARY_CROSSING_REJUDGED
  // LUM-750: a security finding was dispositioned (or reverted to OPEN) through
  // a channel that needs an audit trail beyond the finding row itself — the CLI
  // handshake (`channel: 'CLI'`, shown / read-acknowledged / confirmed times)
  // and the SYSTEM rollback of an agent-issued disposition (`from`/`to` +
  // reason 'reverted: agent-issued'). Web-panel rulings keep writing only the
  // row (pre-750 shape). Append-only, like BOUNDARY_CROSSING_DISPOSITIONED.
  SECURITY_FINDING_DISPOSITIONED
  TASK_SPUN_OFF
  // LUM-511 Phase 4: judge-confirmed laundering markers (task-level — fed into
  // the flywheel negative class; not VerificationRuns, which require a criterion).
  SPINOFF_LAUNDERED
  SILENT_FIX_DETECTED
  // LUM-789: 一次合同确认动作。与 CRITERION_CHANGED 分开,因为确认不是合同漂移——
  // 后者有 4 个下游消费者把它当漂移信号读。列存最新状态,本事件流存全历史。
  CONTRACT_CONFIRMED
  // LUM-801: 任务级 test case 的生命周期与执行记录。与 CRITERION_CHANGED 分开——
  // test case 不是验收合同,读 CRITERION_CHANGED 当漂移信号的下游消费者不该看到
  // test case 的噪声。
  TEST_CASE_ADDED
  TEST_CASE_UPDATED
  TEST_CASE_REMOVED
  TEST_CASE_RUN_RECORDED
  // LUM-812: a human ruled on a PROVEN_DEFECT run (KNOWN_DEFECT / NOT_A_DEFECT).
  // Append-only trail; the mutable state lives on TestCaseRunDisposition. CLI-channel
  // rulings additionally carry the handshake's shown / read-acknowledged times in
  // metadata (same shape as SECURITY_FINDING_DISPOSITIONED, LUM-750).
  TEST_CASE_DEFECT_DISPOSITIONED
  // LUM-1303: a task decision was recorded / edited / deleted (Decisions tab or
  // `lumo task decide`). Payload carries the text so the trail survives a delete.
  DECISION_ADDED
  DECISION_UPDATED
  DECISION_REMOVED
}

enum BoundaryCrossingCategory {
  PUSH_TO_PROTECTED_BRANCH
  MIGRATION_FILE_DELETED
  HARDCODED_SECRET
  NEW_NPM_DEPENDENCY
  DESTRUCTIVE_DB_COMMAND
  // Reward-hacking (LUM-441): an Edit/Write touched a file a MACHINE acceptance
  // checkpointer depends on — suspected test-tampering to force a fake PASS.
  // LUM-942: deprecated — the acceptance-criteria detectors were removed; nothing
  // writes this (nor CONTRACT_WEAKENING / SPINOFF_LAUNDERED / SILENT_FIX) anymore.
  // Kept because Postgres cannot drop enum values and old rows exist.
  TEST_TAMPERING
  // LUM-442: extended high-severity taxonomy (OpenAI "rare but high-severity").
  EXFILTRATION_PUBLIC // exfiltration / upload to the public internet, incl. making a repo public
  CLOUD_DATA_DELETION // deleting cloud-storage data (s3/gcs/blob rm)
  INFRA_TERMINATION // terminating / restarting infrastructure (kill process, restart cluster)
  // LUM-491: task work (machine verification / status transition) recorded from
  // a Claude Code session that is not attached to the task — the session-binding
  // lock (LUM-459) applied at the work boundary, not just the bind boundary.
  SESSION_BINDING_MISSING
  // LUM-511 Phase 4: an acceptance criterion was weakened (statement lowered to
  // dodge an open send-back) rather than legitimately evolved — judge-confirmed.
  CONTRACT_WEAKENING
  // LUM-511 Phase 6: judge-confirmed laundering, surfaced as crossings (was a
  // TaskActivity marker in Phase 4): SPINOFF_LAUNDERED = a --new-scope task that
  // is rework of the parent; SILENT_FIX = a post-IN_REVIEW fix with no send-back.
  SPINOFF_LAUNDERED
  SILENT_FIX
  // LUM-590: a managed project's own CLAUDE.md/AGENTS.md rule was violated
  PROJECT_RULE_VIOLATION
  // LUM-590: a committed CLAUDE.md edit removed/downgraded a deterministic Forbidden rule
  POLICY_WEAKENING
  // LUM-640: an implementation artifact (git commit / PR creation) was produced
  // during a STEWARD (governance) session — the detector backstop for what the
  // API gate can't see (file edits + local git happen outside the API). Recorded
  // against the steward session's MILESTONE (taskId null); fail-closed: an
  // unparseable Bash payload in a steward session records an unconfirmed
  // crossing rather than nothing. Disposition stays web + human-only.
  STEWARD_IMPLEMENTATION_ARTIFACT
  // LUM-736 (Security Scan v2, L4 Session Guard): three deterministic, no-LLM
  // classes on the existing detectAndRecord chain (disposition human-only,
  // crossing explain, DONE gate). All MEDIUM + reversible; no finding row.
  // SENSITIVE_PATH_EDIT — an Edit/Write landed on a sensitive path (auth/,
  //   middleware.ts / proxy.ts, .github/workflows/, a lockfile,
  //   prisma/schema.prisma); the default path set is replaceable by a
  //   ProjectPolicy path-glob rule mapped to this category.
  // HOOK_BYPASS — a Bash segment ran git commit/push --no-verify or HUSKY=0.
  // TEST_FILE_DELETED — an rm / git rm segment targeted *.test.* / *.spec.* /
  //   __tests__/ (a Bash delete; TEST_TAMPERING stays the Edit/Write class).
  SENSITIVE_PATH_EDIT
  HOOK_BYPASS
  TEST_FILE_DELETED
  // LUM-750: an AGENT session issued `lumo crossing disposition` /
  // `lumo finding disposition` — the interested party ruling on its own
  // blocker. The LUM-769 handshake cannot prove a human ticked each step (the
  // agent relays them), so this is the second layer: the Bash hook stream is
  // matched at the verb position (prose carriers never trip it), the crossing
  // is HIGH + irreversible + never rule-suppressible, and the referenced
  // CLI-channel disposition(s) are rolled back to OPEN with an append-only
  // trail. A human terminal never produces a hook event, so it never trips.
  SELF_DISPOSITION
  // LUM-793: an agent hard-deleted a TRAP memory that had already been judged
  // *used* on at least one other task — the one crossing in the memory-poison
  // work, because deleting is an AGENT ACTION (the other three classes are
  // content problems, recorded on the memory row per LUM-783, never on the
  // agent). Irreversible: `memoryRepository.delete` is a hard delete, so
  // unlike an archive there is nothing to restore.
  USED_TRAP_MEMORY_DELETED
  // LUM-960: a local filesystem command destroying state OUTSIDE the repo —
  // recursive rm / find -delete on a root-level path (/, ~, /root, /home/*,
  // /etc, /usr …), rm in a personal media folder, shred, mkfs, dd of=/dev/….
  // HIGH + irreversible (nothing in git can restore it).
  DESTRUCTIVE_FS_COMMAND
  // LUM-963: the agent READ a well-known credential store outside the repo
  // (~/.ssh private keys, ~/.aws/credentials, gh/docker/netrc tokens,
  // /etc/shadow, /etc/sudoers, browser cookie/password DBs, mail spool) via
  // the Read tool or a reading Bash verb. LOW + always advisory: recorded as a
  // hint, never blocks DONE. Reversible — a read changes no state.
  SENSITIVE_PATH_READ
  // LUM-962: code from an unvetted source was run — an install from a VCS / URL
  // spec (`pip install git+https://…`), a download piped into an interpreter
  // (`curl … | sh`, `bash <(curl …)`), or a downloaded file made executable /
  // run in the same command. HIGH + irreversible + never rule-suppressible.
  // (A NAMED registry install, any ecosystem, stays NEW_NPM_DEPENDENCY.)
  UNTRUSTED_CODE_EXECUTION
}

enum BoundaryCrossingDisposition {
  FALSE_POSITIVE
  CONFIRMED
  // LUM-478: a SYSTEM auto-resolution (no human actor). The deterministic
  // pre-filter judged a TEST_TAMPERING edit high-confidence legit (production
  // code co-changed AND assertions intact) → recorded for audit but resolved out
  // of the open queue and non-DONE-blocking. Distinct from a human FALSE_POSITIVE
  // (which carries a dispositionedById) so an auditor can tell "system auto" from
  // "human ruled". A human can still re-open or re-dispose it (LUM-450).
  AUTO_LEGIT
  // LUM-751: a SYSTEM auto-disposition by a human-authored per-repository
  // CrossingSuppressionRule. Recorded (audit) but out of the open queue and
  // non-DONE-blocking; carries suppressionRuleId, never a dispositionedById.
  AUTO_SUPPRESSED
}

// LUM-442: severity tier per boundary-crossing (OpenAI frequency×severity model).
// Drives ordering/prominence on the acceptance bar; a HIGH crossing also forces
// the DONE gate even where the workspace opted the gate out (still clearable by a
// human disposition).
enum BoundaryCrossingSeverity {
  LOW
  MEDIUM
  HIGH
}

enum AgentType {
  CODING
  REVIEW
  PLANNER
}

enum SummaryFrequency {
  DAILY
  EVERY_TWO_DAYS
  WEEKLY
}

// ─── Workspace ──────────────────────────────────────────────────────────────

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String
  logoUrl     String?
  // Monotonic per-workspace counter used to allocate Document.number on create.
  // Mirrors Team.taskSeq. Atomic increment inside the create transaction
  // serialises concurrent inserts without contention on a SELECT MAX query.
  documentSeq Int      @default(0)
  // LUM-1059: per-workspace counter for BoundaryCrossing.number (the
  // human-readable `<TEAM>-X<n>` ref). Same allocation pattern as documentSeq.
  crossingSeq Int      @default(0)
  // LUM-1240: per-workspace counter for Feedback.number (the `FB-<n>` ref).
  feedbackSeq Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members                 WorkspaceMember[]
  teams                   Team[]
  projects                Project[]
  tasks                   Task[]
  views                   View[]
  invites                 WorkspaceInvite[]
  githubIntegrations      GitHubIntegration[]
  pullRequests            PullRequest[]
  slackIntegration        SlackIntegration?
  sentryIntegration       SentryIntegration?
  gitHubAppInstallation   GitHubAppInstallation?
  /// LUM-1315 — the workspace's Codeup (center edition) connection.
  codeupConnection        CodeupConnection?
  /// LUM-1133 — per-repository automatic PR review settings.
  repoReviewSettings      RepositoryReviewSetting[]
  actors                  Actor[]
  agentProfiles           AgentProfile[]
  documents               Document[]
  documentRevisions       DocumentRevision[]
  drafts                  Draft[]
  summaries               WorkspaceSummary[]
  tags                    Tag[]
  mcpConnections          McpConnection[]          @relation("WorkspaceMcpConnections")
  hookEvents              HookEvent[]
  dataKeys                WorkspaceDataKey[]
  sessions                Session[]
  worktrees               Worktree[]
  memories                Memory[]
  taskSlackContexts       TaskSlackContext[]
  taskWebLinks            TaskWebLink[]
  taskDecisions           TaskDecision[]
  prCommentSyncJobs       PrCommentSyncJob[]
  figmaIntegrations       FigmaIntegration[]
  googleDriveIntegrations GoogleDriveIntegration[]
  feishuIntegration       FeishuIntegration?
  feishuAccounts          FeishuAccountIntegration[]
  taskFigmaLinks          TaskFigmaLink[]
  taskArtifacts           TaskArtifact[]
  documentTemplates       DocumentTemplate[]
  taskTemplates           TaskTemplate[]
  lineageEdges            LineageEdge[]
  milestoneMemoryEdges    MilestoneMemoryEdge[]
  droppedFragments        DroppedFragment[]
  outcomeSignals          OutcomeSignal[]
  taskDependencies        TaskDependency[]
  priorities              Priority[]

  summaryFrequency SummaryFrequency @default(DAILY)
  summaryEnabled   Boolean          @default(true)

  // LUM-1097: the workspace's default language — Slack channel posts are
  // written in it, and so are DMs to members who have no language preference
  // of their own; LUM-1117: AI summaries too (English for languages other
  // than English and Chinese). Same codes as UserPreference.locale (lib/i18n/public-locale.ts).
  defaultLocale String @default("en")

  // LUM-426: default-ON DONE gate. Opting out (false) drops the boundary-crossing
  // DONE block but never the flagging (recording is always on).
  boundaryGateEnabled Boolean @default(true)

  // LUM-740: which { provenance, severity } pairs block DONE —
  // { block: [{ provenance, severity }] }. null = the 732 default (only an
  // undispositioned DETERMINISTIC HIGH blocks). LLM_JUDGE is refused by the
  // API schema and ignored by the reader: an LLM finding can never block.
  securityPolicy Json?

  // LUM-859: raw hook-event retention, in days. null = keep forever (default);
  // OWNER picks 30 / 90 / 180 / 365. The daily sweep replaces an expired
  // event's payload with a pruned marker — rows and derived columns stay.
  hookEventRetentionDays Int?

  // LUM-933 / LUM-910: how the session record (raw hook events) is kept.
  // RETAIN (default, new and existing workspaces) = stored with code, only
  // credentials redacted; kept forever or `hookEventRetentionDays` days.
  // USED_UP = code stripped on ingest (LUM-855) and the remaining raw payload
  // dropped 7 days after it is used up (task DONE, 30 days idle, crossing
  // dispositioned); `hookEventRetentionDays` is null in this mode.
  hookEventRetentionMode       HookEventRetentionMode @default(RETAIN)
  // LUM-933: a setting change only governs data stored afterwards. When the
  // session record setting gets stricter, `hookEventRetentionSince` moves to
  // that instant: events created from then on follow the current setting,
  // older ones follow `hookEventRetentionLegacyDays` (the most lenient day
  // tier they were ever stored under; null = never pruned). Both null = no
  // cutoff, the current setting governs every event.
  hookEventRetentionSince      DateTime?
  hookEventRetentionLegacyDays Int?

  // LUM-912: days a dispositioned boundary crossing keeps its raw text
  // (detail, target, explanations, timeline copies). OWNER picks 7 / 30 / 90.
  crossingRawRetentionDays  Int      @default(7)
  // LUM-912: only crossings dispositioned at or after this instant are purged
  // automatically. Filled with the migration time for existing workspaces, so
  // deploying never purges the historical stock (that is LUM-914). LUM-933:
  // moves to the change time whenever the OWNER shortens the window, so a
  // shorter window never purges crossings ruled under the longer one.
  crossingRawRetentionSince DateTime @default(now())

  // LUM-941: days a dead-lettered PR comment sync job keeps its GitHub
  // webhook payload. OWNER picks 7 / 30 / 90; 7 = the LUM-913 behaviour.
  deadLetterRetentionDays Int @default(7)

  // LUM-917: AI-derived content — memories extracted from sessions (and their
  // project / milestone consolidation), on-demand session summaries and
  // DONE-time run summaries. OWNER switch; true = generate (default, the
  // LUM-909 ruling). false stops new generation; existing rows are removed only
  // by the OWNER's explicit delete (lib/services/ai-derived-content.service.ts).
  aiDerivedContentEnabled Boolean @default(true)

  // LUM-1334: OWNER opt-ins that tighten the DONE gate for tasks with a
  // linked PR (closed-unmerged PRs don't count). Both default off.
  // doneRequiresTestCase: each PR has a test case whose latest run passed on
  // its head (or merge) commit. doneRequiresReview: each PR's head is covered
  // by a Lumo AI review, an imported agent review or a GitHub approval.
  doneRequiresTestCase Boolean @default(false)
  doneRequiresReview   Boolean @default(false)

  // LUM-1338: the AI feature switches (master / group / feature), sparse —
  // only switches an OWNER turned off are stored ({} = all on). Parsed and
  // resolved by lib/ai-features/registry.ts; a feature also needs a model
  // configured on the deployment.
  aiFeatureSwitches Json @default("{}")

  // LUM-911: how long a scan keeps the code it quoted (finding evidence, call
  // chain, LLM text; the scan's hunt audit, hunt job and PR summary) once it
  // is used up — its PR merged or closed and every scan of it final. OWNER
  // picks 0 / 7 / 14 / 30; 0 = scrub as soon as the scan is final and its PR
  // review is synced. A scan on a PR that stays open is scrubbed 30 days
  // after it finished whatever this says (lib/security-scan/evidence-retention.ts).
  scanEvidenceRetentionDays Int @default(7)

  // LUM-866: per-workspace switches for the PR security scan; the platform
  // env (LUMO_MANAGED_SCAN / LUMO_SECURITY_HUNT) stays the ceiling — a
  // workspace can only turn a layer off, never on. Scan off = no scan row, no
  // layer, no PR comment for this workspace's PRs. LUM-1328: a new workspace
  // starts with Lumo's AI review and hunt off — the developer's own agent
  // review (`lumo review import`) is the default; an owner turns ours on.
  securityScanEnabled     Boolean           @default(true)
  securityAiReviewEnabled Boolean           @default(false)
  securityHuntEnabled     Boolean           @default(false)
  // LUM-1234: the reward-hack layer (platform LUMO_REWARD_HACK is the ceiling).
  securityRewardHackEnabled Boolean         @default(true)
  // LUM-1130: the PR reviewer's request-changes workflow.
  // Off by default: on, Lumo's review is
  // "Changes requested" while a Lumo thread or a DONE-blocking finding is
  // open, and Lumo approves once the latest head's complete review leaves
  // nothing open.
  securityRequestChangesEnabled Boolean @default(false)
  // LUM-1142: author approval. On by default:
  // the PR's author may `@uselumo resolve` / `approve` their own PR; off,
  // only other write-access accounts may.
  securityAllowAuthorApproval Boolean @default(true)
  // LUM-1134: which repositories' PR-review learnings (LUM-1131) the AI
  // review reads. "local" =
  // the reviewed repository only; "global" = every repository of this
  // workspace; "auto" (default) = local for a public repository, global for a
  // private one, local when the visibility is unknown. Never across
  // workspaces. A CHECK constraint keeps it to those three values.
  securityLearningsScope String @default("auto")
  // LUM-1137: auto-pause after reviewed commits — automatic
  // AI review (and exploit-path discovery) of every push pauses on a PR once
  // this many commits have been reviewed; 0 = never pause. A PR's own
  // `--resume --limit` (PullRequest.reviewCommitLimit) overrides it. A CHECK
  // constraint keeps it to 0–100.
  securityReviewAutoPauseAfter Int @default(5)
  // LUM-1259: log local scan results (`lumo security scan --log`, the
  // post-commit / pre-push hooks) on the server, one LocalScanRun per commit.
  // Off by default: unpushed-commit metadata is sensitive, so an OWNER opts
  // in. Off = the upload endpoint refuses; rows already logged stay.
  securityLocalScanLogEnabled Boolean @default(false)
  workspaceExports        WorkspaceExport[]

  // LUM-918: pending deletion. An OWNER's delete schedules it 48h out
  // (deletionExecuteAt); any OWNER can cancel (all three reset to null) or
  // run it at once. The hourly cron runs the LUM-861 purge once it is due.
  deletionRequestedAt        DateTime?
  deletionExecuteAt          DateTime?
  deletionRequestedByClerkId String?

  attributionSegments TaskAttributionSegment[]
  usageResyncAudits   UsageResyncAudit[]
  auditEvents         AuditEvent[]
  subprocessorNotices SubprocessorNoticeDelivery[]
  llmSpend            WorkspaceLlmSpend[]
  feedback            Feedback[]
  // LUM-1259: local scan results reported by the CLI (security plugin).
  localScanRuns       LocalScanRun[]

  @@index([deletionExecuteAt])
  @@map("workspaces")
}

// ─── Audit log (LUM-907) ────────────────────────────────────────────────────

/// LUM-907: who performed a sensitive operation.
enum AuditActorType {
  MEMBER
  AGENT
  SYSTEM
}

/// LUM-907: where the operation came from. CLI = an API-key bearer request
/// (the lumo CLI, MCP clients, scripts); WEB = a Clerk browser session.
enum AuditSource {
  WEB
  CLI
  WEBHOOK
  SYSTEM
}

/// LUM-907: workspace audit log — one row per sensitive operation (member and
/// invite changes, workspace / security / retention settings, data export and
/// deletion, templates, integration connections). Never holds content bodies:
/// `metadata` carries ids, field names and setting values only, and like
/// `userAgent` is credential-redacted before it is written
/// (lib/services/audit.service.ts). Rows are deleted after
/// AUDIT_RETENTION_DAYS by the prune-audit-events cron, and with the
/// workspace (cascade); the WorkspaceDeletionReceipt outlives them.
model AuditEvent {
  id            String         @id @default(cuid())
  workspaceId   String
  actorType     AuditActorType
  /// Clerk user id for a MEMBER (stable after the member leaves); the agent
  /// Actor id for an AGENT; null for SYSTEM.
  actorId       String?
  /// WorkspaceMember id when the actor was a member at the time. No FK — the
  /// row must survive the member leaving.
  actorMemberId String?
  /// Dotted action key from lib/audit/actions.ts (e.g. `member.role_changed`).
  action        String
  targetType    String
  targetId      String?
  source        AuditSource
  /// Client IP (validated, max 45 chars) — null when unknown.
  ip            String?
  /// Credential-redacted, truncated to 512 chars.
  userAgent     String?
  metadata      Json?
  createdAt     DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, action, createdAt])
  @@index([createdAt])
  @@map("audit_events")
}

/// LUM-919: one subprocessor change notice (DPA 7.2) emailed to one OWNER of
/// one workspace. Written by the operator's send script after Resend accepts
/// the message; the unique key makes a rerun skip everyone already notified.
/// Holds no email address — the Clerk id is resolved at send time. Goes with
/// the workspace (cascade).
model SubprocessorNoticeDelivery {
  id          String   @id @default(cuid())
  /// SubprocessorChange.id from lib/legal/subprocessor-changes.ts
  changeId    String
  workspaceId String
  clerkId     String
  /// Resend message id, when Resend returned one.
  messageId   String?
  sentAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([changeId, workspaceId, clerkId])
  @@index([workspaceId])
  @@map("subprocessor_notice_deliveries")
}

/// LUM-861: proof that a workspace was deleted (DPA deletion evidence). FK-less
/// on purpose — it must outlive the workspace it describes. Carries no
/// workspace content: ids, the requester, row counts and the blob outcome only.
model WorkspaceDeletionReceipt {
  id                 String   @id @default(cuid())
  workspaceId        String
  requestedByClerkId String
  /// { [modelName]: rowsDeleted } — only models with at least one row.
  rowCounts          Json
  /// { status: PENDING | DONE | FAILED, deleted, error? } — blobs are removed
  /// after the DB commit, so this is written as PENDING and settled after.
  blobCleanup        Json
  deletedAt          DateTime @default(now())

  @@index([workspaceId])
  @@map("workspace_deletion_receipts")
}

/// LUM-1041: app-level idempotency for outgoing email. SMTP has no
/// idempotency of its own, so a send carrying an idempotency key first claims
/// this row (unique key, SENDING), then sends, then settles it SENT / FAILED.
/// A key that is SENT (or SENDING and fresh) is never sent again; FAILED or a
/// stale SENDING (crashed sender) may be reclaimed and retried.
///
/// NOT workspace-scoped on purpose: these are system emails (invites, owner
/// notices, subprocessor notices) keyed by the caller, some sent before any
/// workspace membership exists. There is no workspaceId column, so the model
/// is not in WORKSPACE_SCOPED_MODELS and queries never filter by workspace.
/// Holds no recipient address or content — only the key and the outcome.
model EmailDelivery {
  id               String              @id @default(cuid())
  idempotencyKey   String              @unique
  status           EmailDeliveryStatus @default(SENDING)
  /// Bumped on every claim; the compare-and-swap guard for reclaiming.
  attempts         Int                 @default(1)
  /// When the current claim started; a SENDING row older than the stale
  /// window is treated as a crashed send and may be reclaimed.
  attemptStartedAt DateTime            @default(now())
  /// SMTP message id from the transport, once SENT.
  messageId        String?
  sentAt           DateTime?
  /// Transport error code (EAUTH, ETIMEDOUT, …) of the last FAILED attempt.
  errorCode        String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@map("email_deliveries")
}

enum EmailDeliveryStatus {
  SENDING
  SENT
  FAILED
}

/// LUM-858: one GDPR data-export request (access / portability). The row is
/// the audit trail of the export — who asked, when, what it held, who
/// downloaded it — and outlives its archive: the private blob is deleted when
/// the download window closes and the row turns EXPIRED.
model WorkspaceExport {
  id                      String                @id @default(cuid())
  workspaceId             String
  requestedByClerkId      String
  status                  WorkspaceExportStatus @default(PENDING)
  /// Private blob URL of the zip. Server-side only — never sent to a client.
  blobUrl                 String?
  sizeBytes               Int?
  /// { [file]: rowsExported } — written when the archive is READY.
  rowCounts               Json?
  error                   String?
  workflowRunId           String?
  completedAt             DateTime?
  expiresAt               DateTime?
  downloadCount           Int                   @default(0)
  lastDownloadedAt        DateTime?
  lastDownloadedByClerkId String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("workspace_exports")
}

enum WorkspaceExportStatus {
  PENDING
  RUNNING
  READY
  FAILED
  EXPIRED
}

// ─── Team ───────────────────────────────────────────────────────────────────

model Team {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  identifier  String // task ID prefix e.g. "ENG"
  isDefault   Boolean  @default(false)
  taskSeq     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sprintsEnabled Boolean @default(false)

  // Sprint cadence config — applied when auto-creating future sprints.
  // startWeekday: 0=Sun … 6=Sat (ISO Monday = 1).
  // Cooldown is the number of full days between the last day of one sprint
  // and the first day of the next (0 = back-to-back, i.e. next sprint
  // starts the day after the previous one ends).
  sprintDurationDays Int @default(14)
  sprintCooldownDays Int @default(0)
  sprintStartWeekday Int @default(1)
  sprintAutoCreate   Int @default(0)

  // When a task transitions to DONE with no sprint binding, auto-add it to the
  // team's currently ACTIVE sprint so the completed work counts toward it.
  sprintAutoAddCompleted Boolean @default(false)

  // IANA timezone governing sprint boundary computation and date display.
  // Existing teams backfilled to Pacific; new teams take the creator's zone.
  timezone String @default("America/Los_Angeles")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects    Project[]
  members     TeamMember[]
  tasks       Task[]
  sprints     Sprint[]
  priorities  Priority[]

  @@unique([workspaceId, identifier])
  @@index([workspaceId])
  @@map("teams")
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  memberId String
  joinedAt DateTime @default(now())

  team   Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  member WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([teamId, memberId])
  @@index([memberId])
  @@map("team_members")
}

model WorkspaceMember {
  id                 String        @id @default(cuid())
  workspaceId        String
  clerkId            String
  role               WorkspaceRole @default(MEMBER)
  joinedAt           DateTime      @default(now())
  /// LUM-906: set when the member is removed by an OWNER, leaves, or is
  /// deprovisioned by the identity provider (Clerk user deleted / banned).
  /// The row is kept so authorship and session history survive; every
  /// membership lookup ignores deactivated rows. Cleared on re-invite.
  deactivatedAt      DateTime?
  /// REMOVED | LEFT | CLERK_USER_DELETED | CLERK_USER_BANNED (lib/members/deactivation.ts)
  deactivationReason String?

  workspace               Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  teams                   TeamMember[]
  createdProjects         Project[]                @relation("ProjectCreator")
  createdTasks            Task[]                   @relation("TaskCreator")
  ownsProjects            Project[]                @relation("ProjectOwner")
  ownedViews              View[]                   @relation("ViewOwner")
  createdViews            View[]                   @relation("ViewCreator")
  sharedViews             ViewMember[]
  sentInvites             WorkspaceInvite[]
  githubIntegrations      GitHubIntegration[]
  slackInstalled          SlackIntegration[]       @relation("SlackInstaller")
  sentryInstalled         SentryIntegration[]      @relation("SentryInstaller")
  gitHubAppInstalls       GitHubAppInstallation[]  @relation("GitHubAppInstaller")
  codeupConnections       CodeupConnection[]       @relation("CodeupConnector")
  actor                   Actor?
  agentProfiles           AgentProfile[]
  apiKeys                 ApiKey[]
  hookEvents              HookEvent[]
  sessions                Session[]
  preference              UserPreference?
  createdDocuments        Document[]               @relation("DocumentCreator")
  documentShares          DocumentShare[]          @relation("DocumentShareMember")
  documentEdits           DocumentEditor[]
  createdSlackContexts    TaskSlackContext[]       @relation("TaskSlackContextCreator")
  createdWebLinks         TaskWebLink[]            @relation("TaskWebLinkCreator")
  createdTaskDecisions    TaskDecision[]           @relation("TaskDecisionCreator")
  createdMemories         Memory[]                 @relation("MemoryCreator")
  figmaIntegrations       FigmaIntegration[]
  googleDriveIntegrations GoogleDriveIntegration[]
  feishuInstalled         FeishuIntegration[]      @relation("FeishuInstaller")
  feishuAccounts          FeishuAccountIntegration[]
  taskFigmaLinks          TaskFigmaLink[]          @relation("TaskFigmaLinkCreator")
  documentRevisions       DocumentRevision[]
  submittedFeedback       Feedback[]               @relation("FeedbackSubmitter")

  @@unique([workspaceId, clerkId])
  @@index([clerkId])
  @@map("workspace_members")
}

// ─── Priority (team-level declaration, LUM-660) ─────────────────────────────

// A team-level priority statement. Append-only by design: no `updatedAt`, and
// no update/delete path in any layer — a newer declaration supersedes an older
// one by a later `effectiveFrom`, the history is never mutated.
model Priority {
  id                 String   @id @default(cuid())
  teamId             String
  workspaceId        String
  statement          String // 1-3 sentence plain text
  effectiveFrom      DateTime
  declaredByMemberId String
  createdAt          DateTime @default(now())

  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([teamId, effectiveFrom])
  @@map("priorities")
}

// ─── Agent Profiles ─────────────────────────────────────────────────────────

model AgentProfile {
  id          String    @id @default(cuid())
  workspaceId String
  memberId    String? // null = workspace-shared agent; set = personal agent (Phase 4)
  name        String // "Coding Agent"
  type        AgentType
  avatarColor String    @default("#6366f1")
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member    WorkspaceMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  actor     Actor?

  @@unique([workspaceId, type, memberId])
  @@map("agent_profiles")
}

model Actor {
  id                String    @id @default(cuid())
  workspaceId       String
  type              ActorType
  memberId          String?   @unique
  agentId           String?   @unique
  externalIdentity  String? // "github:<login>" for GITHUB_USER; null otherwise
  externalAvatarUrl String?

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member    WorkspaceMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  agent     AgentProfile?    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  assignedTasks            Task[]            @relation("TaskAssignee")
  comments                 Comment[]         @relation("CommentAuthor")
  activities               TaskActivity[]
  receivedNotifications    Notification[]    @relation("NotificationRecipient")
  triggeredNotifications   Notification[]    @relation("NotificationTrigger")
  documentComments         DocumentComment[] @relation("DocumentCommentAuthor")
  resolvedDocumentComments DocumentComment[] @relation("DocumentCommentResolver")

  @@unique([workspaceId, externalIdentity])
  @@index([workspaceId])
  @@map("actors")
}

// ─── Project ────────────────────────────────────────────────────────────────

model Project {
  id                String   @id @default(cuid())
  workspaceId       String
  teamId            String
  createdByMemberId String
  ownerId           String?
  name              String
  description       String?
  isIdea            Boolean  @default(false)
  order             Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // LUM-1285: a human ruling on whether work should continue. "Completed" is
  // never stored — it is derived for display from the project's tasks (see
  // shared/src/project-lifecycle.ts). PAUSED / CANCELED / archived projects
  // drop out of agent pickup (`lumo status --next`) and refuse or warn on
  // task create.
  status            ProjectStatus @default(ACTIVE)
  startDate         DateTime?
  targetDate        DateTime?
  // Human archive flag: hidden from the sidebar and `project list` by default.
  archivedAt        DateTime?

  // Per-project lease serializing Layer 2 memory consolidation. A run claims
  // this (sets it to now + TTL) before reading; concurrent runs that can't
  // claim it skip the round. Prevents duplicate PROJECT-scope promotions when
  // multiple task completions fire consolidation at once. See layer2.service.
  memoryConsolidationLockedUntil DateTime?
  /// LUM-553 — last time the autonomous topic-fold pass attempted this project.
  /// Per-project cooldown so the daily cron doesn't re-run the LLM every day.
  lastMemoryFoldAttemptAt        DateTime?

  workspace                Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team                     Team                      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy                WorkspaceMember           @relation("ProjectCreator", fields: [createdByMemberId], references: [id])
  owner                    WorkspaceMember?          @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks                    Task[]
  milestones               Milestone[]
  views                    View[]
  slackChannels            SlackChannel[]
  repositories             ProjectRepository[]
  sentryProjectMappings    SentryProjectMapping[]
  documents                Document[]
  priorityOverrides        PriorityOverride[]
  summaries                ProjectSummary[]
  memories                 Memory[]
  projectPolicies          ProjectPolicy[]
  crossingSuppressionRules CrossingSuppressionRule[]
  forbiddenRuleSnapshot    ForbiddenRuleSnapshot?

  @@index([workspaceId])
  @@index([teamId])
  @@index([createdByMemberId])
  @@index([workspaceId, order])
  @@map("projects")
}

model ProjectPolicy {
  id         String   @id @default(cuid())
  projectId  String
  sourceHash String // sha256 of concatenated CLAUDE.md + AGENTS.md source + compiler version (LUM-770)
  rules      Json // PolicyRule[] (see lib/services/policy/types.ts)
  compiledAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // LUM-774: one row per compiled source. Concurrent recompiles of the same
  // source insert-or-ignore against this key and serve the single row.
  @@unique([projectId, sourceHash])
  @@index([projectId, compiledAt]) // latest + previous lookup
  @@map("project_policies")
}

/// LUM-1068: the core's own copy of a project's `## Forbidden` rules, parsed
/// deterministically from its default repository's CLAUDE.md / AGENTS.md
/// (lib/boundary-crossing/forbidden-rules.ts). One row per project: the rule
/// set last observed, so the next parse can tell which rules were removed
/// (POLICY_WEAKENING without the security plugin). Core table — the plugin's
/// LLM-compiled rules stay in ProjectPolicy.
model ForbiddenRuleSnapshot {
  id                 String   @id @default(cuid())
  projectId          String   @unique
  sourceHash         String // sha256 of the CLAUDE.md + AGENTS.md text the rules were parsed from
  // The text before that — a hook instance whose 60 s file cache still holds
  // it must not flip the snapshot back (stale read, not a revert).
  previousSourceHash String?
  rules              Json // ForbiddenRule[] ({ id, text, file })
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("forbidden_rule_snapshots")
}

// LUM-751: a human-authored, per-repository false-positive rule. A later
// detection of the same (category, target) in the project is still recorded
// but auto-dispositioned AUTO_SUPPRESSED (system, no human actor). Created only
// from a human FALSE_POSITIVE disposition (Clerk); never for the HIGH classes
// (HARDCODED_SECRET / DESTRUCTIVE_DB_COMMAND / EXFILTRATION_PUBLIC /
// CLOUD_DATA_DELETION / INFRA_TERMINATION). Soft-revoked, never deleted.
model CrossingSuppressionRule {
  id               String                   @id @default(cuid())
  projectId        String
  category         BoundaryCrossingCategory
  // Exact crossing `target` (the LUM-477 coalescing key) or a `prefix*` glob.
  targetPattern    String
  reason           String?
  createdById      String // WorkspaceMember id of the human who ruled
  sourceCrossingId String? // the crossing whose disposition created the rule
  createdAt        DateTime                 @default(now())
  revokedAt        DateTime?
  revokedById      String?

  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  crossings BoundaryCrossing[]

  @@index([projectId, category])
  @@map("crossing_suppression_rules")
}

model ProjectRepository {
  id                String    @id @default(cuid())
  projectId         String
  // LUM-1315: the Git host this repository lives on — 'github' | 'codeup'.
  // Every GitHub API reader filters on 'github'.
  provider          String    @default("github")
  fullName          String // "owner/repo"
  name              String // short repo name
  isDefault         Boolean   @default(false)
  // LUM-735: last successful SARIF ingest for this repo — null means the
  // repo has never pushed a scan (panel shows NOT_CONFIGURED, not PENDING).
  lastSarifIngestAt DateTime?
  // LUM-738: { sha, at, fingerprints[], partial, tools[] } of the last managed
  // baseline scan of the default branch (`requestedAt` while a run is in
  // flight and `at` is null). Diff-aware substitute for findings that have no
  // line-level diff (dependencies): a PR finding whose fingerprint is in the
  // set is `persisting`, not new. null = never scanned.
  securityBaseline  Json?
  createdAt         DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, provider, fullName])
  @@index([projectId])
  @@map("project_repositories")
}

// ─── Task (self-referencing tree) ───────────────────────────────────────────

model Task {
  id                String       @id @default(cuid())
  projectId         String
  // LUM-992: denormalized from project.workspaceId so the data-layer tenant
  // check (lib/db/workspace-scope.ts) and a future RLS policy cover Task
  // directly. Always equal to the project's workspace: a DB trigger
  // (tasks_workspace_id_guard, migration 20261016090000_task_workspace_id)
  // fills it from the project when an insert omits it and rejects a mismatch.
  workspaceId       String
  teamId            String
  number            Int
  assigneeActorId   String?
  // LUM-1283: the WorkspaceMember that created the task — always a user, never
  // an agent (an agent creating through the CLI is recorded as the member whose
  // API key ran it). Null for automation-created tasks (Sentry webhook) and for
  // rows that predate the column with no backfillable TASK_CREATED actor.
  createdByMemberId String?
  sprintId          String?
  milestoneId       String?
  title             String
  description       String?
  spec              String?
  status            TaskStatus   @default(TODO)
  priority          TaskPriority @default(NONE)
  order             Float        @default(0)
  agentStatus       AgentStatus?
  agentError        String?
  inputReason       String? // Why INPUT_REQUIRED: "spec_review" | "clarify" | etc.
  commentsSummary   String?      @db.Text
  commentsSummaryAt DateTime?
  // Set once when the task first leaves TODO (work started). Gates the
  // free first-draft window vs the recorded after-start criteria diff
  // (LUM-437). Never reset — a bounce back to TODO stays "started".
  workStartedAt     DateTime?
  // LUM-1282: factual terminal stamps, written by the status-transition path
  // on entering DONE / CANCELED and cleared when the task leaves that status.
  completedAt       DateTime?
  canceledAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  dueDate           DateTime?

  // LUM-646 (F4/自治边界): agent-claimable triage marker. Fail-closed —
  // a task is NOT auto-claimable until a steward (or human) explicitly
  // triages it. Consumed by `lumo next --claimable`, which surfaces only
  // claimable ∩ unblocked (F3) ∩ in-budget (F2) tasks. Advisory only:
  // nothing is gated on it server-side; default `lumo next` ignores it.
  claimable Boolean @default(false)

  // LUM-918: trash. A deleted row stays here with `deletedAt` set for 30
  // days (restorable), then the purge cron hard-deletes it. Reads skip it by
  // default (lib/db/soft-delete.ts). The row the user deleted is the trash
  // root (`trashRootId` null); its descendants point `trashRootId` at it and
  // are restored / purged with it.
  deletedAt        DateTime?
  trashRootId      String?
  deletedByClerkId String?

  /// LUM-1286: 1024-dim embedding of the title (alibaba/qwen3-embedding-0.6b),
  /// for duplicate-check candidate recall. Read/written ONLY via parameterized
  /// raw SQL in task.repository.ts — Prisma can't touch Unsupported columns.
  /// NULL until stamped (create/rename, or the backfill script).
  titleEmbedding   Unsupported("vector(1024)")?

  // LUM-573: frozen task-level claim snapshot. Synthesized at DONE/idle by the
  // run-summary worker (and the backfill) from the AUTHORITATIVE session — the
  // one carrying a MERGED lineage edge (DB fact of delivery), else the latest
  // session as fallback — via the same two-layer selectClaim rule. The
  // acceptance read path degrades to a field read of these columns (no
  // cross-session live query). `claimSnapshotAt` non-null is the "synthesized"
  // watermark: a null `claimSnapshot` text under a set `claimSnapshotAt` is an
  // authoritative fail-closed answer (no material), not "never synthesized".
  // `claimSnapshotSource` mirrors TaskClaim.source ('RUN_SUMMARY' | 'DIGEST').
  // `claimSnapshotSessionId` is an audit pointer (which session was chosen); no
  // FK, since the source session may be pruned independently.
  claimSnapshot          String?
  claimSnapshotSource    String?
  claimSnapshotSessionId String?
  claimSnapshotAt        DateTime?

  // LUM-663 (Spec2-1): sizeHint = a coarse S/M/L sizing. Nullable.
  sizeHint SizeHint?

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team       Team        @relation(fields: [teamId], references: [id])
  sprint     Sprint?     @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  milestone  Milestone?  @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignee   Actor?      @relation("TaskAssignee", fields: [assigneeActorId], references: [id], onDelete: SetNull)
  createdBy  WorkspaceMember? @relation("TaskCreator", fields: [createdByMemberId], references: [id], onDelete: SetNull)

  viewTaskOrders          ViewTaskOrder[]
  comments                Comment[]
  pullRequests            PullRequest[]
  branches                TaskBranch[]
  sessions                Session[]
  activities              TaskActivity[]
  boundaryCrossings       BoundaryCrossing[]        @relation("CrossingTask")
  securityScans           PrSecurityScan[]
  remediatesCrossings     BoundaryCrossing[]        @relation("CrossingRemediation")
  documentMentions        DocumentMention[]
  priorityOverrides       PriorityOverride[]
  taskTags                TaskTag[]
  sentryIssueLinks        SentryIssueLink[]
  memories                Memory[]
  slackContexts           TaskSlackContext[]
  webLinks                TaskWebLink[]
  decisions               TaskDecision[]
  figmaLinks              TaskFigmaLink[]
  artifacts               TaskArtifact[]
  complexity              TaskComplexity?
  lineageEdges            LineageEdge[]
  droppedFragments        DroppedFragment[]
  outcomeSignals          OutcomeSignal[]
  forecastSnapshot        TaskForecastSnapshot?
  claimFaithfulness       ClaimFaithfulnessVerdict?
  blockedByEdges          TaskDependency[]          @relation("TaskBlockedBy")
  blockingEdges           TaskDependency[]          @relation("TaskBlocking")
  autoBlocks              AutoBlock[]
  testCases               TestCase[]
  testCaseRuns            TestCaseRun[]
  testCaseRunDispositions TestCaseRunDisposition[]
  testCaseRunReviews      TestCaseRunReview[]

  attributionSegments TaskAttributionSegment[]

  @@unique([teamId, number])
  @@index([projectId])
  @@index([projectId, status])
  @@index([workspaceId, status])
  @@index([teamId])
  @@index([teamId, status])
  // LUM-821: trigram index for fuzzy `task search` (ILIKE substring and the
  // `<<%` strict word-similarity operator are both served by it).
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "tasks_title_trgm_idx")
  @@index([assigneeActorId])
  @@index([createdByMemberId])
  @@index([sprintId])
  @@index([milestoneId])
  @@index([deletedAt])
  @@index([trashRootId])
  @@map("tasks")
}

model TaskComplexity {
  id               String   @id @default(cuid())
  taskId           String   @unique
  teamId           String // 分位分布的范围键
  totalDurationMs  Int // 所有 finished AgentRun 的 durationMs 求和
  changedFileCount Int // 各 run changedFiles 去重并集的大小
  agentRunCount    Int // 上下文用,不进复合分
  computedAt       DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("task_complexities")
}

// ─── Sprint & SprintSummary ───────────────────────────────────────────────

model Sprint {
  id        String       @id @default(cuid())
  teamId    String
  number    Int
  name      String
  status    SprintStatus @default(DRAFT)
  startDate DateTime
  endDate   DateTime
  startedAt DateTime?
  closedAt  DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  team    Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tasks   Task[]
  summary SprintSummary?

  @@unique([teamId, number])
  @@index([teamId, status])
  @@map("sprints")
}

model Milestone {
  id           String    @id @default(cuid())
  projectId    String
  name         String
  slug         String
  description  String?
  startDate    DateTime?
  targetDate   DateTime?
  // LUM-714: milestone state collapsed to active/archived. There is no stored
  // status — "completed" is derived from task completion and materialized ONLY
  // as this timestamp (stamped by the rollup when the last open task lands,
  // cleared when a non-DONE task reappears). `archivedAt` is the one explicit
  // human state; everything else reads off these two columns.
  completedAt  DateTime?
  sortOrder    Float     @default(0)
  archivedAt   DateTime?
  // LUM-644: advisory token budget — Overview compares burn vs this and the
  // risk queue surfaces an over-budget alert; nothing is ever hard-gated on it.
  tokenBudget  Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // LUM-643/1135: explicit human override of the close gate. Stamped when a
  // human closes the milestone while milestone test cases still hold it.
  // Records the most recent override; never
  // auto-cleared, so the trail survives a later reopen.
  completedOverrideAt         DateTime?
  completedOverrideByMemberId String?
  completedOverrideNote       String?

  project               Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks                 Task[]
  summary               MilestoneSummary?
  // LUM-640: STEWARD (governance) sessions bound to this milestone.
  sessions              Session[]
  // LUM-640: steward-session implementation-artifact crossings recorded against
  // this milestone (no task to attach to — the steward session is task-less).
  boundaryCrossings     BoundaryCrossing[]
  // LUM-1135: milestone-level test cases — the close contract (exit criteria
  // were dropped in LUM-1141).
  testCases               TestCase[]
  testCaseRuns            TestCaseRun[]
  testCaseRunDispositions TestCaseRunDisposition[]
  // LUM-647: MILESTONE-scope memories distilled from this milestone's close retro.
  memories              Memory[]
  /// LUM-648: cross-milestone learning-migration edges. `asSource` = this
  /// milestone's distilled memory consumed elsewhere; `asConsumer` = prior
  /// milestones' memory this milestone's steward sessions consumed.
  memoryEdgesAsSource   MilestoneMemoryEdge[]    @relation("MilestoneMemoryEdgeSource")
  memoryEdgesAsConsumer MilestoneMemoryEdge[]    @relation("MilestoneMemoryEdgeConsumer")

  @@unique([projectId, slug])
  @@index([projectId])
  @@index([projectId, completedAt])
  @@index([projectId, sortOrder])
  @@index([projectId, archivedAt])
  @@map("milestones")
}

model SprintSummary {
  id          String   @id @default(cuid())
  sprintId    String   @unique
  stats       Json
  tldr        String
  report      String
  generatedAt DateTime @default(now())

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@map("sprint_summaries")
}

model MilestoneSummary {
  id          String   @id @default(cuid())
  milestoneId String   @unique
  stats       Json
  tldr        String
  report      String
  generatedAt DateTime @default(now())

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@map("milestone_summaries")
}

// ─── View system (Document / Kanban / future) ───────────────────────────────

model View {
  id          String   @id @default(cuid())
  workspaceId String // security boundary — always required
  projectId   String? // set for project-level views
  memberId    String? // set for personal views (My Tasks); null = workspace-shared view
  name        String
  type        ViewType
  config      Json     @default("{}")
  // config shape: { filters?: { projectIds?: string[], statuses?: string[], assigneeIds?: string[] } }
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  visibility        ViewVisibility @default(WORKSPACE)
  createdByMemberId String?

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project    Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member     WorkspaceMember? @relation("ViewOwner", fields: [memberId], references: [id], onDelete: Cascade)
  createdBy  WorkspaceMember? @relation("ViewCreator", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  taskOrders ViewTaskOrder[]
  sharedWith ViewMember[]

  @@index([workspaceId])
  @@index([projectId])
  @@index([memberId])
  @@map("views")
}

enum ViewMemberRole {
  VIEWER
  EDITOR
}

model ViewMember {
  id       String         @id @default(cuid())
  viewId   String
  memberId String
  role     ViewMemberRole @default(VIEWER)
  addedAt  DateTime       @default(now())

  view   View            @relation(fields: [viewId], references: [id], onDelete: Cascade)
  member WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([viewId, memberId])
  @@map("view_members")
}

model ViewTaskOrder {
  id       String @id @default(cuid())
  viewId   String
  taskId   String
  groupKey String
  order    Float

  view View @relation(fields: [viewId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([viewId, taskId])
  @@index([viewId, groupKey, order])
  @@map("view_task_orders")
}

// ─── Comments ────────────────────────────────────────────────────────────────

// A comment on a Task.
model Comment {
  id              String      @id @default(cuid())
  taskId          String
  authorActorId   String?
  body            String // HTML; @mentions encoded as data-id attributes
  parentId        String? // null = top-level; non-null = reply (max 1 level deep)
  quotedCommentId String? // which specific comment this reply is quoting
  type            CommentType @default(USER)

  /// LUM-783: content-level injection scan of this row's untrusted text,
  /// written at write time ({ counts, wrapperEscapes, total, scannedAt } —
  /// see shared/src/untrusted-content.ts). Null = clean or not yet scanned.
  /// Recorded on the SOURCE, never as a boundary crossing on the agent.
  contentSignals Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  task     Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author   Actor?             @relation("CommentAuthor", fields: [authorActorId], references: [id], onDelete: SetNull)
  parent   Comment?           @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[]          @relation("CommentReplies")
  mirror   PrCommentMirror?
  syncJobs PrCommentSyncJob[]

  @@index([taskId])
  @@index([parentId])
  @@index([authorActorId])
  @@map("comments")
}

model TaskActivity {
  id        String           @id @default(cuid())
  taskId    String
  actorId   String?
  type      TaskActivityType
  payload   Json?
  createdAt DateTime         @default(now())

  task  Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor Actor? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([taskId])
  @@map("task_activities")
}

/**
 * LUM-426/435 forbidden-action boundary-crossing. A marker is mirrored onto a
 * TaskActivity for the timeline; this row holds the MUTABLE disposition state
 * the DONE gate reads (TaskActivity is append-only and cannot). A crossing is
 * "open" while disposition is null — open crossings block DONE unless the
 * workspace toggle is off or a human dispositions it (FALSE_POSITIVE or
 * CONFIRMED both clear the gate). dispositionedById is a plain Actor id (no FK
 * back-relation — the disposition TaskActivity carries the human's actor for
 * rendering). reversible is set by the detector taxonomy; remediationTaskId
 * optionally links a follow-up fix task whose live status surfaces on the bar.
 */
model BoundaryCrossing {
  id                String                       @id @default(cuid())
  // LUM-1059: the human-readable ref `<TEAM>-X<number>`. `number` is allocated
  // from Workspace.crossingSeq inside the create transaction; `workspaceId` is
  // denormalised from the task (or the milestone's project) so the pair can be
  // unique. Nullable only for rows the backfill could not place — readers fall
  // back to the cuid. The cuid stays the key everywhere else.
  workspaceId       String?
  number            Int?
  // Nullable since LUM-640: a STEWARD_IMPLEMENTATION_ARTIFACT crossing has no
  // task — the steward session is milestone-bound, so the crossing attaches to
  // `milestoneId` instead. Every task-scoped detector still writes a taskId;
  // exactly one of taskId/milestoneId is set in practice.
  taskId            String?
  // LUM-640: the steward session's milestone, for crossings recorded during a
  // milestone-bound (STEWARD) session. Null on all task-scoped crossings.
  milestoneId       String?
  hookEventId       String?
  // The originating Claude Code session, when the crossing was recorded from a
  // path that has no hook event to attribute through (LUM-511 spinoff laundering
  // is detected on a `lumo task create` call, not an Edit/Bash hook). The LUM-469
  // attribution read model falls back to this session — owner/agent/worktree +
  // dominant model from its cumulative usageByModel — when hookEventId is null.
  // Null for hook-sourced crossings (they attribute via hookEventId) and legacy rows.
  sessionId         String?
  category          BoundaryCrossingCategory
  detail            String
  // Coalescing key (LUM-477): the specific target an OPEN crossing is deduped
  // on alongside (taskId, category) — the edited file for TEST_TAMPERING/secret,
  // the normalized command for action classes. Nullable: legacy rows have none
  // and simply never coalesce.
  target            String?
  // How many detections have coalesced into this OPEN crossing (LUM-477) — 1 for
  // a never-repeated crossing; a recurrence bumps it instead of inserting a row.
  occurrenceCount   Int                          @default(1)
  // When this crossing was last (re)detected (LUM-477) — null until it first
  // recurs; readers fall back to detectedAt.
  lastSeenAt        DateTime?
  detectedAt        DateTime                     @default(now())
  reversible        Boolean                      @default(false)
  severity          BoundaryCrossingSeverity     @default(MEDIUM)
  disposition       BoundaryCrossingDisposition?
  dispositionNote   String?
  dispositionedAt   DateTime?
  dispositionedById String?
  remediationTaskId String?
  // LUM-542: when the agent was first reminded (via the next hook's stdout) that
  // this crossing exists and can be explained. Set once, the first time a
  // reminder is emitted, so the reminder fires exactly once per crossing and a
  // later hook never re-nags. Null = not yet reminded; orthogonal to disposition
  // and the DONE gate (which key only on `disposition`).
  agentNotifiedAt   DateTime?
  advisory          Boolean                      @default(false) // LUM-590: semantic finding — surfaced, never blocks DONE
  policyRuleRef     String? // LUM-590: which compiled PolicyRule fired (text/id)
  policyRuleText    String? // LUM-590: frozen verbatim text of the rule at detection time
  // LUM-590: lazy-cached SYSTEM-generated plain-language explanation. Generated
  // the first time a human clicks "Explain" in the panel; null = not yet generated.
  // Advisory only — never touches disposition or the DONE gate.
  systemExplanation String?
  // LUM-751: the suppression rule that auto-dispositioned this crossing
  // (disposition = AUTO_SUPPRESSED). Null for every other crossing.
  suppressionRuleId String?
  // LUM-912: when the raw text (detail, target, explanations, timeline
  // copies) was replaced by a code-free description, N days after the
  // disposition. Null = still whole.
  rawPurgedAt       DateTime?
  // LUM-945: the AI triage pass (rules detect, a model then reads the task
  // context). P(legit) as the model returned it, which model, and when.
  // Null = not triaged yet. A score at or above the threshold also stamps the
  // system disposition AUTO_LEGIT (no human actor); below it the row stays OPEN.
  triageProbability Float?
  triageModel       String?
  triagedAt         DateTime?

  task            Task?                         @relation("CrossingTask", fields: [taskId], references: [id], onDelete: Cascade)
  milestone       Milestone?                    @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  remediationTask Task?                         @relation("CrossingRemediation", fields: [remediationTaskId], references: [id], onDelete: SetNull)
  suppressionRule CrossingSuppressionRule?      @relation(fields: [suppressionRuleId], references: [id], onDelete: SetNull)
  // LUM-542: append-only agent self-explanations ("申辩"). A purely additive
  // annotation layer — never read by the DONE gate, never a disposition.
  explanations    BoundaryCrossingExplanation[]

  @@index([taskId, disposition])
  // Supports the LUM-477 open-crossing coalescing lookup (taskId, category, target).
  @@index([taskId, category, target])
  // LUM-640: milestone-scoped coalescing lookup for steward-session crossings.
  @@index([milestoneId, category, target])
  @@index([suppressionRuleId])
  // LUM-912: the raw-retention sweep's candidate scan.
  @@index([rawPurgedAt, dispositionedAt])
  // LUM-945: the triage sweep's candidate scan (open, not yet triaged).
  @@index([triagedAt, disposition])
  @@unique([workspaceId, number])
  @@map("boundary_crossings")
}

/**
 * LUM-542: an append-only agent self-explanation ("申辩") attached to a
 * BoundaryCrossing. When a crossing is detected the agent gets one reminder and
 * may record why it took the action; the note is shown to the human reviewer at
 * disposition time and kept for later review, but is **never** a disposition and
 * never touches the DONE gate. Rows are insert-only — there is deliberately no
 * update or delete path (a correction is a new row, so prior wording survives).
 * `authorSessionId` / `authorAgent` carry attribution (the originating Claude
 * Code session and its agent type); both nullable for resilience. The note is
 * untrusted free text — every render boundary sanitizes it.
 */
model BoundaryCrossingExplanation {
  id              String   @id @default(cuid())
  crossingId      String
  note            String
  authorSessionId String?
  authorAgent     String?
  createdAt       DateTime @default(now())

  crossing BoundaryCrossing @relation(fields: [crossingId], references: [id], onDelete: Cascade)

  @@index([crossingId, createdAt])
  @@map("boundary_crossing_explanations")
}

// ── LUM-732: PR security scan ───────────────────────────────────────────────
// One scan per (pullRequestId, headSha). Findings are the scan's children.
// Secrets are NEVER stored raw — `evidence` is redacted before the row is
// written, `fingerprint` is a truncated sha256 used only for cross-push
// disposition inheritance.

enum PrSecurityScanStatus {
  PENDING
  RUNNING
  CLEAN
  FINDINGS
  FAILED
}

enum PrSecurityScanTrigger {
  PR_EVENT
  PR_LINK
  // LUM-735: scan row created by a CI SARIF push before any webhook ran.
  SARIF_PUSH
}

enum PrSecurityJudgeStatus {
  RAN
  UNAVAILABLE
  SKIPPED
}

enum PrSecurityFindingKind {
  SECRET
  VULNERABILITY
  // LUM-738: a vulnerable dependency reported by osv-scanner (no line-level diff).
  DEPENDENCY
  // LUM-988: a non-security finding from the AI review (logic bug, error
  // handling, doc mismatch, weak test…). Always LLM_JUDGE, so never blocking.
  CORRECTNESS
  // LUM-1234: a reward-hack a session left in the PR (LLM_JUDGE, advisory only).
  REWARD_HACK
}

enum PrSecurityFindingSeverity {
  LOW
  MEDIUM
  HIGH
}

enum PrSecurityFindingProvenance {
  DETERMINISTIC
  LLM_JUDGE
  EXTERNAL_TOOL
}

// LUM-1127: where a Lumo inline comment's GitHub thread stands.
enum PrFindingThreadState {
  // Posted, unresolved on GitHub.
  OPEN
  // Lumo resolved it: a complete pass of the producing layer no longer
  // reports the fingerprint (`addressedInSha` says on which head).
  ADDRESSED
  // A human resolved it on GitHub. Not re-posted; a gate-blocking finding
  // still blocks DONE until it is dispositioned in Lumo.
  RESOLVED_BY_USER
  // The verifier rejected the finding; the comment was retracted.
  DISMISSED
}

// LUM-1127: one row per (PR, finding fingerprint) Lumo commented on inline —
// the durable identity of the GitHub review thread across head commits, so a
// later scan can resolve it as addressed, honour a human resolve, and reopen
// it on regression (the usual review-thread lifecycle). Findings themselves stay
// per scan (`PrSecurityFinding`); the thread is per PR.
/// LUM-1133 — per-repository automatic PR review settings for a workspace
/// (auto-review filters: enabled, drafts). No row = the defaults:
/// every PR of a confirmed repository is reviewed, drafts are skipped until
/// they are marked ready. Governs PRs without a Lumo task; task-linked PRs keep
/// their scan (the DONE gate's evidence).
model RepositoryReviewSetting {
  id           String   @id @default(cuid())
  workspaceId  String
  /// Lower-cased `owner/name`.
  repo         String
  autoReview          Boolean  @default(true)
  reviewDrafts        Boolean  @default(false)
  /// LUM-1143 — per-repository auto-review filters (precedence in
  /// ee/security/security-scan/auto-review-policy.ts). Regexes on the PR's
  /// base branch; the default branch is always included.
  baseBranches        String[] @default([])
  /// What an EMPTY `baseBranches` reviews: `all_branches` (repositories
  /// connected before LUM-1143, backfilled) or `default_branch_only` (newly
  /// connected repositories).
  emptyBaseBranchesMeans String  @default("default_branch_only")
  /// `label` = review only PRs carrying one (opts in when autoReview is
  /// off); `!label` = skip PRs carrying it.
  labels              String[] @default([])
  /// Case-insensitive substrings of the PR title that skip the review.
  ignoreTitleKeywords String[] @default([])
  /// Exact, case-sensitive author logins never auto-reviewed.
  ignoreUsernames     String[] @default([])
  /// With autoReview off: PRs whose description contains this are reviewed.
  descriptionKeyword  String?
  /// Globs over changed paths for the AI review and hunt (`!glob`
  /// excludes), on top of the built-in lockfile / generated exclusions.
  pathFilters         String[] @default([])
  /// LUM-1148 — the pre-merge checks: { title: { mode, requirements },
  /// description: { mode }, customChecks: [{ name, mode, instructions }],
  /// overrideRequestedReviewersOnly } (ee/security/security-scan/
  /// pre-merge-checks.ts). null = the defaults.
  preMergeChecks      Json?
  /// LUM-1147 — review style. `[{ path, instructions }]`: extra review
  /// instructions for files matching `path` (glob), sent to the AI review.
  pathInstructions    Json     @default("[]")
  /// quiet | chill | assertive — which findings get inline comments
  /// (ee/security/security-scan/review-profile.ts).
  reviewProfile       String   @default("chill")
  /// ≤250 chars: how the AI review words its findings. null = none.
  toneInstructions    String?
  /// LUM-1151 — where the high-level summary goes: description | comment
  /// | off (ee/security/security-scan/pr-description-summary.ts).
  highLevelSummary    String   @default("description")
  /// LUM-1155 — a sequence diagram of the PR's call flow in the summary
  /// comment's walkthrough (ee/security/security-scan/sequence-diagram.ts).
  sequenceDiagrams    Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, repo])
  @@map("repository_review_settings")
}

model PrFindingThread {
  id              String                      @id @default(cuid())
  pullRequestId   String
  workspaceId     String
  fingerprint     String
  // GitHub REST id of Lumo's inline comment (the thread's first comment).
  commentId       String
  // GraphQL node id of the review thread; null until first read back.
  threadNodeId    String?
  state           PrFindingThreadState        @default(OPEN)
  // The finding's layer, kept so an absent fingerprint can still be judged
  // against the layer that produced it.
  ruleId          String
  provenance      PrSecurityFindingProvenance
  kind            PrSecurityFindingKind
  filePath        String
  resolvedByLogin String?
  resolvedAt      DateTime?
  addressedInSha  String?
  // LUM-1131: GitHub REST id of the last human reply Lumo answered in this
  // thread — a redelivered webhook for the same reply is not answered twice.
  lastReplyId     String?
  // LUM-1127 follow-up #2: the identity of the finding the thread stands for
  // (its own, or the relabelled one it was carried to), kept here because a
  // full re-review of the same head replaces the scan's finding rows. No code
  // is stored: the quoted line and the title words are HMAC-hashed with a
  // server key (tagged with its key id). identityRuleId null = not recorded.
  identityRuleId       String?
  identityLine         Int?
  identitySeverity     PrSecurityFindingSeverity?
  identityEvidenceHash String?
  identityTitleTokens  String[]                    @default([])
  // LUM-1127 follow-up #3: the fingerprints this thread was carried to (the
  // same issue relabelled by a later review), oldest first. `fingerprint`
  // stays the thread's original (dispositions / learnings look it up); a
  // finding under any of these already has this thread — never a new comment.
  aliasFingerprints    String[]                    @default([])
  // LUM-1127 follow-up #4: every identity the thread has carried (the union,
  // never overwritten; capped) as [{ ruleId, line, evidenceHash, titleTokens,
  // crowded? }] — hashes only, same key as above. A new finding is matched
  // against the best of them, so one later rewording never decides alone.
  identityHistory      Json                        @default("[]")
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@unique([pullRequestId, fingerprint])
  @@index([pullRequestId, state])
  @@map("pr_finding_threads")
}

// LUM-1131: a repository-scoped learning from a human reply in one of Lumo's
// finding threads ("this is intentional because …"). The text lives in the
// linked Memory row (PROJECT / CONVENTION) — that is where people read, edit
// and delete it; this row only says which repository (and optional path glob)
// the AI review applies it to. Deleting the memory deletes the learning.
model PrReviewLearning {
  id                  String   @id @default(cuid())
  workspaceId         String
  memoryId            String   @unique
  // "owner/name", as on PullRequest.repo.
  repo                String
  // null = the whole repository.
  pathGlob            String?
  ruleId              String
  fingerprint         String
  // The PR the reply was written on (no FK: the learning outlives the PR row).
  sourcePullRequestId String?
  // GitHub REST id of the human reply the learning came from.
  sourceReplyId       String
  authorLogin         String
  // Learnings scope: a learning applies only to its source PR until that
  // PR merges; set when the merge is seen. Readers also treat a merged
  // source PR as repository-wide (a missed merge event changes nothing).
  repoWideAt          DateTime?
  createdAt           DateTime @default(now())

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, sourceReplyId])
  @@index([workspaceId, repo])
  @@index([sourcePullRequestId])
  @@map("pr_review_learnings")
}

// LUM-1259: who ran a logged local scan — a person at a terminal, or a
// coding agent (Claude Code / Codex session variable present).
enum LocalScanActor {
  USER
  AGENT
}

// LUM-1259: what ran the logged scan.
enum LocalScanTrigger {
  // the post-commit hook, with the real sha
  POST_COMMIT
  // the pre-push hook, once per commit in the pushed range
  PRE_PUSH
  // `lumo security scan --log` by hand
  MANUAL
}

// LUM-1259: one local `lumo security scan` of ONE commit (its first parent ->
// the commit), reported by the CLI when the workspace opted in
// (Workspace.securityLocalScanLogEnabled). Client-reported and labelled LOCAL:
// nothing proves a clean local scan happened, and nothing here feeds or
// clears the DONE gate (that stays PrSecurityScan). Holds no code, no raw
// secret, no evidence beyond the scanner's redacted title, and never a commit
// message. `patchId` (`git patch-id --stable`) is what ties a commit to its
// amended / rebased successors; a PR head finds its local history by sha or
// patch-id.
model LocalScanRun {
  id             String           @id @default(cuid())
  workspaceId    String
  // "owner/name", as on PullRequest.repo (a repository of this workspace).
  repo           String
  commitSha      String
  // The first parent; null for a root commit.
  parentSha      String?
  // `git patch-id --stable` of parent -> commit; null when the diff is empty.
  patchId        String?
  // The branch checked out when the scan ran; null on a detached HEAD.
  branch         String?
  // The coding-agent session that ran it (Session.id, checked to belong to
  // this workspace) and the task that session was bound to. No FK: the log
  // outlives a deleted task or session.
  sessionId      String?
  taskId         String?
  actor          LocalScanActor
  // WorkspaceMember whose CLI key uploaded it.
  memberId       String
  trigger        LocalScanTrigger
  // The local scanners that ran (e.g. ["SECRETS"]).
  scanners       String[]
  // e.g. "secrets@1", as PrSecurityScan.detectorVersion names a scanner.
  scannerVersion String
  // The @lumoai/cli version; null when the CLI could not tell.
  cliVersion     String?
  filesScanned   Int
  findingCount   Int
  // sha256 over scanners, scanner version and the sorted findings
  // (fingerprint, rule, file, line, label): an identical rerun of the same
  // commit is the same row (dedupe), a changed result is a new row.
  resultKey      String
  // When the CLI ran the scan (client clock); createdAt is when it arrived
  // (a queued offline upload arrives later).
  scannedAt      DateTime
  createdAt      DateTime         @default(now())

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  findings  LocalScanFinding[]

  @@unique([workspaceId, repo, commitSha, resultKey])
  @@index([workspaceId, repo, patchId])
  @@index([workspaceId, createdAt])
  @@map("local_scan_runs")
}

// LUM-1259: one finding of a logged local scan. Fingerprint, rule, position
// and the scanner's own redacted title only — never the matched value, never
// the evidence line.
model LocalScanFinding {
  id          String                    @id @default(cuid())
  runId       String
  // e.g. "SECRETS".
  scanner     String
  // The server's fingerprint (a truncated hash of rule + value).
  fingerprint String
  ruleId      String
  severity    PrSecurityFindingSeverity
  filePath    String
  line        Int
  // The scanner's title, redacted again on the server.
  title       String
  // The server's reading when the scan ran (NEW | ON_MAIN | FALSE_POSITIVE |
  // ACCEPTED_RISK | LEARNING); null when it ran without server context.
  label       String?

  run LocalScanRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("local_scan_findings")
}

// LUM-1154: a question a human asked Lumo on a pull request — a reply in a
// Lumo finding thread, an @-mention on a code line, or an @-mention in the PR
// conversation. One row per GitHub comment: the claim that keeps a
// redelivered webhook from answering twice, and the count that bounds how
// many answers one PR gets per hour. Holds no question or answer text.
model PrChatRequest {
  id            String   @id @default(cuid())
  workspaceId   String
  pullRequestId String
  // "review" (a review-line comment) or "issue" (a PR conversation comment):
  // GitHub numbers the two kinds separately.
  source        String
  // GitHub REST id of the human's comment.
  commentId     String
  authorLogin   String
  // CLAIMED → ANSWERED | RATE_LIMITED | FAILED.
  status        String   @default("CLAIMED")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, source, commentId])
  @@index([pullRequestId, createdAt])
  @@map("pr_chat_requests")
}

enum PrSecurityFindingDisposition {
  FALSE_POSITIVE
  ACCEPTED_RISK
}

// LUM-739: can an entry point reach the sink without passing a control?
enum PrSecurityReachability {
  EXTERNAL
  INTERNAL
  UNKNOWN
}

// LUM-988: the AI review's agentic verifier, per LLM_JUDGE finding. REJECTED
// rows stay stored and visible in Lumo but get no inline PR comment and are
// not counted as open; a finding with no verdict (not verified) behaves as today.
enum PrSecurityVerifierVerdict {
  CONFIRMED
  REJECTED
}

// LUM-739: the falsifier can only refute or fail to refute — never confirm.
enum PrSecurityFalsifierVerdict {
  REJECT
  INCONCLUSIVE
}

// LUM-758 follow-up: why a deterministic secret hit was lowered to LOW. Mirrors
// `SecretDowngradeReason` in lib/security-scan/types.ts — the scanner is the
// only writer. Downgrading is never suppression: the row is still reported, so
// a reader needs the cause to tell "recognised placeholder" from "real leak".
enum PrSecuritySecretDowngrade {
  PLACEHOLDER_VALUE
  DOWNGRADED_PATH
}

// LUM-740: what a human did with an LLM-suggested disposition — confirmed it
// (chose the suggested disposition) or overruled it (chose another). The
// pair (suggestedDisposition, suggestionOutcome) is the judge-precision data
// of spec §12 R2.
enum PrSecuritySuggestionOutcome {
  CONFIRMED
  OVERRULED
}

/// LUM-1150 follow-up — at most one write-back at a time may CREATE a PR's
/// security summary comment. Two syncs that both found no summary (e.g. the
/// hunt and the verifier finishing together) each created one; the second
/// stayed stale. A row is a held claim; `claimedAt` doubles as the holder's
/// token, so a release never drops a claim a later writer took over. A claim
/// older than the TTL belongs to a writer that died and is taken over. One
/// row per PullRequest row (= per workspace, LUM-924).
model PrSecuritySummaryClaim {
  pullRequestId String      @id
  claimedAt     DateTime
  pullRequest   PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@map("pr_security_summary_claims")
}

model PrSecurityScan {
  id                String                 @id @default(cuid())
  pullRequestId     String
  // The PR's task at scan time (denormalised for per-task reads); SetNull.
  taskId            String?
  workspaceId       String
  headSha           String
  status            PrSecurityScanStatus   @default(PENDING)
  trigger           PrSecurityScanTrigger
  judgeStatus       PrSecurityJudgeStatus?
  // The diff exceeded the judge budget — the LLM pass saw only a prefix.
  truncated         Boolean                @default(false)
  // LUM-814: the judge's budget arithmetic — { diffChars, tierChars,
  // reviewedChars, coveredFiles, droppedFiles }. null = not recorded (a row
  // written before this column, or a scan whose judge never reached the
  // budget step). null is NOT zero: `truncated` alone cannot tell a PR that
  // spent 2% of its tier from one that spent 98%.
  judgeBudget       Json?
  // LUM-849: the judge's description of the PR — { intent, changes[] }, from
  // the same call that looks for vulnerabilities; already redacted and
  // neutralised (lib/security-scan/pr-summary.ts). null = the judge did not
  // run on this head (skipped, over its size cap, unavailable) or an older row.
  prSummary         Json?
  // LUM-735: per-layer outcome { secrets|external|supplyChain|judge|hunt:
  // RAN|FAILED|SKIPPED|NOT_CONFIGURED|PARTIAL }. null on rows written before
  // this column existed — the service derives a legacy view from judgeStatus.
  stages            Json?
  // LUM-735: some layer hit its budget/cap; the scan is honest but not whole.
  // LUM-832: kept as the monotone OR of `partialCauses` (older readers and
  // pre-LUM-832 rows); a row with `partial` and no cause is unattributed.
  partial           Boolean                @default(false)
  // LUM-832: WHY the scan is not whole — one entry per set point, from the
  // closed list `PARTIAL_CAUSES` in shared/src/security-scan.ts (text, not a
  // PG enum, so a new cause needs no enum migration). Each cause is classed
  // as our fault or coverage still owed; neither is ever the customer's.
  // Union across writers, like `partial`.
  partialCauses     String[]               @default([])
  // LUM-1328: the agent reviews (`lumo review import`, slugs `claude-code` /
  // `codex`) imported into this head — kept even when an import had zero
  // findings, so `lumo task status` can tell a clean review from none.
  agentReviewTools  String[]               @default([])
  // e.g. "secrets@1;judge@1" — lets a later detector bump decide to rescan.
  detectorVersion   String
  error             String?
  startedAt         DateTime               @default(now())
  finishedAt        DateTime?
  // LUM-737: when the agent was first reminded (via the next PreToolUse hook)
  // that this scan carries undispositioned findings. Set once per scan row so
  // the reminder fires exactly once; null = not yet reminded. Orthogonal to
  // disposition and the DONE gate (which key only on the findings).
  agentNotifiedAt   DateTime?
  // LUM-739: tokens the L3 hunt + falsifier spent on this scan. null = not
  // metered (team rule: null ≠ 0).
  tokenSpent        Int?
  // LUM-739: { candidates, rejected: [{ reason, category, sink }],
  // falsifierRejects, falsifierRejected, categories, subgraph, error? }.
  huntAudit         Json?
  // LUM-1234: reward-hack layer state (cost caps, truncation, session coverage).
  rewardHackState   Json?
  // LUM-745: the Vercel Workflow run id of the Lumo-managed scan stage A
  // started for this row; null = no managed run (BYO, disabled, or start()
  // failed). Read by supersede / the 45-min sweep (cancel + stop) and by the
  // per-workspace hourly cap (count).
  managedRunId      String?
  // LUM-740: the GitHub issue-comment id of the per-PR summary this scan
  // last wrote (or reused from an earlier scan of the same PR). The
  // write-back upserts by this id, so concurrent writers converge on ONE
  // summary; null until the first create.
  summaryCommentId  String?
  // LUM-740: when the suggested-disposition pass finished for this scan
  // (null = not yet). The PR write-back holds EXTERNAL_TOOL inline comments
  // until then, so a concurrent hunt sync cannot post rows the pass is about
  // to mark as suggested false positives.
  suggestedAt       DateTime?
  // LUM-988: the agentic verifier's run for this scan. Started = the PR
  // write-back holds LLM_JUDGE inline comments (up to VERIFIER_HOLD_MS);
  // verifiedAt = it finished (with or without verdicts), so they post.
  verifierStartedAt DateTime?
  verifiedAt        DateTime?
  // LUM-740: tokens the suggested-disposition pass spent (own column — the
  // hunt owns `tokenSpent` and overwrites it). null = not metered.
  suggestionTokens  Int?
  // LUM-822: the hunt's own run bookkeeping, so a hunt that never reports can
  // be retried once and then failed by the stale-hunt sweep. `huntJob` is the
  // HuntJob stage A started with (null = no hunt, or a row from before this
  // column — such a row is failed, never retried); `huntAttempts` counts
  // starts (0 on older rows); `huntStartedAt` is when the latest one began.
  // A hunt write carrying an attempt older than `huntAttempts` is dropped.
  huntJob           Json?
  huntRunId         String?
  huntAttempts      Int                    @default(0)
  huntStartedAt     DateTime?
  // LUM-911: when the code fields were last scrubbed (any path: retention,
  // uninstall, unconfirmed repository). null = still holds what it wrote.
  codeScrubbedAt    DateTime?
  // LUM-911: does the retention sweep look at this scan? Rows from before
  // LUM-911 are false (the backlog is a separate task); new rows are true.
  retentionTracked  Boolean                @default(true)
  // LUM-1127: the paths the AI review (judge) read on this head when the
  // round was incremental — `["a.ts", …]`; null = the whole PR diff (or a row
  // from before this column). The PR write-back resolves a judge finding's
  // thread as addressed only when its file was in this scope.
  judgeReviewScope  Json?
  // LUM-1152 follow-up: how the AI review on this head was asked for —
  // "full" (a requested full review) or "incremental" (automatic, or a
  // requested incremental one); null = the AI review did not run here (or a
  // row from before this column). A deferred full review is satisfied only
  // by a "full" one.
  judgeReviewMode   String?
  // LUM-1146: how the repository config file (`.lumo.yaml`) was read for
  // this scan — { baseRef, base: { status, sha, problems, unknownKeys },
  // prBranch } (ee/security/security-scan/repo-config.ts). The PR summary
  // reports an invalid / unreadable file and ignored keys from it. null =
  // not read (a row from before this column, or the scan stopped earlier).
  repoConfig        Json?
  // LUM-1148: the pre-merge checks' results on this head — { headSha, ranAt,
  // results: [{ id, name, kind, mode, verdict, explanation, resolution }] }
  // (ee/security/security-scan/pre-merge-checks.ts). null = no check ran.
  preMergeChecks    Json?
  // LUM-1147: the review profile in force when the scan ran (quiet | chill
  // | assertive) — which findings the write-back comments inline. null =
  // chill (rows from before this column).
  reviewProfile     String?
  // LUM-1151: where the high-level summary goes for this scan's review
  // (description | comment | off). null = description (rows from before
  // this column).
  highLevelSummary  String?
  // LUM-1155: the cleaned call-flow diagram ({ participants, steps }) the
  // walkthrough renders as Mermaid. null = none (off, trivial PR, none
  // drawn). Model-written over the diff: scrubbed with prSummary.
  sequenceDiagram   Json?
  // LUM-1215: what the path filters left out of the AI review on this head —
  // { builtIn: { count, paths[≤20] }, configured: { count } }
  // (ee/security/security-scan/reviewable-path.ts). The summary names the
  // built-in skips so a default never hides a file silently. null = nothing
  // skipped, or a row from before this column. Paths only, never content.
  reviewPathSkips   Json?

  pullRequest PullRequest         @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  task        Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  findings    PrSecurityFinding[]

  @@unique([pullRequestId, headSha])
  @@index([taskId])
  @@index([workspaceId, startedAt])
  @@index([startedAt])
  // LUM-988: the stale verifier-hold sweep (`findStaleVerifierHolds`) runs
  // every 15 min on verifiedAt IS NULL AND verifierStartedAt < cutoff.
  @@index([verifiedAt, verifierStartedAt])
  @@map("pr_security_scans")
}

model PrSecurityFinding {
  id                     String                        @id @default(cuid())
  scanId                 String
  kind                   PrSecurityFindingKind
  // secret:<pattern-id> | vuln:<kind> | ext:<tool>
  ruleId                 String
  severity               PrSecurityFindingSeverity
  provenance             PrSecurityFindingProvenance
  filePath               String
  // New-file line number; null when the LLM judge could not place it.
  line                   Int?
  title                  String
  detail                 String
  // Redacted triggering line — the raw secret never reaches this column.
  evidence               String
  fingerprint            String
  // EXTERNAL_TOOL only: the rule's helpUri from the SARIF the repo's CI pushed (LUM-735).
  externalRef            String?
  disposition            PrSecurityFindingDisposition?
  dispositionNote        String?
  dispositionedById      String?
  dispositionedAt        DateTime?
  // Set when the disposition was copied from an earlier finding with the same
  // fingerprint on the same PR (cross-push inheritance).
  inheritedFromFindingId String?
  // LUM-740 (EXTERNAL_TOOL rows): the falsifier REJECTed the finding, so a
  // FALSE_POSITIVE disposition is *suggested* with its reason — `disposition`
  // itself is never written by the LLM. `suggestionOutcome` records the
  // human's decision on the suggestion (confirm / overrule) for R2.
  suggestedDisposition   PrSecurityFindingDisposition?
  suggestedReason        String?
  suggestionOutcome      PrSecuritySuggestionOutcome?
  // LUM-739 (hunt:* rows only): CWE id, entry-reachability of the sink, the
  // symbol-level call chain [{ from, to }] (no code), and the falsifier's
  // verdict — always INCONCLUSIVE on a persisted row (REJECTs never land).
  cwe                    String?
  reachability           PrSecurityReachability?
  callChain              Json?
  falsifierVerdict       PrSecurityFalsifierVerdict?
  // LUM-988: the agentic verifier's verdict on an LLM_JUDGE row, and its
  // one-sentence reason (model text, redacted before storage).
  verifierVerdict        PrSecurityVerifierVerdict?
  verifierReason         String?
  // LUM-738: the same fingerprint is already on the default branch's security
  // baseline (ProjectRepository.securityBaseline) — this PR did not introduce
  // it. Advisory: rendered muted, excluded from open/reminder counts.
  persisting             Boolean                       @default(false)
  // LUM-758 follow-up (secret: rows only): WHY the severity was lowered to LOW.
  // The scanner already computes it; persisting it is what lets the reminder
  // and `lumo task status` say *why* a row is advisory, instead of a
  // recognised placeholder in a test fixture reading as an unexplained
  // credential. Null on every non-secret row and on a hit that was not
  // downgraded — never inferred from `detail` (see SecretDowngradeReason).
  secretDowngrade        PrSecuritySecretDowngrade?
  // LUM-1150 (LLM_JUDGE rows only): the one-click fix the inline comment
  // carries as a GitHub suggestion block — { startLine, endLine, code },
  // validated against this head's added lines before it is stored. Model
  // output about customer code: scrubbed with the other code fields.
  codeSuggestion         Json?
  // LUM-1147 (LLM_JUDGE rows only): the glob of the repository path
  // instruction this finding applies — the model's claim, kept only when that
  // instruction was sent for this finding's file. Such a finding is commented
  // inline under chill and assertive whatever its severity (quiet: summary).
  pathInstruction        String?
  // LUM-1150: when a PR write-back claimed this row's inline comment. Every
  // writer of a scan (stage A, hunt, managed run, verifier) syncs it, often
  // at the same moment; each claims a row before posting it, so only one of
  // them posts. A claim older than the sync's TTL can be taken over (a
  // writer that died between claiming and posting).
  inlineCommentClaimedAt DateTime?
  createdAt              DateTime                      @default(now())

  scan PrSecurityScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([fingerprint])
  @@index([scanId, provenance, severity])
  @@map("pr_security_findings")
}

// ─── Notifications ───────────────────────────────────────────────────────────

model Notification {
  id                String           @id @default(cuid())
  workspaceId       String
  recipientActorId  String // Actor.id — who receives this notification
  type              NotificationType
  taskId            String?
  commentId         String? // set for TASK_MENTIONED — scroll to comment
  clarifyId         String? // set for AGENT_CLARIFY — link to AgentClarify
  sprintId          String?
  documentId        String?
  documentCommentId String?
  projectId         String?
  milestoneId       String?
  triggerActorId    String? // Actor.id — who/what triggered it; null for system
  read              Boolean          @default(false)
  requiresAction    Boolean          @default(false) // AGENT_CLARIFY / AGENT_AUTHORIZE / AGENT_VERIFY
  actionTakenAt     DateTime? // when the user responded to an actionable notification
  createdAt         DateTime         @default(now())

  recipient Actor  @relation("NotificationRecipient", fields: [recipientActorId], references: [id], onDelete: Cascade)
  trigger   Actor? @relation("NotificationTrigger", fields: [triggerActorId], references: [id], onDelete: SetNull)

  @@index([recipientActorId, read])
  @@index([recipientActorId, requiresAction, actionTakenAt]) // pending action queries
  @@map("notifications")
}

model GitHubIntegration {
  id            String   @id @default(cuid())
  workspaceId   String
  memberId      String
  accessToken   String // AES-256-GCM encrypted: "iv:authTag:ciphertext" (hex)
  tokenType     String   @default("oauth")
  githubUserId  String
  githubLogin   String
  repositories  String[]
  webhookSecret String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member       WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  webhooks     GitHubWebhook[]
  pullRequests PullRequest[]

  @@unique([workspaceId, memberId])
  @@index([workspaceId])
  @@map("github_integrations")
}

model GitHubWebhook {
  id            String @id @default(cuid())
  integrationId String
  repo          String // "owner/repo"
  githubHookId  Int // GitHub's webhook ID, needed for deletion

  createdAt DateTime @default(now())

  integration GitHubIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, repo])
  @@index([repo])
  @@map("github_webhooks")
}

model GitHubAppInstallation {
  id                  String           @id @default(cuid())
  workspaceId         String           @unique
  installationId      Int
  accountLogin        String?
  accountType         String?
  repositories        String[]
  installedBy         String?
  installer           WorkspaceMember? @relation("GitHubAppInstaller", fields: [installedBy], references: [id], onDelete: SetNull)
  /// LUM-882 — GitHub login of whoever last bound or re-verified this
  /// installation. An identifier, not a credential: the daily access recheck
  /// asks GitHub (with the installation token) whether this login can still
  /// read each confirmed repository. Null on rows bound before LUM-882 —
  /// those are not rechecked until an owner re-verifies once.
  verifierLogin       String?
  /// LUM-882 — repositories the last automatic recheck removed because the
  /// verifier lost read access, and when. Cleared by the next re-verification.
  accessRemovedCount  Int              @default(0)
  accessRemovedAt     DateTime?
  /// LUM-882 — resume point for a recheck the rate-limit budget cut short:
  /// the next run starts after this repository (case-insensitive order).
  accessCheckCursor   String?
  /// LUM-888 — the verifier's immutable GitHub user id. The recheck resolves
  /// the current login from it, so a rename is followed and a login someone
  /// else registers later is never asked about. Null on rows verified before
  /// LUM-888 until the recheck (or a re-verification) records it.
  verifierGithubId    Int?
  /// LUM-888 — when this verifier's list was last confirmed (bind or
  /// re-verification). The recheck's version: any re-verification, even by
  /// the same login, discards a result computed against an older one.
  verifiedAt          DateTime?
  /// LUM-888 — when the automatic recheck last finished a pass on this row;
  /// the daily sweep starts with the longest-waiting installation.
  accessCheckedAt     DateTime?
  /// LUM-888 — why the last automatic removal happened: `access_lost` (the
  /// verifier can no longer read them) or `account_gone` (the verifying
  /// GitHub account no longer exists). Cleared with the removal notice.
  accessRemovedReason String?
  /// LUM-927 — first daily recheck in the current run of failures to mint a
  /// token while GitHub still reports the installation active (e.g. new
  /// permissions not yet accepted). Cleared by the next successful mint;
  /// past three days it raises an ops alert and a notice on the settings card.
  tokenFailingSince   DateTime?
  /// LUM-1330 — repositories renamed while confirmed here: old `owner/name`
  /// (lower-cased) → the name it was renamed to. Written with every rename
  /// (LUM-879) so a CLI whose git remote still has the old name finds the
  /// repository; a name that is confirmed again is never redirected.
  repositoryAliases   Json             @default("{}")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([installationId])
  @@map("github_app_installations")
}

/// LUM-1315 — a workspace's Codeup (Alibaba Cloud Yunxiao, center edition)
/// connection. Codeup has no app identity: every API call runs as the owner
/// of the personal access token, which is stored encrypted and never returned.
model CodeupConnection {
  id             String           @id @default(cuid())
  workspaceId    String           @unique
  organizationId String
  accessToken    String // AES-256-GCM encrypted: "iv:authTag:ciphertext" (hex)
  connectedBy    String?
  connector      WorkspaceMember? @relation("CodeupConnector", fields: [connectedBy], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repositories CodeupRepository[]

  @@index([organizationId])
  @@map("codeup_connections")
}

/// LUM-1315 — a Codeup repository a workspace confirmed. Each confirmation
/// creates the workspace's own repository webhook with its own random token
/// (stored as a SHA-256 hash), so a delivery authenticates to exactly one
/// workspace even when several confirmed the same repository (LUM-924).
model CodeupRepository {
  id                String    @id @default(cuid())
  connectionId      String
  /// Codeup's numeric repository id (`project_id` in webhook payloads).
  repositoryId      Int
  /// Full path, nested groups included (`org/group/sub/repo`).
  pathWithNamespace String
  webUrl            String
  webhookId         Int?
  webhookTokenHash  String
  /// null = no longer confirmed: deliveries still authenticate but are ignored.
  confirmedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  connection CodeupConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, repositoryId])
  @@index([repositoryId])
  @@map("codeup_repositories")
}

model SlackIntegration {
  id            String           @id @default(cuid())
  workspaceId   String           @unique
  installedBy   String?
  installer     WorkspaceMember? @relation("SlackInstaller", fields: [installedBy], references: [id], onDelete: SetNull)
  accessToken   String
  slackTeamId   String
  slackTeamName String
  slackUserId   String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channels  SlackChannel[]

  @@index([slackTeamId])
  @@map("slack_integrations")
}

model SlackChannel {
  id            String   @id @default(cuid())
  integrationId String
  channelId     String
  channelName   String
  events        String[]
  projectId     String?
  createdAt     DateTime @default(now())

  integration SlackIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([integrationId])
  @@index([projectId])
  @@map("slack_channels")
}

model PullRequest {
  id             String    @id @default(cuid())
  // LUM-1056: durable automatic-review budget; reservations survive retries.
  reviewPaused   Boolean   @default(false)
  reviewHeads    String[]  @default([])
  // LUM-1137: the PR's commit count at each admitted head, aligned with
  // reviewHeads (a missing entry — a head admitted before this column —
  // counts as one commit). Reviewed commits = the commits each head added.
  reviewHeadCommits Int[]  @default([])
  // LUM-1137: this PR's own pause-after-N-reviewed-commits, set only by
  // `--resume --limit` / `@uselumo resume`; null = the workspace setting.
  reviewCommitLimit Int?
  // LUM-1148: `@uselumo ignore pre-merge checks` — who overrode this PR's
  // pre-merge checks, when, and at which head. null = not overridden. Per
  // PR; never clears a finding that blocks DONE.
  preMergeOverrideBy   String?
  preMergeOverrideAt   DateTime?
  preMergeOverrideSha  String?
  workspaceId    String
  taskId         String?
  integrationId  String? // null for agent-created PRs (GitHub App, not OAuth)
  // LUM-1315: the Git host — 'github' | 'codeup' (a Codeup merge request:
  // `repo` is its full path, which may hold nested groups, `number` its iid).
  // Every reader that calls the GitHub API with `repo` filters on 'github'.
  provider       String    @default("github")
  repo           String // "owner/repo"
  number         Int
  title          String
  url            String
  state          String // "open" | "closed" | "merged"
  authorLogin    String
  headBranch     String
  baseBranch     String
  isDraft        Boolean   @default(false)
  ciStatus       String? // null | "pending" | "success" | "failure"
  // LUM-801: the PR's CURRENT head commit. GitHub's PR payload has always
  // carried head.sha — the repo's own type declarations narrowed it away to
  // `head: { ref: string }`. Needed so a TestCaseRun recorded against a commit
  // can be told apart from one the PR has since moved past.
  // Nullable: rows predating this column, and the check_suite webhook path
  // (which has no PR head object), leave it null. NEVER overwrite an existing
  // value with null — an upsert without a sha must omit the key entirely.
  headSha        String?
  // LUM-598: merge commit SHA GitHub reports when the PR merges. Groundwork for
  // the post-hoc outcome well — future automated revert detection maps a later
  // "Revert <sha>" back to the delivery via this column. Additive + nullable:
  // historical and still-open PRs leave it null.
  mergeCommitSha String?
  // LUM-634 change-volume pipeline: line/file counts as reported by GitHub
  // (webhook payload or backfill via the pulls API). All nullable — null means
  // "not synced/backfilled yet", NEVER a fabricated 0 (0 = a real zero-change
  // PR). Read as review load / regression exposure, not output.
  additions      Int?
  deletions      Int?
  changedFiles   Int?
  mergedAt       DateTime?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace        Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task             Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  integration      GitHubIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  mirroredComments PrCommentMirror[]
  securityScans    PrSecurityScan[]
  findingThreads   PrFindingThread[]
  // LUM-1154
  chatRequests     PrChatRequest[]
  testCaseRuns     TestCaseRun[]
  // LUM-1150: the single-writer claim on creating this PR's summary comment.
  securitySummaryClaim PrSecuritySummaryClaim?
  // LUM-1334
  reviews              PullRequestReview[]

  // LUM-924: one row per workspace — workspaces sharing a GitHub App
  // installation can each confirm the same repository and track its PRs.
  @@unique([workspaceId, provider, repo, number])
  @@index([workspaceId])
  @@index([taskId])
  @@index([integrationId])
  @@map("pull_requests")
}

/// LUM-1334: GitHub reviews on a PR (from `pull_request_review` webhooks), one
/// row per GitHub review id, holding its latest state. Read by the DONE gate's
/// review requirement: a reviewer whose latest review is APPROVED on the PR's
/// head commit covers that head. COMMENTED reviews are not stored.
model PullRequestReview {
  id             String   @id @default(cuid())
  pullRequestId  String
  /// GitHub's review id (numeric, kept as text).
  githubReviewId String
  reviewerLogin  String
  /// APPROVED | CHANGES_REQUESTED | DISMISSED
  state          String
  /// The commit the review was submitted on (`review.commit_id`).
  commitSha      String
  submittedAt    DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@unique([pullRequestId, githubReviewId])
  @@map("pull_request_reviews")
}

model TaskBranch {
