// ─── Hook Events (Claude Code runtime observability) ────────────────────────

enum HookEventType {
  PRE_TOOL_USE
  POST_TOOL_USE
  POST_TOOL_USE_FAILURE
  STOP
  STOP_FAILURE
  USER_PROMPT_SUBMIT
  PERMISSION_REQUEST
  PERMISSION_DENIED
  SESSION_START
  SESSION_END
  SUBAGENT_START
  SUBAGENT_STOP
  WORKTREE_CREATE
  WORKTREE_REMOVE
  FILE_CHANGED
  CONFIG_CHANGE
  TASK_CREATED
  TASK_COMPLETED
  POST_TOOL_BATCH
  USER_PROMPT_EXPANSION
  NOTIFICATION
  ELICITATION
  ELICITATION_RESULT
  CWD_CHANGED
  INSTRUCTIONS_LOADED
}

model HookEvent {
  id                String        @id @default(cuid())
  workspaceId       String
  workspaceMemberId String
  sessionId         String? // Claude Code session UUID, FK to Session.id
  taskId            String? // associated Lumo task
  type              HookEventType
  toolName          String? // extracted from payload.tool_name when present
  // File this event touched, lifted out of the raw payload at record time
  // (tool_input.file_path / tool_response.filePath / top-level path|file_path).
  // Null for events that carry no file path (Bash, Stop, prompts). Indexed for
  // cross-session "who else is touching this file" lookups and LUM-146's
  // "last file changed" — both impossible while the path lived only in JSON.
  filePath          String?
  payload           Json // raw hook body from Claude Code
  // LLM-generated one-line summary of what Claude did in the turn that
  // just ended. Populated only on STOP / STOP_FAILURE rows, written
  // async by the turn-summary service. Null on every other event type
  // and on pre-feature historical rows; UI falls back to a first-
  // sentence excerpt of payload.last_assistant_message in that case.
  turnSummary       String?
  /// Per-turn per-model token delta (LUM-298) = this STOP's cumulative minus the
  /// previous STOP's. JSON map keyed by raw model string ->
  /// { input, output, cacheRead, cacheCreation }. Written only on STOP /
  /// STOP_FAILURE rows; null everywhere else and on historical rows.
  usageByModel      Json?
  createdAt         DateTime      @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member    WorkspaceMember @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)
  session   Session?        @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceMemberId, createdAt])
  @@index([sessionId, createdAt])
  // Cross-session collision lookups: filter by workspace + file within a recent
  // time window. filePath leads the createdAt so a path-equality probe narrows
  // before the time-range scan.
  @@index([workspaceId, filePath, createdAt])
  @@map("hook_events")
}

model Session {
  id                    String            @id // Claude Code session UUID — not cuid
  workspaceId           String
  workspaceMemberId     String
  taskId                String?
  cwd                   String?
  // Which coding agent owns this session. Captured from the `X-Lumo-Agent`
  // header the CLI hook sends (baked in at `lumo setup --agent <token>`), set
  // once on the session's first hook event. Auto-sedimented memories inherit
  // this so a memory is attributed to the agent that actually produced it,
  // not the DB default. Defaults to CLAUDE_CODE — accurate today, since only
  // Claude Code emits hook events.
  agent                 TaskArtifactAgent @default(CLAUDE_CODE)
  // The git worktree this session runs in, when known. Linked by cwd match
  // when a WORKTREE_CREATE hook fires for a path equal to the session's cwd
  // (LUM-150 ②), letting the parallel-edit collision warning name the other
  // session's branch instead of just its agent. Null for sessions not running
  // in a hook-tracked worktree.
  worktreeId            String?
  startedAt             DateTime          @default(now())
  lastActivityAt        DateTime
  eventCount            Int               @default(0)
  // Per-session cost (LUM-281). Token columns hold CUMULATIVE totals summed by
  // the CLI from the Stop-hook transcript and overwritten on each STOP (not
  // incremented). loopCount counts STOP/STOP_FAILURE events = turns. All null
  // until the first STOP carrying usage; historical rows stay null (no backfill).
  inputTokens           Int?
  outputTokens          Int?
  cacheReadTokens       Int?
  cacheCreationTokens   Int?
  loopCount             Int?
  /// Cumulative per-model token usage (LUM-298). JSON map keyed by raw model
  /// string -> { input, output, cacheRead, cacheCreation }. Overwritten each
  /// STOP alongside the flat columns. Null until the first STOP carrying usage.
  usageByModel          Json?
  /// Mid-turn per-model snapshot of the same cumulative map (LUM-345). Written
  /// by POST_TOOL_BATCH only — STOP never touches it, because the read side
  /// derives the in-flight share as `live − usageByModel` clamped at zero, so
  /// a stale snapshot self-heals once the anchor catches up. Null on rows
  /// predating the feature or from CLIs that don't send mid-turn usage.
  liveUsageByModel      Json?
  // Session summary — generated on demand via Claude. The generation flow is a
  // two-step pipeline: a cheap classifier picks a `summaryType`, then a content
  // model fills a type-specific template. `summary` holds the structured output
  // (shape depends on summaryType). `summaryEventCount` records how many events
  // were covered so callers can surface staleness as a delta against the current
  // event count; `summaryGeneratedAt` still lets callers compare against
  // lastActivityAt for a time-based staleness check.
  summary               Json?
  summaryType           String?
  summaryGeneratedAt    DateTime?
  summaryClassifyModel  String?
  summaryContentModel   String?
  summaryEventCount     Int?
  // LLM-generated one-paragraph summary of this run, generated server-side when
  // the bound task reaches DONE. Null until generated (legacy / in-flight runs).
  runSummary            String?
  // Idempotency guard: a re-DONE skips sessions already summarized.
  runSummaryGeneratedAt DateTime?
  /// Memory-review watermark for `lumo session wrap` (LUM-152): Layer1 memories
  /// with createdAt > this are "unreviewed" and listed in the next wrap draft.
  lastMemoryReviewAt    DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member           WorkspaceMember   @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)
  task             Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  worktree         Worktree?         @relation(fields: [worktreeId], references: [id], onDelete: SetNull)
  events           HookEvent[]
  memories         Memory[]
  lineageEdges     LineageEdge[]
  droppedFragments DroppedFragment[]

  @@index([workspaceId, lastActivityAt])
  @@index([workspaceMemberId, lastActivityAt])
  @@index([taskId, lastActivityAt])
  @@index([worktreeId])
  @@map("sessions")
}

// ─── Worktree (git worktree tracking for parallel-edit awareness) ────────────

model Worktree {
  id          String    @id @default(cuid())
  workspaceId String
  // Absolute filesystem path of the worktree — equals a session's `cwd` when
  // that session runs inside it. Unique per workspace so WORKTREE_CREATE can
  // upsert and sessions can link by cwd match.
  path        String
  // Git branch checked out in the worktree, when the WORKTREE_CREATE payload
  // carried it. Surfaced in the collision warning ("分支 lumo/LUM-149-…").
  branch      String?
  createdAt   DateTime  @default(now())
  // Set on WORKTREE_REMOVE; null means the worktree is still present.
  removedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessions  Session[]

  @@unique([workspaceId, path])
  @@map("worktrees")
}

// ─── Memory (long-term context across tasks) ────────────────────────────────

enum MemoryCategory {
  TRAP // 踩过的坑
  DECISION // 工程决策
  CONVENTION // 项目约定
  PROCEDURAL // 工作流程
}

enum MemoryScope {
  TASK
  PROJECT
}

/// Memory lifecycle status (LUM-325, MemGPT-style tiering / Zep bi-temporal
/// invalidate-not-delete). ACTIVE rows are the only ones injected/reconciled;
/// SUPERSEDED rows are kept for audit + flywheel lineage (a SUPERSEDE op flips
/// the old row here and writes the new content to a fresh ACTIVE row).
/// ARCHIVED is reserved for cold eviction (LUM-328) — unused in LUM-325.
/// INVALIDATED (LUM-544) is the DONE-time curation outcome: a Layer-1 memory
/// judged clearly-wrong / self-contradictory is retired WITHOUT a replacement
/// row (so no SUPERSEDED + provenance edge). Like SUPERSEDED it's excluded from
/// the ACTIVE injection/reconcile path but the row + content are preserved for
/// audit — never hard-deleted.
enum MemoryStatus {
  ACTIVE
  SUPERSEDED
  ARCHIVED
  INVALIDATED
}

model Memory {
  id                String                       @id @default(cuid())
  workspaceId       String
  projectId         String
  taskId            String?
  scope             MemoryScope
  category          MemoryCategory
  agent             TaskArtifactAgent            @default(CLAUDE_CODE)
  content           Json
  sourceSessionId   String?
  createdByMemberId String?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  /// Lifecycle (LUM-325). Only ACTIVE rows are injected/reconciled; SUPERSEDED
  /// rows are retained for audit + lineage. validFrom = when this row became the
  /// live truth (backfilled to createdAt for pre-LUM-325 rows). supersededAt /
  /// supersededById are stamped on the OLD row when a SUPERSEDE replaces it.
  status            MemoryStatus                 @default(ACTIVE)
  validFrom         DateTime                     @default(now())
  supersededAt      DateTime?
  supersededById    String?
  /// LUM-397 birth-task accounting. The task whose session extracted/recorded
  /// this memory, captured at creation and never mutated — unlike `taskId`,
  /// which is a scope pointer (nulled on PROJECT promotion, SetNull on task
  /// delete). FK-less on purpose (mirrors LineageEdge/MemoryProvenance): a
  /// deleted task must not erase the birth record. Null for Layer-2
  /// consolidation rows (multi-task origin — provenance edges carry sources),
  /// manual PROJECT adds, and all pre-LUM-397 rows (no backfill, accepted).
  /// Lays the data for same-task self-credit exclusion (follow-up).
  sourceTaskId      String?
  /// 1024-dim semantic embedding of memoryContentToText(content), model
  /// alibaba/qwen3-embedding-0.6b. Read/written ONLY via parameterized raw SQL
  /// in memory.repository.ts — Prisma's typed client can't touch Unsupported
  /// columns. Deliberate pgvector exception to the never-raw-SQL rule. LUM-324.
  embedding         Unsupported("vector(1024)")?

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task            Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  session         Session?         @relation(fields: [sourceSessionId], references: [id], onDelete: SetNull)
  createdByMember WorkspaceMember? @relation("MemoryCreator", fields: [createdByMemberId], references: [id], onDelete: SetNull)

  @@index([projectId, scope, status])
  @@index([taskId, status])
  @@map("memories")
}

/// LUM-547 (P4b) code-anchor staleness report. Written by `lumo memory sync`
/// when EVERY code anchor a memory names (file path / symbol / flag) is gone
/// from the dev's git-tracked repo; read back by the P4a retire pool with its
/// dead-anchor evidence. Detection is client-side (the server has no checkout),
/// so the finding is persisted here rather than recomputed. One current report
/// per memory — upsert by memoryId (idempotent; latest evidence wins). FK-less
/// on purpose (mirrors LineageEdge/MemoryProvenance): a hard-deleted memory must
/// not erase/500 the writer, and an orphan report never surfaces (only ACTIVE
/// memories are ranked into the pool). The report NEVER mutates memory status —
/// retirement stays human-confirmed.
model MemoryStaleAnchorReport {
  id                String   @id @default(cuid())
  memoryId          String   @unique
  projectId         String
  workspaceId       String
  /// [{ kind: "file" | "symbol" | "flag", value: string }] — the dead anchors.
  deadAnchors       Json
  reportedBySession String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([projectId])
  @@map("memory_stale_anchor_reports")
}

/// Provenance edges for Layer-2 memory consolidation (LUM-280). When
/// consolidation promotes recurring TASK lessons into a new PROJECT memory,
/// it records which source TASK memories fed the promotion. `resolveCanonicalFragment`
/// walks parent→child so a LineageEdge keyed by an old TASK cuid still rolls up
/// to the promoted PROJECT cuid. FK-less on purpose (mirrors LineageEdge): a
/// deleted parent memory must NOT cascade away the redirect, and source rows
/// are consolidated/edited/deleted independently (deletion propagation is
/// milestone known-debt).
model MemoryProvenance {
  id             String   @id @default(cuid())
  // The PROJECT memory created by consolidation (the promoted lesson).
  childMemoryId  String
  // A source TASK memory the promotion was synthesized from. Validated to be
  // in the consolidation input window before insert — hallucinated ids dropped.
  parentMemoryId String
  createdAt      DateTime @default(now())

  @@unique([childMemoryId, parentMemoryId])
  @@index([parentMemoryId])
  @@map("memory_provenance")
}

