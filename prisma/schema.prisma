// Lumo — Sprint 1 Schema
// Workspace-centric data model. Clerk owns user identity; clerkId is the FK.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum WorkspaceRole {
  OWNER
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ViewType {
  DOCUMENT
  KANBAN
}

enum ViewVisibility {
  PRIVATE    // only the creator (memberId owner)
  WORKSPACE  // all workspace members
  SHARED     // only members listed in ViewMember
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum NotificationType {
  TASK_IN_REVIEW   // task moved to IN_REVIEW — sent to all OWNERs
  TASK_MENTIONED   // someone @mentioned you in a comment
  TASK_SENT_BACK   // owner sent a task back to IN_PROGRESS — sent to assignee
  TASK_ASSIGNED    // task assigned to you
}

// ─── Workspace ──────────────────────────────────────────────────────────────

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members            WorkspaceMember[]
  teams              Team[]
  projects           Project[]
  views              View[]
  invites            WorkspaceInvite[]
  githubIntegrations GitHubIntegration[]
  pullRequests       PullRequest[]
  slackIntegration   SlackIntegration?

  @@map("workspaces")
}

// ─── Team ───────────────────────────────────────────────────────────────────

model Team {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  identifier  String   // task ID prefix e.g. "ENG"
  isDefault   Boolean  @default(false)
  taskSeq     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects  Project[]
  members   TeamMember[]
  tasks     Task[]

  @@unique([workspaceId, identifier])
  @@index([workspaceId])
  @@map("teams")
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  memberId String
  joinedAt DateTime @default(now())

  team   Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  member WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([teamId, memberId])
  @@index([memberId])
  @@map("team_members")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  clerkId     String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  workspace              Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  teams                  TeamMember[]
  createdProjects        Project[]    @relation("ProjectCreator")
  defaultReviewerFor     Project[]    @relation("ProjectDefaultReviewer")
  assignedTasks          Task[]       @relation("TaskAssignee")
  reviewerTasks          Task[]       @relation("TaskReviewer")
  ownedViews             View[]       @relation("ViewOwner")
  createdViews           View[]       @relation("ViewCreator")
  sharedViews            ViewMember[]
  sentInvites            WorkspaceInvite[]
  githubIntegrations     GitHubIntegration[]
  slackInstalled         SlackIntegration[]  @relation("SlackInstaller")

  @@unique([workspaceId, clerkId])
  @@index([clerkId])
  @@map("workspace_members")
}

// ─── Project ────────────────────────────────────────────────────────────────

model Project {
  id                String   @id @default(cuid())
  workspaceId       String
  teamId            String
  createdByMemberId String
  defaultReviewerId String?
  name              String
  description       String?
  isIdea            Boolean  @default(false)
  githubRepo        String?  // "owner/repo" of the connected GitHub repo for this project
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team            Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy       WorkspaceMember  @relation("ProjectCreator", fields: [createdByMemberId], references: [id])
  defaultReviewer WorkspaceMember? @relation("ProjectDefaultReviewer", fields: [defaultReviewerId], references: [id], onDelete: SetNull)
  tasks           Task[]
  views           View[]
  slackChannels   SlackChannel[]

  @@index([workspaceId])
  @@index([teamId])
  @@index([createdByMemberId])
  @@map("projects")
}

// ─── Task (self-referencing tree) ───────────────────────────────────────────

model Task {
  id             String       @id @default(cuid())
  projectId      String
  teamId         String
  number         Int
  parentTaskId   String?
  assigneeId     String?
  reviewerId     String?
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  order          Float        @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team     Team             @relation(fields: [teamId], references: [id])
  parent   Task?            @relation("TaskChildren", fields: [parentTaskId], references: [id], onDelete: SetNull)
  children Task[]           @relation("TaskChildren")
  assignee WorkspaceMember? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reviewer WorkspaceMember? @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  viewTaskOrders ViewTaskOrder[]
  comments       Comment[]
  pullRequests   PullRequest[]
  branches       TaskBranch[]

  @@unique([teamId, number])
  @@index([projectId])
  @@index([teamId])
  @@index([parentTaskId])
  @@index([assigneeId])
  @@index([reviewerId])
  @@map("tasks")
}

// ─── View system (Document / Kanban / future) ───────────────────────────────

model View {
  id          String   @id @default(cuid())
  workspaceId String   // security boundary — always required
  projectId   String?  // set for project-level views
  memberId    String?  // set for personal views (My Tasks); null = workspace-shared view
  name        String
  type        ViewType
  config      Json     @default("{}")
  // config shape: { filters?: { projectIds?: string[], statuses?: string[], assigneeIds?: string[] } }
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  visibility        ViewVisibility   @default(WORKSPACE)
  createdByMemberId String?

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project    Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member     WorkspaceMember? @relation("ViewOwner", fields: [memberId], references: [id], onDelete: Cascade)
  createdBy  WorkspaceMember? @relation("ViewCreator", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  taskOrders ViewTaskOrder[]
  sharedWith ViewMember[]

  @@index([workspaceId])
  @@index([projectId])
  @@index([memberId])
  @@map("views")
}

enum ViewMemberRole {
  VIEWER
  EDITOR
}

model ViewMember {
  id       String         @id @default(cuid())
  viewId   String
  memberId String
  role     ViewMemberRole @default(VIEWER)
  addedAt  DateTime       @default(now())

  view   View            @relation(fields: [viewId], references: [id], onDelete: Cascade)
  member WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([viewId, memberId])
  @@map("view_members")
}

model ViewTaskOrder {
  id       String @id @default(cuid())
  viewId   String
  taskId   String
  groupKey String
  order    Float

  view View @relation(fields: [viewId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([viewId, taskId])
  @@index([viewId, groupKey, order])
  @@map("view_task_orders")
}

// ─── Comments ────────────────────────────────────────────────────────────────

model Comment {
  id              String   @id @default(cuid())
  taskId          String
  authorId        String   // Clerk userId
  body            String   // HTML; @mentions encoded as data-id attributes
  parentId        String?  // null = top-level; non-null = reply (max 1 level deep)
  quotedCommentId String?  // which specific comment this reply is quoting

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  parent        Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[] @relation("CommentReplies")

  @@index([taskId])
  @@index([parentId])
  @@map("comments")
}

// ─── Notifications ───────────────────────────────────────────────────────────

model Notification {
  id          String           @id @default(cuid())
  workspaceId String
  recipientId String           // Clerk userId
  type        NotificationType
  taskId      String?
  commentId   String?          // set for TASK_MENTIONED — used to scroll to comment
  actorId     String?          // Clerk userId of who triggered it
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([recipientId, read])
  @@map("notifications")
}

model GitHubIntegration {
  id           String   @id @default(cuid())
  workspaceId  String
  memberId     String
  accessToken  String   // AES-256-GCM encrypted: "iv:authTag:ciphertext" (hex)
  tokenType    String   @default("oauth")
  githubUserId String
  githubLogin  String
  repositories  String[]
  webhookSecret String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member       WorkspaceMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  webhooks     GitHubWebhook[]
  pullRequests PullRequest[]

  @@unique([workspaceId, memberId])
  @@index([workspaceId])
  @@map("github_integrations")
}

model GitHubWebhook {
  id            String   @id @default(cuid())
  integrationId String
  repo          String   // "owner/repo"
  githubHookId  Int      // GitHub's webhook ID, needed for deletion

  createdAt DateTime @default(now())

  integration GitHubIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, repo])
  @@index([repo])
  @@map("github_webhooks")
}

model SlackIntegration {
  id            String   @id @default(cuid())
  workspaceId   String   @unique
  installedBy   String?
  installer     WorkspaceMember? @relation("SlackInstaller", fields: [installedBy], references: [id], onDelete: SetNull)
  accessToken   String
  slackTeamId   String
  slackTeamName String
  slackUserId   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channels  SlackChannel[]

  @@index([slackTeamId])
  @@map("slack_integrations")
}

model SlackChannel {
  id            String   @id @default(cuid())
  integrationId String
  channelId     String
  channelName   String
  events        String[]
  projectId     String?
  createdAt     DateTime @default(now())

  integration SlackIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([integrationId])
  @@index([projectId])
  @@map("slack_channels")
}

model PullRequest {
  id            String    @id @default(cuid())
  workspaceId   String
  taskId        String?
  integrationId String
  repo          String    // "owner/repo"
  number        Int
  title         String
  url           String
  state         String    // "open" | "closed" | "merged"
  authorLogin   String
  headBranch    String
  baseBranch    String
  isDraft       Boolean   @default(false)
  ciStatus      String?   // null | "pending" | "success" | "failure"
  mergedAt      DateTime?
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task        Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  integration GitHubIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([repo, number])
  @@index([workspaceId])
  @@index([taskId])
  @@index([integrationId])
  @@map("pull_requests")
}

model TaskBranch {
  id                String    @id @default(cuid())
  taskId            String
  repo              String    // "owner/repo"
  branchName        String
  lastCommitSha     String?
  lastCommitMessage String?
  lastCommitAuthor  String?
  lastPushedAt      DateTime?
  createdAt         DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, repo, branchName])
  @@index([taskId])
  @@map("task_branches")
}

model WorkspaceInvite {
  id          String       @id @default(cuid())
  token       String       @unique @default(cuid())
  workspaceId String
  email       String       // always stored lowercase
  inviterName String       // denormalized from Clerk at invite time
  invitedById String       // WorkspaceMember.id
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime     @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy WorkspaceMember @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@map("workspace_invites")
}
