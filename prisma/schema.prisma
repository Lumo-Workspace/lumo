// Lumo — Sprint 1 Schema
// Workspace-centric data model. Clerk owns user identity; clerkId is the FK.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum WorkspaceRole {
  OWNER
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ViewType {
  DOCUMENT
  KANBAN
}

enum ViewVisibility {
  PRIVATE    // only the creator (memberId owner)
  WORKSPACE  // all workspace members
  SHARED     // only members listed in ViewMember
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum NotificationType {
  TASK_IN_REVIEW   // task moved to IN_REVIEW — sent to reviewer / OWNERs
  TASK_MENTIONED   // someone @mentioned you in a comment
  TASK_SENT_BACK   // owner sent a task back to IN_PROGRESS — sent to assignee
  TASK_ASSIGNED    // task assigned to you
  TASK_SPEC_READY  // agent generated a spec draft — sent to reviewer
  AGENT_CLARIFY    // agent needs clarification — sent to assignee / reviewer
  AGENT_FAILED     // agent execution failed — sent to assignee
  AGENT_DONE       // agent finished, PR created — sent to assignee / reviewer
}

enum CommentType {
  USER
  AGENT
}

enum AgentStatus {
  RUNNING
  PAUSED
  DONE
  FAILED
  CANCELLED
  SPEC_REVIEW
}

enum ActorType {
  HUMAN
  AGENT
}

enum AgentType {
  CODING
  REVIEW
  PLANNER
}

// ─── Workspace ──────────────────────────────────────────────────────────────

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members            WorkspaceMember[]
  teams              Team[]
  projects           Project[]
  views              View[]
  invites            WorkspaceInvite[]
  githubIntegrations GitHubIntegration[]
  pullRequests       PullRequest[]
  slackIntegration   SlackIntegration?
  actors             Actor[]
  agentProfiles      AgentProfile[]

  @@map("workspaces")
}

// ─── Team ───────────────────────────────────────────────────────────────────

model Team {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  identifier  String   // task ID prefix e.g. "ENG"
  isDefault   Boolean  @default(false)
  taskSeq     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects  Project[]
  members   TeamMember[]
  tasks     Task[]

  @@unique([workspaceId, identifier])
  @@index([workspaceId])
  @@map("teams")
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  memberId String
  joinedAt DateTime @default(now())

  team   Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  member WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([teamId, memberId])
  @@index([memberId])
  @@map("team_members")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  clerkId     String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  workspace              Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  teams                  TeamMember[]
  createdProjects        Project[]    @relation("ProjectCreator")
  defaultReviewerFor     Project[]    @relation("ProjectDefaultReviewer")
  ownedViews             View[]       @relation("ViewOwner")
  createdViews           View[]       @relation("ViewCreator")
  sharedViews            ViewMember[]
  sentInvites            WorkspaceInvite[]
  githubIntegrations     GitHubIntegration[]
  slackInstalled         SlackIntegration[]  @relation("SlackInstaller")
  actor                  Actor?
  agentProfiles          AgentProfile[]

  @@unique([workspaceId, clerkId])
  @@index([clerkId])
  @@map("workspace_members")
}

// ─── Agent Profiles ─────────────────────────────────────────────────────────

model AgentProfile {
  id          String    @id @default(cuid())
  workspaceId String
  memberId    String?   // null = workspace-shared agent; set = personal agent (Phase 4)
  name        String    // "Coding Agent"
  type        AgentType
  avatarColor String    @default("#6366f1")
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member    WorkspaceMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  actor     Actor?

  @@unique([workspaceId, type, memberId])
  @@map("agent_profiles")
}

model Actor {
  id          String    @id @default(cuid())
  workspaceId String
  type        ActorType
  memberId    String?   @unique
  agentId     String?   @unique

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member    WorkspaceMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  agent     AgentProfile?    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  assignedTasks          Task[]         @relation("TaskAssignee")
  reviewerTasks          Task[]         @relation("TaskReviewer")
  comments               Comment[]      @relation("CommentAuthor")
  activities             TaskActivity[]
  receivedNotifications  Notification[] @relation("NotificationRecipient")
  triggeredNotifications Notification[] @relation("NotificationTrigger")

  @@index([workspaceId])
  @@map("actors")
}

// ─── Project ────────────────────────────────────────────────────────────────

model Project {
  id                String   @id @default(cuid())
  workspaceId       String
  teamId            String
  createdByMemberId String
  defaultReviewerId String?
  name              String
  description       String?
  isIdea            Boolean  @default(false)
  githubRepo        String?  // legacy single-repo field; prefer ProjectRepository
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team            Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy       WorkspaceMember     @relation("ProjectCreator", fields: [createdByMemberId], references: [id])
  defaultReviewer WorkspaceMember?    @relation("ProjectDefaultReviewer", fields: [defaultReviewerId], references: [id], onDelete: SetNull)
  tasks           Task[]
  views           View[]
  slackChannels   SlackChannel[]
  repositories    ProjectRepository[]

  @@index([workspaceId])
  @@index([teamId])
  @@index([createdByMemberId])
  @@map("projects")
}

model ProjectRepository {
  id        String   @id @default(cuid())
  projectId String
  fullName  String   // "owner/repo"
  name      String   // short repo name
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@unique([projectId, fullName])
  @@index([projectId])
  @@map("project_repositories")
}

// ─── Task (self-referencing tree) ───────────────────────────────────────────

model Task {
  id               String       @id @default(cuid())
  projectId        String
  teamId           String
  number           Int
  parentTaskId     String?
  assigneeActorId  String?
  reviewerActorId  String?
  repositoryId     String?      // optional link to ProjectRepository
  title            String
  description      String?
  spec             String?
  status           TaskStatus   @default(TODO)
  priority         TaskPriority @default(MEDIUM)
  order            Float        @default(0)
  agentStatus      AgentStatus?
  agentError       String?
  sandboxId        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team       Team                @relation(fields: [teamId], references: [id])
  repository ProjectRepository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  parent     Task?               @relation("TaskChildren", fields: [parentTaskId], references: [id], onDelete: SetNull)
  children   Task[]              @relation("TaskChildren")
  assignee   Actor?              @relation("TaskAssignee", fields: [assigneeActorId], references: [id], onDelete: SetNull)
  reviewer   Actor?              @relation("TaskReviewer", fields: [reviewerActorId], references: [id], onDelete: SetNull)

  viewTaskOrders ViewTaskOrder[]
  comments       Comment[]
  pullRequests   PullRequest[]
  branches       TaskBranch[]
  clarifies      AgentClarify[]
  activities     TaskActivity[]

  @@unique([teamId, number])
  @@index([projectId])
  @@index([teamId])
  @@index([parentTaskId])
  @@index([assigneeActorId])
  @@index([reviewerActorId])
  @@index([repositoryId])
  @@map("tasks")
}

// ─── View system (Document / Kanban / future) ───────────────────────────────

model View {
  id          String   @id @default(cuid())
  workspaceId String   // security boundary — always required
  projectId   String?  // set for project-level views
  memberId    String?  // set for personal views (My Tasks); null = workspace-shared view
  name        String
  type        ViewType
  config      Json     @default("{}")
  // config shape: { filters?: { projectIds?: string[], statuses?: string[], assigneeIds?: string[] } }
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  visibility        ViewVisibility   @default(WORKSPACE)
  createdByMemberId String?

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project    Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member     WorkspaceMember? @relation("ViewOwner", fields: [memberId], references: [id], onDelete: Cascade)
  createdBy  WorkspaceMember? @relation("ViewCreator", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  taskOrders ViewTaskOrder[]
  sharedWith ViewMember[]

  @@index([workspaceId])
  @@index([projectId])
  @@index([memberId])
  @@map("views")
}

enum ViewMemberRole {
  VIEWER
  EDITOR
}

model ViewMember {
  id       String         @id @default(cuid())
  viewId   String
  memberId String
  role     ViewMemberRole @default(VIEWER)
  addedAt  DateTime       @default(now())

  view   View            @relation(fields: [viewId], references: [id], onDelete: Cascade)
  member WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([viewId, memberId])
  @@map("view_members")
}

model ViewTaskOrder {
  id       String @id @default(cuid())
  viewId   String
  taskId   String
  groupKey String
  order    Float

  view View @relation(fields: [viewId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([viewId, taskId])
  @@index([viewId, groupKey, order])
  @@map("view_task_orders")
}

// ─── Comments ────────────────────────────────────────────────────────────────

model Comment {
  id              String      @id @default(cuid())
  taskId          String
  authorActorId   String?
  body            String      // HTML; @mentions encoded as data-id attributes
  parentId        String?     // null = top-level; non-null = reply (max 1 level deep)
  quotedCommentId String?     // which specific comment this reply is quoting
  type            CommentType @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author        Actor?    @relation("CommentAuthor", fields: [authorActorId], references: [id], onDelete: SetNull)
  parent        Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[] @relation("CommentReplies")

  @@index([taskId])
  @@index([parentId])
  @@index([authorActorId])
  @@map("comments")
}

model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  actorId   String?
  type      String   // "status_changed" | "assignee_changed" | "comment_added" etc.
  payload   Json?    // { from: "TODO", to: "IN_PROGRESS" }
  createdAt DateTime @default(now())

  task  Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor Actor? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@map("task_activities")
}

// ─── Notifications ───────────────────────────────────────────────────────────

model Notification {
  id               String           @id @default(cuid())
  workspaceId      String
  recipientActorId String           // Actor.id — who receives this notification
  type             NotificationType
  taskId           String?
  commentId        String?          // set for TASK_MENTIONED — scroll to comment
  clarifyId        String?          // set for AGENT_CLARIFY — link to AgentClarify
  triggerActorId   String?          // Actor.id — who/what triggered it; null for system
  read             Boolean          @default(false)
  createdAt        DateTime         @default(now())

  recipient Actor  @relation("NotificationRecipient", fields: [recipientActorId], references: [id], onDelete: Cascade)
  trigger   Actor? @relation("NotificationTrigger", fields: [triggerActorId], references: [id], onDelete: SetNull)

  @@index([recipientActorId, read])
  @@map("notifications")
}

model GitHubIntegration {
  id           String   @id @default(cuid())
  workspaceId  String
  memberId     String
  accessToken  String   // AES-256-GCM encrypted: "iv:authTag:ciphertext" (hex)
  tokenType    String   @default("oauth")
  githubUserId String
  githubLogin  String
  repositories  String[]
  webhookSecret String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member       WorkspaceMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  webhooks     GitHubWebhook[]
  pullRequests PullRequest[]

  @@unique([workspaceId, memberId])
  @@index([workspaceId])
  @@map("github_integrations")
}

model GitHubWebhook {
  id            String   @id @default(cuid())
  integrationId String
  repo          String   // "owner/repo"
  githubHookId  Int      // GitHub's webhook ID, needed for deletion

  createdAt DateTime @default(now())

  integration GitHubIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, repo])
  @@index([repo])
  @@map("github_webhooks")
}

model SlackIntegration {
  id            String   @id @default(cuid())
  workspaceId   String   @unique
  installedBy   String?
  installer     WorkspaceMember? @relation("SlackInstaller", fields: [installedBy], references: [id], onDelete: SetNull)
  accessToken   String
  slackTeamId   String
  slackTeamName String
  slackUserId   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channels  SlackChannel[]

  @@index([slackTeamId])
  @@map("slack_integrations")
}

model SlackChannel {
  id            String   @id @default(cuid())
  integrationId String
  channelId     String
  channelName   String
  events        String[]
  projectId     String?
  createdAt     DateTime @default(now())

  integration SlackIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([integrationId])
  @@index([projectId])
  @@map("slack_channels")
}

model PullRequest {
  id            String    @id @default(cuid())
  workspaceId   String
  taskId        String?
  integrationId String?   // null for agent-created PRs (GitHub App, not OAuth)
  repo          String    // "owner/repo"
  number        Int
  title         String
  url           String
  state         String    // "open" | "closed" | "merged"
  authorLogin   String
  headBranch    String
  baseBranch    String
  isDraft       Boolean   @default(false)
  ciStatus      String?   // null | "pending" | "success" | "failure"
  mergedAt      DateTime?
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task        Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  integration GitHubIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@unique([repo, number])
  @@index([workspaceId])
  @@index([taskId])
  @@index([integrationId])
  @@map("pull_requests")
}

model TaskBranch {
  id                String    @id @default(cuid())
  taskId            String
  repo              String    // "owner/repo"
  branchName        String
  lastCommitSha     String?
  lastCommitMessage String?
  lastCommitAuthor  String?
  lastPushedAt      DateTime?
  createdAt         DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, repo, branchName])
  @@index([taskId])
  @@map("task_branches")
}

model AgentClarify {
  id        String    @id @default(cuid())
  taskId    String
  question  String
  context   String?
  reply     String?
  repliedAt DateTime?
  createdAt DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("agent_clarifies")
}

model WorkspaceInvite {
  id          String       @id @default(cuid())
  token       String       @unique @default(cuid())
  workspaceId String
  email       String       // always stored lowercase
  inviterName String       // denormalized from Clerk at invite time
  invitedById String       // WorkspaceMember.id
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime     @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy WorkspaceMember @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@map("workspace_invites")
}
