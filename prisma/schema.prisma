// Lumo — Sprint 1 Schema
// Workspace-centric data model. Clerk owns user identity; clerkId is the FK.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum WorkspaceRole {
  OWNER
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ViewType {
  DOCUMENT
  KANBAN
}

// ─── Workspace ──────────────────────────────────────────────────────────────

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  WorkspaceMember[]
  projects Project[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  clerkId     String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdProjects Project[]
  assignedTasks   Task[]

  @@unique([workspaceId, clerkId])
  @@index([clerkId])
  @@map("workspace_members")
}

// ─── Project ────────────────────────────────────────────────────────────────

model Project {
  id                String   @id @default(cuid())
  workspaceId       String
  createdByMemberId String
  name              String
  description       String?
  isIdea            Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy  WorkspaceMember @relation(fields: [createdByMemberId], references: [id])
  tasks      Task[]
  views      View[]

  @@index([workspaceId])
  @@index([createdByMemberId])
  @@map("projects")
}

// ─── Task (self-referencing tree) ───────────────────────────────────────────

model Task {
  id             String       @id @default(cuid())
  projectId      String
  parentTaskId   String?
  assigneeId     String?
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  order          Float        @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   Task?            @relation("TaskChildren", fields: [parentTaskId], references: [id], onDelete: SetNull)
  children Task[]           @relation("TaskChildren")
  assignee WorkspaceMember? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  viewTaskOrders ViewTaskOrder[]

  @@index([projectId])
  @@index([parentTaskId])
  @@index([assigneeId])
  @@map("tasks")
}

// ─── View system (Document / Kanban / future) ───────────────────────────────

model View {
  id        String   @id @default(cuid())
  projectId String
  name      String
  type      ViewType
  config    Json     @default("{}")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskOrders ViewTaskOrder[]

  @@index([projectId])
  @@map("views")
}

model ViewTaskOrder {
  id       String @id @default(cuid())
  viewId   String
  taskId   String
  groupKey String
  order    Float

  view View @relation(fields: [viewId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([viewId, taskId])
  @@index([viewId, groupKey, order])
  @@map("view_task_orders")
}
