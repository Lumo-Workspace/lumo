// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("SUPA_POSTGRES_PRISMA_URL")
  directUrl = env("SUPA_POSTGRES_URL_NON_POOLING")
}

// NextAuth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text  // Encrypted with AES-256-GCM
  access_token      String? @db.Text  // Encrypted with AES-256-GCM
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  
  lastUsedAt        DateTime @default(now()) @updatedAt  // Track token usage for SR-009

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([lastUsedAt])  // For cleanup queries
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])  // For cleanup queries
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

// Custom models for Google OAuth Login feature
model User {
  id            String    @id @default(cuid())
  name          String?   // Display name (editable by user)
  email         String?   @unique
  emailVerified DateTime?  // Email verification timestamp from Google
  image         String?   // Profile picture URL from Google
  
  // New fields for account management
  displayName   String?   // User's preferred display name
  avatarUrl     String?   // URL to uploaded avatar image
  avatarBlobId  String?   // Vercel Blob ID for avatar storage
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Authentication relationships
  accounts Account[]
  sessions Session[]

  // User data relationships
  profile UserProfile?

  @@index([email])  // For account matching queries
  @@index([displayName]) // For team member list queries
  @@map("users")
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Avatar metadata
  avatarMetadata Json? // { originalSize, processedSize, format, dimensions }
  
  // Profile preferences
  preferences Json? // { theme, notifications, etc. }
  settings     Json? // { privacy, visibility, etc. }
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_profiles")
}