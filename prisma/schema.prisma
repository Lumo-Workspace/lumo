// ─── Hook Events (Claude Code runtime observability) ────────────────────────

enum HookEventType {
  PRE_TOOL_USE
  POST_TOOL_USE
  POST_TOOL_USE_FAILURE
  STOP
  STOP_FAILURE
  USER_PROMPT_SUBMIT
  PERMISSION_REQUEST
  PERMISSION_DENIED
  SESSION_START
  SESSION_END
  SUBAGENT_START
  SUBAGENT_STOP
  WORKTREE_CREATE
  WORKTREE_REMOVE
  FILE_CHANGED
  CONFIG_CHANGE
  TASK_CREATED
  TASK_COMPLETED
  POST_TOOL_BATCH
  USER_PROMPT_EXPANSION
  NOTIFICATION
  ELICITATION
  ELICITATION_RESULT
  CWD_CHANGED
  INSTRUCTIONS_LOADED
  // LUM-1051: Codex-only events (no Claude Code counterpart)
  PRE_COMPACT
  POST_COMPACT
  INTERRUPT
}

model HookEvent {
  id                     String        @id @default(cuid())
  workspaceId            String
  workspaceMemberId      String
  sessionId              String? // Claude Code session UUID, FK to Session.id
  taskId                 String? // associated Lumo task
  type                   HookEventType
  toolName               String? // extracted from payload.tool_name when present
  /// LUM-840: finer bucket under `toolName` for operation-cost attribution —
  /// for Bash, the command's purpose slug (read / test / lumo / … see
  /// lib/agent-run/bash-category.ts), set at record time and backfilled for
  /// history. Null for every other tool and for unreadable commands.
  toolDetail             String?
  /// LUM-840: the command that decided `toolDetail` for Bash — the winning
  /// segment's verb (+ subcommand for git/gh/lumo/npm-style tools), e.g.
  /// `jest`, `git show`. Safe charset, <= 40 chars. Drives the per-command
  /// cost drill-down. Null for every other tool.
  toolVerb               String?
  // File this event touched, lifted out of the raw payload at record time
  // (tool_input.file_path / tool_response.filePath / top-level path|file_path).
  // Null for events that carry no file path (Bash, Stop, prompts). Indexed for
  // cross-session "who else is touching this file" lookups and LUM-146's
  // "last file changed" — both impossible while the path lived only in JSON.
  filePath               String?
  payload                Json // raw hook body from Claude Code
  // LLM-generated one-line summary of what Claude did in the turn that
  // just ended. Populated only on STOP / STOP_FAILURE rows, written
  // async by the turn-summary service. Null on every other event type
  // and on pre-feature historical rows; UI falls back to a first-
  // sentence excerpt of payload.last_assistant_message in that case.
  turnSummary            String?
  /// Per-turn per-model token delta (LUM-298) = this STOP's cumulative minus the
  /// previous STOP's. JSON map keyed by raw model string ->
  /// { input, output, cacheRead, cacheCreation }. Written only on STOP /
  /// STOP_FAILURE rows; null everywhere else and on historical rows.
  usageByModel           Json?
  /// LUM-932 P2: task-identification signals lifted out of the payload at
  /// record time (see lib/attribution/signals.ts). A derived column, so it
  /// survives payload pruning. `[]` = computed, nothing found; NULL = never
  /// computed (rows recorded before P2).
  attributionSignals     Json?
  /// LUM-859: when the retention sweep replaced `payload` with the pruned
  /// marker. Null = payload still holds the (redacted) original.
  payloadPrunedAt        DateTime?
  /// LUM-1302: the pruned marker's `reason` (RETENTION_POLICY / USED_UP /
  /// USER_DELETED), lifted out so it stays queryable once `payload` is
  /// encrypted. Null while the payload is whole.
  payloadPrunedReason    String?
  /// LUM-1302: the WorkspaceDataKey that encrypted `payload`
  /// (lib/db/hook-payload-encryption.ts). Null = stored as plaintext: a row
  /// written before encryption, or by a deployment without ENCRYPTION_KEY.
  payloadKeyId           String?
  /// LUM-1302: `payload.tool_use_id`, lifted out at record time for the
  /// Pre→Post tool-use task match. Null when the event carries none.
  toolUseId              String?
  /// LUM-1302: a USER_PROMPT_SUBMIT whose prompt carries a background task's
  /// `<task-notification>`, lifted out at record time for attribution.
  promptTaskNotification Boolean       @default(false)
  createdAt              DateTime      @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member    WorkspaceMember @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)
  session   Session?        @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceMemberId, createdAt])
  @@index([sessionId, createdAt])
  // Cross-session collision lookups: filter by workspace + file within a recent
  // time window. filePath leads the createdAt so a path-equality probe narrows
  // before the time-range scan.
  @@index([workspaceId, filePath, createdAt])
  @@map("hook_events")
}

/// LUM-1302: a workspace's data-encryption key (envelope encryption). The
/// 32-byte key is stored wrapped by ENCRYPTION_KEY (lib/crypto.ts); each
/// HookEvent payload is encrypted with its workspace's latest key and names
/// the key it used (`HookEvent.payloadKeyId`). Rotating ENCRYPTION_KEY only
/// re-wraps these rows; deleting a workspace deletes its keys.
model WorkspaceDataKey {
  id          String   @id @default(cuid())
  workspaceId String
  /// 1, 2, … per workspace; the highest is the one new writes use.
  version     Int
  /// `lib/crypto.ts` encrypt() of the key's hex — never the raw key.
  wrappedKey  String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, version])
  @@map("workspace_data_keys")
}

// LUM-640: a session's legal form. IMPLEMENTATION = the classic task-bound
// coding session (Session.taskId lifetime lock, LUM-459). STEWARD = a
// governance session bound to a MILESTONE (Session.milestoneId): it plans and
// accepts (task create/update, deps confirm/dismiss, milestone add/remove,
// milestone test cases, all reads) but is gated out of implementation
// actions (dispatching a task to itself → 409); implementation artifacts it produces
// anyway are recorded as STEWARD_IMPLEMENTATION_ARTIFACT boundary crossings.
enum SessionRole {
  IMPLEMENTATION
  STEWARD
}

/// LUM-932: how an explicit task binding got onto a Session row. Null = no
/// explicit binding (the session's work is attributed by inference, P2).
enum SessionBindingSource {
  ATTACH
  INHERITED
}

/// LUM-932 P2: where a TaskAttributionSegment's task came from.
enum AttributionSource {
  SESSION_ATTACH
  SUBAGENT_ATTACH
  INHERITED
  INFERRED
}

enum AttributionConfidence {
  EXPLICIT
  HIGH
  MEDIUM
}

/// LUM-932 P2: one contiguous stretch of a session's work attributed to a
/// task. Written for explicit bindings and for inferred (per-turn) ones; the
/// family's rows are replaced atomically on every recompute. Observe-only in P2 —
/// nothing gates on it yet.
model TaskAttributionSegment {
  id             String                @id @default(cuid())
  workspaceId    String
  sessionId      String
  taskId         String
  /// Turn index range within the TOP-LEVEL session (0-based, inclusive).
  fromTurn       Int
  toTurn         Int
  fromAt         DateTime
  /// Null = still open (the segment runs to the session's latest event).
  toAt           DateTime?
  source         AttributionSource
  confidence     AttributionConfidence
  /// Up to 10 signals that decided this segment: [{ kind, identifier, at }].
  evidence       Json
  computeVersion Int
  createdAt      DateTime              @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([taskId])
  @@index([workspaceId])
  @@map("task_attribution_segments")
}

/// LUM-932 `lumo usage resync`: one row per session corrected by a resync,
/// holding everything needed to revert it — the session's old and new usage
/// columns, the per-model per-kind scale factors, and the old `usageByModel`
/// of every scaled HookEvent row (`{ eventId: usage }`).
model UsageResyncAudit {
  id                String   @id @default(cuid())
  workspaceId       String
  sessionId         String
  workspaceMemberId String
  before            Json
  after             Json
  factors           Json
  rows              Json
  createdAt         DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([workspaceId])
  @@map("usage_resync_audits")
}

model Session {
  id                    String                @id // Claude Code session UUID — not cuid
  workspaceId           String
  workspaceMemberId     String
  taskId                String?
  // LUM-640: which legal form this session takes. STEWARD sessions bind a
  // milestone (below) instead of a task; the default keeps every existing and
  // hook-created session an IMPLEMENTATION session (behavior unchanged).
  role                  SessionRole           @default(IMPLEMENTATION)
  // LUM-640: the milestone a STEWARD session is bound to. Same write-once
  // lifetime-lock semantics as taskId (LUM-459): set by
  // `lumo session attach --steward`, never rebound; re-attach to the same
  // milestone is idempotent, any other attach is refused with 409.
  milestoneId           String?
  cwd                   String?
  // Which coding agent owns this session. Captured from the `X-Lumo-Agent`
  // header the CLI hook sends (baked in at `lumo setup --agent <token>`), set
  // once on the session's first hook event. Auto-sedimented memories inherit
  // this so a memory is attributed to the agent that actually produced it,
  // not the DB default. Defaults to CLAUDE_CODE — accurate today, since only
  // Claude Code emits hook events.
  agent                 TaskArtifactAgent     @default(CLAUDE_CODE)
  // The git worktree this session runs in, when known. Linked by cwd match
  // when a WORKTREE_CREATE hook fires for a path equal to the session's cwd
  // (LUM-150 ②), letting the parallel-edit collision warning name the other
  // session's branch instead of just its agent. Null for sessions not running
  // in a hook-tracked worktree.
  worktreeId            String?
  // LUM-932: a subagent's child session. Its id is `<parentSessionId>:<agentId>`
  // (deterministic, so a resumed subagent lands on the same row). Null on
  // top-level sessions.
  parentSessionId       String?
  agentId               String?
  agentType             String?
  // LUM-1136: the Lumo CLI version the session's hook events reported
  // (X-Lumo-Cli-Version), shown on the members page. Null when the CLI
  // predates the header.
  cliVersion            String?
  // DEPRECATED (LUM-1292): no longer written or read; historical rows keep
  // their value. Drop the column in the next release.
  skillVersion          String?
  // LUM-932: provenance of `taskId` — ATTACH (`lumo session attach` on this
  // row) or INHERITED (copied from the parent's explicit binding).
  bindingSource         SessionBindingSource?
  // LUM-932 P3: optimistic concurrency for attribution recomputes on a family
  // root. A recompute reads it, and its write transaction only commits when the
  // value is unchanged (then increments it); a concurrent recompute retries.
  attributionVersion    Int                   @default(0)
  startedAt             DateTime              @default(now())
  lastActivityAt        DateTime
  eventCount            Int                   @default(0)
  // Per-session cost (LUM-281). Token columns hold CUMULATIVE totals summed by
  // the CLI from the Stop-hook transcript and overwritten on each STOP (not
  // incremented). loopCount counts STOP/STOP_FAILURE events = turns. All null
  // until the first STOP carrying usage; historical rows stay null (no backfill).
  inputTokens           Int?
  outputTokens          Int?
  cacheReadTokens       Int?
  cacheCreationTokens   Int?
  loopCount             Int?
  /// Cumulative per-model token usage (LUM-298). JSON map keyed by raw model
  /// string -> { input, output, cacheRead, cacheCreation }. Overwritten each
  /// STOP alongside the flat columns. Null until the first STOP carrying usage.
  usageByModel          Json?
  /// Mid-turn per-model snapshot of the same cumulative map (LUM-345). Written
  /// by POST_TOOL_BATCH only — STOP never touches it, because the read side
  /// derives the in-flight share as `live − usageByModel` clamped at zero, so
  /// a stale snapshot self-heals once the anchor catches up. Null on rows
  /// predating the feature or from CLIs that don't send mid-turn usage.
  liveUsageByModel      Json?
  /// LUM-932 `lumo usage resync`: when this session's inflated pre-1.85.0
  /// usage was replaced by exact deduped transcript figures. Null = never
  /// resynced; set once (the resync is idempotent on it).
  usageResyncedAt       DateTime?
  // Session summary — generated on demand via Claude. The generation flow is a
  // two-step pipeline: a cheap classifier picks a `summaryType`, then a content
  // model fills a type-specific template. `summary` holds the structured output
  // (shape depends on summaryType). `summaryEventCount` records how many events
  // were covered so callers can surface staleness as a delta against the current
  // event count; `summaryGeneratedAt` still lets callers compare against
  // lastActivityAt for a time-based staleness check.
  summary               Json?
  summaryType           String?
  summaryGeneratedAt    DateTime?
  summaryClassifyModel  String?
  summaryContentModel   String?
  summaryEventCount     Int?
  // LLM-generated one-paragraph summary of this run, generated server-side when
  // the bound task reaches DONE. Null until generated (legacy / in-flight runs).
  runSummary            String?
  // Idempotency guard: a re-DONE skips sessions already summarized.
  runSummaryGeneratedAt DateTime?
  /// Memory-review watermark for `lumo session wrap` (LUM-152): Layer1 memories
  /// with createdAt > this are "unreviewed" and listed in the next wrap draft.
  lastMemoryReviewAt    DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  workspace            Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member               WorkspaceMember          @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)
  task                 Task?                    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  milestone            Milestone?               @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  worktree             Worktree?                @relation(fields: [worktreeId], references: [id], onDelete: SetNull)
  parent               Session?                 @relation("SessionChildren", fields: [parentSessionId], references: [id], onDelete: Cascade)
  children             Session[]                @relation("SessionChildren")
  events               HookEvent[]
  memories             Memory[]
  lineageEdges         LineageEdge[]
  milestoneMemoryEdges MilestoneMemoryEdge[]
  droppedFragments     DroppedFragment[]
  attributionSegments  TaskAttributionSegment[]
  usageResyncAudits    UsageResyncAudit[]

  @@index([workspaceId, lastActivityAt])
  @@index([workspaceMemberId, lastActivityAt])
  @@index([taskId, lastActivityAt])
  @@index([milestoneId])
  @@index([worktreeId])
  @@index([parentSessionId])
  @@map("sessions")
}

// ─── Worktree (git worktree tracking for parallel-edit awareness) ────────────

model Worktree {
  id          String    @id @default(cuid())
  workspaceId String
  // Absolute filesystem path of the worktree — equals a session's `cwd` when
  // that session runs inside it. Unique per workspace so WORKTREE_CREATE can
  // upsert and sessions can link by cwd match.
  path        String
  // Git branch checked out in the worktree, when the WORKTREE_CREATE payload
  // carried it. Surfaced in the collision warning ("分支 lumo/LUM-149-…").
  branch      String?
  createdAt   DateTime  @default(now())
  // Set on WORKTREE_REMOVE; null means the worktree is still present.
  removedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessions  Session[]

  @@unique([workspaceId, path])
  @@map("worktrees")
}

// ─── Memory (long-term context across tasks) ────────────────────────────────

enum MemoryCategory {
  TRAP // 踩过的坑
  DECISION // 工程决策
  CONVENTION // 项目约定
  PROCEDURAL // 工作流程
}

enum MemoryScope {
  TASK
  PROJECT
  // LUM-647: milestone-close retro distilled into a learning unit, injected at
  // the next milestone's steward session start. milestoneId is set, taskId null.
  MILESTONE
}

/// Memory lifecycle status (LUM-325, MemGPT-style tiering / Zep bi-temporal
/// invalidate-not-delete). ACTIVE rows are the only ones injected/reconciled;
/// SUPERSEDED rows are kept for audit + flywheel lineage (a SUPERSEDE op flips
/// the old row here and writes the new content to a fresh ACTIVE row).
/// ARCHIVED is reserved for cold eviction (LUM-328) — unused in LUM-325.
/// INVALIDATED (LUM-544) is the DONE-time curation outcome: a Layer-1 memory
/// judged clearly-wrong / self-contradictory is retired WITHOUT a replacement
/// row (so no SUPERSEDED + provenance edge). Like SUPERSEDED it's excluded from
/// the ACTIVE injection/reconcile path but the row + content are preserved for
/// audit — never hard-deleted.
enum MemoryStatus {
  ACTIVE
  SUPERSEDED
  ARCHIVED
  INVALIDATED
}

model Memory {
  id                String                       @id @default(cuid())
  workspaceId       String
  projectId         String?
  taskId            String?
  scope             MemoryScope
  category          MemoryCategory
  agent             TaskArtifactAgent            @default(CLAUDE_CODE)
  content           Json
  sourceSessionId   String?
  createdByMemberId String?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  /// Lifecycle (LUM-325). Only ACTIVE rows are injected/reconciled; SUPERSEDED
  /// rows are retained for audit + lineage. validFrom = when this row became the
  /// live truth (backfilled to createdAt for pre-LUM-325 rows). supersededAt /
  /// supersededById are stamped on the OLD row when a SUPERSEDE replaces it.
  status            MemoryStatus                 @default(ACTIVE)
  validFrom         DateTime                     @default(now())
  supersededAt      DateTime?
  supersededById    String?
  /// LUM-397 birth-task accounting. The task whose session extracted/recorded
  /// this memory, captured at creation and never mutated — unlike `taskId`,
  /// which is a scope pointer (nulled on PROJECT promotion, SetNull on task
  /// delete). FK-less on purpose (mirrors LineageEdge/MemoryProvenance): a
  /// deleted task must not erase the birth record. Null for Layer-2
  /// consolidation rows (multi-task origin — provenance edges carry sources),
  /// manual PROJECT adds, and all pre-LUM-397 rows (no backfill, accepted).
  /// Lays the data for same-task self-credit exclusion (follow-up).
  sourceTaskId      String?
  /// 1024-dim semantic embedding of memoryContentToText(content), model
  /// alibaba/qwen3-embedding-0.6b. Read/written ONLY via parameterized raw SQL
  /// in memory.repository.ts — Prisma's typed client can't touch Unsupported
  /// columns. Deliberate pgvector exception to the never-raw-SQL rule. LUM-324.
  embedding         Unsupported("vector(1024)")?

  /// LUM-647: scope pointer for MILESTONE-scope memories (the learning unit a
  /// milestone-close retro distilled). Set only when scope=MILESTONE; null for
  /// TASK/PROJECT rows. SetNull on milestone delete keeps the distilled lesson.
  milestoneId String?

  /// LUM-783: content-level injection scan of this row's untrusted text,
  /// written at write time ({ counts, wrapperEscapes, total, scannedAt } —
  /// see shared/src/untrusted-content.ts). Null = clean or not yet scanned.
  /// Recorded on the SOURCE, never as a boundary crossing on the agent.
  contentSignals Json?

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task            Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  milestone       Milestone?       @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  session         Session?         @relation(fields: [sourceSessionId], references: [id], onDelete: SetNull)
  createdByMember WorkspaceMember? @relation("MemoryCreator", fields: [createdByMemberId], references: [id], onDelete: SetNull)

  /// LUM-648: cross-milestone learning-migration usage edges — one per steward
  /// session this MILESTONE-scope memory was injected into.
  milestoneMemoryEdges MilestoneMemoryEdge[]

  /// LUM-1131: set when this memory is a PR-review learning (its repo scope).
  reviewLearning PrReviewLearning?

  @@index([projectId, scope, status])
  @@index([taskId, status])
  @@index([milestoneId, status])
  /// LUM-917: the OWNER's batched delete of a workspace's memories.
  @@index([workspaceId])
  @@map("memories")
}

/// LUM-547 (P4b) code-anchor staleness report. Written by `lumo memory sync`
/// when EVERY code anchor a memory names (file path / symbol / flag) is gone
/// from the dev's git-tracked repo; read back by the P4a retire pool with its
/// dead-anchor evidence. Detection is client-side (the server has no checkout),
/// so the finding is persisted here rather than recomputed. One current report
/// per memory — upsert by memoryId (idempotent; latest evidence wins). FK-less
/// on purpose (mirrors LineageEdge/MemoryProvenance): a hard-deleted memory must
/// not erase/500 the writer, and an orphan report never surfaces (only ACTIVE
/// memories are ranked into the pool). The report NEVER mutates memory status —
/// retirement stays human-confirmed.
model MemoryStaleAnchorReport {
  id                String   @id @default(cuid())
  memoryId          String   @unique
  projectId         String
  workspaceId       String
  /// [{ kind: "file" | "symbol" | "flag", value: string }] — the dead anchors.
  deadAnchors       Json
  reportedBySession String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([projectId])
  @@map("memory_stale_anchor_reports")
}

/// Provenance edges for Layer-2 memory consolidation (LUM-280). When
/// consolidation promotes recurring TASK lessons into a new PROJECT memory,
/// it records which source TASK memories fed the promotion. `resolveCanonicalFragment`
/// walks parent→child so a LineageEdge keyed by an old TASK cuid still rolls up
/// to the promoted PROJECT cuid. FK-less on purpose (mirrors LineageEdge): a
/// deleted parent memory must NOT cascade away the redirect, and source rows
/// are consolidated/edited/deleted independently (deletion propagation is
/// milestone known-debt).
model MemoryProvenance {
  id             String   @id @default(cuid())
  // The PROJECT memory created by consolidation (the promoted lesson).
  childMemoryId  String
  // A source TASK memory the promotion was synthesized from. Validated to be
  // in the consolidation input window before insert — hallucinated ids dropped.
  parentMemoryId String
  createdAt      DateTime @default(now())

  @@unique([childMemoryId, parentMemoryId])
  @@index([parentMemoryId])
  @@map("memory_provenance")
}

// ─── Task Slack Context ──────────────────────────────────────────────────────

model TaskSlackContext {
  id          String @id @default(cuid())
  taskId      String
  workspaceId String

  permalink        String
  slackTeamId      String
  slackChannelId   String
  slackChannelName String?
  rootTs           String
  threadTs         String?
  isThread         Boolean

  snapshot     Json
  snapshotAt   DateTime
  refreshError String?

  summary            String?
  summaryGeneratedAt DateTime?

  /// LUM-783: content-level injection scan of this row's untrusted text,
  /// written at write time ({ counts, wrapperEscapes, total, scannedAt } —
  /// see shared/src/untrusted-content.ts). Null = clean or not yet scanned.
  /// Recorded on the SOURCE, never as a boundary crossing on the agent.
  contentSignals Json?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task      Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy WorkspaceMember @relation("TaskSlackContextCreator", fields: [createdById], references: [id])

  @@index([taskId])
  @@index([workspaceId])
  @@map("task_slack_contexts")
}

model TaskWebLink {
  id          String @id @default(cuid())
  taskId      String
  workspaceId String

  url         String
  domain      String
  title       String?
  description String?
  note        String?
  imageUrl    String?
  faviconUrl  String?
  fetchedAt   DateTime?
  fetchError  String?

  body          String?   @db.Text
  bodyFetchedAt DateTime?

  /// LUM-783: content-level injection scan of this row's untrusted text,
  /// written at write time ({ counts, wrapperEscapes, total, scannedAt } —
  /// see shared/src/untrusted-content.ts). Null = clean or not yet scanned.
  /// Recorded on the SOURCE, never as a boundary crossing on the agent.
  contentSignals Json?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task      Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy WorkspaceMember @relation("TaskWebLinkCreator", fields: [createdById], references: [id])

  @@index([taskId, createdAt])
  @@index([workspaceId])
  @@map("task_web_links")
}

/// LUM-1303: a ruling made on a task ("do X, not Y"), recorded in its own
/// table and shown on the task's Decisions tab. Replaces the LUM-970
/// `## Decisions` section of the description. `text` is inline Markdown
/// (`code`, **bold**, links); `rationale` is the optional "why".
model TaskDecision {
  id              String   @id @default(cuid())
  taskId          String
  workspaceId     String
  /// 1-based within the task ("Decision 3"), assigned max+1 and never reused:
  /// a delete leaves a tombstone (`deletedAt`), so the max still counts it.
  number          Int
  text            String
  rationale       String?
  /// Who recorded it (a CLI write is the member whose API key ran it). Null
  /// for rows backfilled from a description, whose author is unknown.
  createdById     String?
  /// The agent session that recorded it via `lumo task decide`, if any. No
  /// FK: sessions are pruned independently.
  sourceSessionId String?
  /// Tombstone: a deleted decision keeps its row so its number stays taken.
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  task      Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy WorkspaceMember? @relation("TaskDecisionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([taskId, number])
  @@index([taskId, createdAt])
  @@index([workspaceId])
  @@index([createdById])
  @@map("task_decisions")
}

enum TaskArtifactAgent {
  CLAUDE_CODE
  CODEX
  CURSOR
  GEMINI_CLI
  GITHUB_COPILOT
  WINDSURF
}

model TaskArtifact {
  id          String @id @default(cuid())
  taskId      String
  workspaceId String

  kind    String // "spec" | "plan" | "design" … opaque, declared by writer
  title   String
  content String            @db.Text
  source  String // "superpowers" | "claude-code" | "manual"
  agent   TaskArtifactAgent @default(CLAUDE_CODE)
  order   Int               @default(0)

  summary String? @db.Text

  /// LUM-783: content-level injection scan of this row's untrusted text,
  /// written at write time ({ counts, wrapperEscapes, total, scannedAt } —
  /// see shared/src/untrusted-content.ts). Null = clean or not yet scanned.
  /// Recorded on the SOURCE, never as a boundary crossing on the agent.
  contentSignals Json?

  createdById String? // WorkspaceMember.id; nullable, intentionally no FK relation
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([taskId, order])
  @@index([workspaceId])
  @@map("task_artifacts")
}

// ─── PR Comment Mirror ───────────────────────────────────────────────────────

enum PrCommentSource {
  ISSUE
  REVIEW
  REVIEW_LINE
}

enum DiffSide {
  LEFT
  RIGHT
}

enum OutboundActorKind {
  USER_OAUTH
  BOT_APP
}

enum SyncDirection {
  OUTBOUND
  INBOUND
}

enum SyncJobStatus {
  PENDING
  DEAD_LETTER
}

model PrCommentMirror {
  id            String @id @default(cuid())
  commentId     String @unique
  pullRequestId String

  externalSource    PrCommentSource
  externalId        String
  externalNodeId    String?
  externalUrl       String
  externalUpdatedAt DateTime
  lastSyncedAt      DateTime
  deletedAt         DateTime?

  filePath            String?
  lineStart           Int?
  lineEnd             Int?
  diffSide            DiffSide?
  inReplyToExternalId String?

  outboundActor       OutboundActorKind
  outboundActorUserId String?

  bodyHash String?

  /// LUM-1003: GitHub's `author_association` for the comment's author, captured
  /// from the webhook at mirror time (OWNER, MEMBER, COLLABORATOR, CONTRIBUTOR,
  /// FIRST_TIME_CONTRIBUTOR, FIRST_TIMER, MANNEQUIN, NONE). Null on rows mirrored
  /// before LUM-1003 and on outbound rows; readers treat null as unverified.
  authorAssociation String?

  comment     Comment     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@unique([externalSource, externalId])
  @@index([pullRequestId])
  @@index([pullRequestId, bodyHash, lastSyncedAt])
  @@map("pr_comment_mirrors")
}

model PrCommentSyncJob {
  id              String        @id @default(cuid())
  direction       SyncDirection
  payload         Json
  commentId       String?
  externalId      String?
  attempts        Int           @default(0)
  lastError       String?
  status          SyncJobStatus @default(PENDING)
  scheduledFor    DateTime      @default(now())
  workspaceId     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  /// LUM-913: when the job entered DEAD_LETTER. NULL on rows dead-lettered
