# HTTPS front door for the `caddy` compose profile (LUM-1325).
#
# One origin for everything the browser talks to: the realtime socket
# (pusher-js connects to /app/<key>) goes to Soketi, the rest to the app.
# LUMO_DOMAIN comes from .env (scripts/self-host/init.sh --url sets it).
{$LUMO_DOMAIN} {
	handle /app/* {
		reverse_proxy soketi:6001
	}
	handle {
		reverse_proxy app:3000
	}
}
