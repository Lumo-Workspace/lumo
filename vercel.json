{
  "buildCommand": "bash scripts/deploy/vercel-build.sh",
  "crons": [
    {
      "path": "/api/cron/backfill-lineage-outcomes",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/summaries/generate",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/roll-sprints",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/prune-document-revisions",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/prune-hook-event-payloads",
      "schedule": "45 3 * * *"
    },
    {
      "path": "/api/cron/prune-security-sarif",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/sweep-security-scans",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/rejudge-crossings",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/cron/recheck-github-access",
      "schedule": "15 4 * * *"
    },
    {
      "path": "/api/cron/execute-workspace-deletions",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/cron/purge-trash",
      "schedule": "10 4 * * *"
    }
  ]
}
