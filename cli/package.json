{
  "name": "@lumoai/cli",
  "version": "1.101.1",
  "description": "Lumo CLI — manage tasks and sessions from the terminal",
  "license": "MIT",
  "author": "cli@uselumo.ai",
  "homepage": "https://github.com/Lumo-Workspace/lumo/tree/main/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lumo-Workspace/lumo.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/Lumo-Workspace/lumo/issues"
  },
  "keywords": [
    "lumo",
    "cli",
    "task-management",
    "project-management",
    "claude-code",
    "codex"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "lumo": "dist/cli/src/index.js"
  },
  "files": [
    "dist",
    "skills",
    "plugin.json",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli/src/index.js && node ./scripts/bundle-assets.js",
    "dev": "tsc --watch",
    "clean": "rm -rf dist assets skills plugin.json",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "markdown-it": "^14.1.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25",
    "typescript": "^5"
  }
}
