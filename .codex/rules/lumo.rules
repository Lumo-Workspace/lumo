# Managed by `lumo init` (LUM-1054). Remove with `lumo uninstall`.
# Lets the server-only `lumo` commands (they only call the Lumo API, read no
# local file to upload and write none) run outside Codex's no-network sandbox
# without prompting. Every other command, including `lumo init`, `lumo update`,
# `lumo uninstall`, `lumo auth`, `lumo worktree`, `lumo memory sync/push`,
# `lumo session attach`, `lumo task update` and the commands that take a
# `--file` (`lumo doc create/update/patch …`), stays sandboxed, so Codex asks.
prefix_rule(
    pattern = ["lumo", ["cost", "next", "priority", "report"]],
    decision = "allow",
    justification = "Server-only Lumo command: needs network to reach the Lumo API, reads no local file to upload, writes none",
    match = ["lumo cost", "lumo next", "lumo priority", "lumo report"],
    not_match = ["lumo auth login", "lumo auth logout", "lumo crossing disposition", "lumo crossing explain", "lumo doctor", "lumo hook", "lumo init", "lumo setup", "lumo skill status", "lumo skill update", "lumo uninstall", "lumo uninstall --confirm", "lumo update", "lumo usage resync", "lumo whoami", "lumo worktree", "lumo worktree add LUM-1", "lumox status"],
)
prefix_rule(
    pattern = ["lumo", "audit", "list"],
    decision = "allow",
    justification = "Server-only Lumo command: needs network to reach the Lumo API, reads no local file to upload, writes none",
    match = ["lumo audit list"],
)
prefix_rule(
    pattern = ["lumo", "doc", ["bind", "delete", "import-gdoc", "list", "move", "rebuild-source", "share", "share-list", "show", "sync", "unbind", "unshare"]],
    decision = "allow",
    justification = "Server-only Lumo command: needs network to reach the Lumo API, reads no local file to upload, writes none",
    match = ["lumo doc bind", "lumo doc delete", "lumo doc import-gdoc", "lumo doc list", "lumo doc move", "lumo doc rebuild-source", "lumo doc share", "lumo doc share-list", "lumo doc show", "lumo doc sync", "lumo doc unbind", "lumo doc unshare"],
    not_match = ["lumo doc append", "lumo doc create", "lumo doc diff", "lumo doc patch", "lumo doc update"],
)
prefix_rule(
    pattern = ["lumo", "member", "list"],
    decision = "allow",
    justification = "Server-only Lumo command: needs network to reach the Lumo API, reads no local file to upload, writes none",
    match = ["lumo member list"],
)
prefix_rule(
    pattern = ["lumo", "memory", ["fold", "promote", "rm", "show"]],
    decision = "allow",
    justification = "Server-only Lumo command: needs network to reach the Lumo API, reads no local file to upload, writes none",
    match = ["lumo memory fold", "lumo memory promote", "lumo memory rm", "lumo memory show"],
    not_match = ["lumo memory push", "lumo memory sync"],
)
prefix_rule(
    pattern = ["lumo", "milestone", ["add", "archive", "changelog", "create", "delete", "list", "move", "remove", "reorder", "show", "summary", "triage", "unarchive", "update"]],
    decision = "allow",
    justification = "Server-only Lumo command: needs network to reach the Lumo API, reads no local file to upload, writes none",
    match = ["lumo milestone add", "lumo milestone archive", "lumo milestone changelog", "lumo milestone create", "lumo milestone delete", "lumo milestone list", "lumo milestone move", "lumo milestone remove", "lumo milestone reorder", "lumo milestone show", "lumo milestone summary", "lumo milestone triage", "lumo milestone unarchive", "lumo milestone update"],
)
prefix_rule(
